---
// Absensi — laporan admin. Satu halaman, tiga mode periode (harian / bulanan / tahunan),
// dengan filter nama, email, atau jabatan. Semua keadaan ada di URL, jadi laporan bisa
// di-bookmark, di-refresh, dan dibagikan. Editor peta pindah ke /dashboard/absensi/lokasi:
// memisahkan rute berarti filter tidak pernah memaksa MapLibre mount ulang.
import {
  ArrowDownTray,
  CalendarDays,
  ChartBar,
  CheckCircle,
  Clock,
  InformationCircle,
  MagnifyingGlass,
  MapPin,
  UserMinus,
  Users,
} from "../../lib/icons";
import Button from "../../components/ui/Button.astro";
import StatCard from "../../components/ui/StatCard.astro";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { requireAdmin } from "../../lib/auth";
import {
  listAttendanceMissing,
  listAttendanceMissingRange,
  listAttendanceMonthCells,
  listAttendanceRecap,
  listAttendanceSummary,
} from "../../lib/db";
import { formatDistance, parseReportPeriod, shiftReportPeriod } from "../../lib/attendance";
import { formatDate, formatDateTime } from "../../lib/format";
import { daysBetween, todayIso } from "../../lib/tasks";

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const today = todayIso();
const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim().slice(0, 100);
const period = parseReportPeriod(
  { mode: params.get("mode"), tanggal: params.get("tanggal"), bulan: params.get("bulan"), tahun: params.get("tahun") },
  today,
);

// Every link keeps the other parameters; losing `q` on a period change is the bug this
// helper exists to prevent. Only the key that belongs to the active mode is ever written.
const periodKeyName = period.mode === "harian" ? "tanggal" : period.mode === "bulanan" ? "bulan" : "tahun";
// "Back to now" for the active mode, so the button is a real destination, not a guess.
const currentKey = period.mode === "harian" ? today : period.mode === "bulanan" ? today.slice(0, 7) : today.slice(0, 4);

const href = (overrides: Record<string, string | null> = {}) => {
  const next = new URLSearchParams({ mode: period.mode, [periodKeyName]: period.key });
  if (q) next.set("q", q);
  for (const [key, value] of Object.entries(overrides)) {
    if (value === null) next.delete(key);
    else next.set(key, value);
  }
  return `/dashboard/absensi?${next}`;
};

const modeHref = (mode: string) => {
  const next = new URLSearchParams({ mode });
  if (mode === "harian") next.set("tanggal", today);
  if (mode === "bulanan") next.set("bulan", today.slice(0, 7));
  if (mode === "tahunan") next.set("tahun", today.slice(0, 4));
  if (q) next.set("q", q);
  return `/dashboard/absensi?${next}`;
};

const previous = shiftReportPeriod(period, -1);
const next = shiftReportPeriod(period, 1);
const isFuture = today < period.start;

// "Hari berjalan": how much of the period has actually happened. Shown as context, never
// used as a percentage base — the app has no working-day calendar or leave records.
const elapsed =
  today < period.start ? 0 : daysBetween(period.start, today < period.end ? today : period.end) + 1;
const totalDays = daysBetween(period.start, period.end) + 1;

const recap = period.mode === "harian" ? listAttendanceRecap(period.start, q) : [];
const missing =
  period.mode === "harian" ? listAttendanceMissing(period.start, q) : listAttendanceMissingRange(period.start, period.end, q);
const summary = period.mode === "harian" ? [] : listAttendanceSummary(period.start, period.end, q);

// Pivot the yearly cells into user_id → month → days. Flat query, rendered as a grid.
const monthCells = period.mode === "tahunan" ? listAttendanceMonthCells(period.start, period.end, q) : [];
const months = new Map<number, Map<number, number>>();
for (const cell of monthCells) {
  const row = months.get(cell.user_id) ?? new Map<number, number>();
  row.set(cell.month, cell.days_in);
  months.set(cell.user_id, row);
}

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"];
const monthTotals = MONTHS.map((_, i) => monthCells.filter((cell) => cell.month === i + 1).reduce((sum, cell) => sum + cell.days_in, 0));
const presentCount = summary.filter((row) => row.days_in > 0).length;
const label = (jabatan: string, role: number) => jabatan || `Level ${role}`;
---

<DashboardLayout title="Absensi" user={session.user}>
  <div data-report-page>
  <div class="flex flex-wrap items-end justify-between gap-3" data-reveal="up">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">Absensi</h1>
      <p class="mt-1 text-sm text-slate-500">
        Rekap kehadiran per periode, beserta daftar pegawai yang belum absen.
      </p>
    </div>
    <Button href="/dashboard/absensi/lokasi" variant="outline">
      <MapPin class="size-4" />
      Atur titik lokasi
    </Button>
  </div>

  <!-- Mode periode -->
  <div class="mt-6 flex flex-wrap items-center gap-1 rounded-xl border border-slate-200 bg-white p-1" role="group" aria-label="Jenis rekap">
    {
      (["harian", "bulanan", "tahunan"] as const).map((mode) => (
        <a
          href={modeHref(mode)}
          aria-current={period.mode === mode ? "page" : undefined}
          class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 aria-[current=page]:bg-brand-50 aria-[current=page]:text-brand-700"
        >
          {mode === "harian" ? "Harian" : mode === "bulanan" ? "Bulanan" : "Tahunan"}
        </a>
      ))
    }
  </div>

  <!-- Filter + periode -->
  <form method="GET" role="search" class="mt-3 flex flex-wrap items-end gap-2" data-reveal="up">
    <input type="hidden" name="mode" value={period.mode} />
    <div class="relative min-w-0 flex-1 basis-full sm:basis-auto sm:max-w-xs">
      <MagnifyingGlass class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-slate-400" />
      <label for="field-q" class="sr-only">Cari pegawai</label>
      <input
        id="field-q"
        name="q"
        type="search"
        value={q}
        autocomplete="off"
        placeholder="Cari nama, email, atau jabatan…"
        class="h-10 w-full rounded-lg border border-slate-300 bg-white pr-3 pl-9 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
      />
    </div>
    {
      period.mode === "harian" ? (
        <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
          Tanggal
          <input
            type="date"
            name="tanggal"
            value={period.key}
            class="h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
          />
        </label>
      ) : period.mode === "bulanan" ? (
        <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
          Bulan
          <input
            type="month"
            name="bulan"
            value={period.key}
            class="h-10 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
          />
        </label>
      ) : (
        <label class="flex flex-col gap-1 text-xs font-medium text-slate-600">
          Tahun
          <input
            type="number"
            name="tahun"
            min="2000"
            max="2100"
            value={period.key}
            class="h-10 w-28 rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
          />
        </label>
      )
    }
    <Button variant="outline" size="md" type="submit">Terapkan</Button>
    {q && <a href={href({ q: null })} class="pb-2.5 text-sm font-medium text-slate-500 hover:text-slate-900">Hapus filter</a>}
  </form>

  <!-- Navigasi periode -->
  <div class="mt-4 flex flex-wrap items-center gap-2" data-reveal="up">
    <a href={href({ [periodKeyName]: previous.key })} class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
      {period.mode === "harian" ? "Hari sebelumnya" : period.mode === "bulanan" ? "Bulan lalu" : "Tahun lalu"}
    </a>
    <a href={href({ [periodKeyName]: currentKey })} class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
      {period.mode === "harian" ? "Hari ini" : period.mode === "bulanan" ? "Bulan ini" : "Tahun ini"}
    </a>
    <a href={href({ [periodKeyName]: next.key })} class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
      {period.mode === "harian" ? "Hari berikutnya" : period.mode === "bulanan" ? "Bulan depan" : "Tahun depan"}
    </a>
    <p class="ml-auto flex items-center gap-1.5 text-sm text-slate-500">
      <CalendarDays class="size-4 shrink-0 text-slate-400" />
      <span class="font-medium text-slate-900">{period.label}</span>
    </p>
    {/* The export href is the same query string, only a different path: period and filter
        follow automatically. A plain link, so it survives no-JS and the router. */}
    <a
      href={`/dashboard/absensi/export?${new URLSearchParams({ mode: period.mode, [periodKeyName]: period.key, ...(q ? { q } : {}) })}`}
      download
      data-export-link
      class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
    >
      <ArrowDownTray class="size-4" />
      Export CSV
    </a>
  </div>

  {
    isFuture && (
      <p class="mt-3 flex items-start gap-1.5 rounded-lg bg-slate-100 px-3 py-2 text-xs text-slate-600">
        <InformationCircle class="mt-0.5 size-3.5 shrink-0" />
        Periode ini belum berjalan. Daftar kosong di bawah berarti belum ada yang absen, bukan tidak ada pegawai.
      </p>
    )
  }

  <!-- Ringkasan -->
  <div class="mt-4 grid gap-4 sm:grid-cols-3" data-reveal="up">
    {
      period.mode === "harian" ? (
        <>
          <StatCard label="Tanggal" value={formatDate(period.start)} hint={q ? `Filter: “${q}”` : "Semua pegawai"}>
            <CalendarDays slot="icon" class="size-5" />
          </StatCard>
          <StatCard label="Sudah absen masuk" value={recap.length} hint="Orang" href={undefined}>
            <CheckCircle slot="icon" class="size-5" />
          </StatCard>
          <StatCard label="Belum absen" value={missing.length} hint="Orang">
            <UserMinus slot="icon" class="size-5" />
          </StatCard>
        </>
      ) : (
        <>
          <StatCard
            label="Hari berjalan"
            value={`${elapsed} / ${totalDays}`}
            hint={period.mode === "bulanan" ? "Hari dalam bulan ini" : "Hari dalam tahun ini"}
          >
            <CalendarDays slot="icon" class="size-5" />
          </StatCard>
          <StatCard label="Pegawai hadir" value={presentCount} hint={`dari ${summary.length} pegawai`}>
            <Users slot="icon" class="size-5" />
          </StatCard>
          <StatCard label="Tidak pernah absen" value={missing.length} hint="Sepanjang periode">
            <UserMinus slot="icon" class="size-5" />
          </StatCard>
        </>
      )
    }
  </div>

  {
    period.mode === "harian" ? (
      <div class="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
          <header class="flex flex-wrap items-center gap-2 border-b border-slate-200 px-5 py-4">
            <CheckCircle class="size-4 text-slate-400" />
            <h2 class="text-sm font-semibold text-slate-900">Rekap kehadiran</h2>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{recap.length}</span>
          </header>

          {recap.length === 0 ? (
            <div class="flex flex-col items-center gap-2 px-6 py-12 text-center">
              <Clock class="size-8 text-slate-300" />
              <p class="text-sm font-medium text-slate-900">{q ? "Tidak ada yang cocok" : "Belum ada absensi"}</p>
              <p class="max-w-sm text-sm text-slate-500">
                {q
                  ? `Tidak ada pegawai dengan nama, email, atau jabatan yang cocok dengan “${q}” pada tanggal ini.`
                  : "Belum ada pegawai yang absen pada tanggal ini."}
              </p>
            </div>
          ) : (
            <ul class="divide-y divide-slate-100">
              {recap.map((row) => (
                <li class="px-5 py-4" data-report-row data-reveal="fade">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="min-w-0 flex-1 text-sm font-medium text-slate-900">{row.name}</span>
                    <span class="text-xs text-slate-500">{label(row.jabatan, row.role)}</span>
                    {!row.pulang_at && (
                      <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">Belum pulang</span>
                    )}
                  </div>
                  <div class="mt-1.5 grid gap-x-4 gap-y-1 text-xs text-slate-500 sm:grid-cols-2">
                    <p>
                      <span class="font-medium text-slate-700">Masuk</span>{" "}
                      {row.masuk_at ? formatDateTime(row.masuk_at) : "–"}
                      {row.masuk_at && (
                        <>
                          {" · "}
                          {row.masuk_location ?? "lokasi tidak tercatat"} · {formatDistance(row.masuk_distance ?? 0)}
                          {row.masuk_latitude !== null && row.masuk_longitude !== null && (
                            <>
                              {" · "}
                              <a
                                href={`https://www.openstreetmap.org/?mlat=${row.masuk_latitude}&mlon=${row.masuk_longitude}#map=18/${row.masuk_latitude}/${row.masuk_longitude}`}
                                target="_blank"
                                rel="noreferrer noopener"
                                class="text-brand-600 hover:text-brand-700"
                              >
                                peta
                              </a>
                            </>
                          )}
                        </>
                      )}
                    </p>
                    <p>
                      <span class="font-medium text-slate-700">Pulang</span>{" "}
                      {row.pulang_at ? formatDateTime(row.pulang_at) : "–"}
                      {row.pulang_at && (
                        <>
                          {" · "}
                          {row.pulang_location ?? "lokasi tidak tercatat"} · {formatDistance(row.pulang_distance ?? 0)}
                        </>
                      )}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
          <header class="flex items-center gap-2 border-b border-slate-200 px-5 py-4">
            <UserMinus class="size-4 text-slate-400" />
            <h2 class="text-sm font-semibold text-slate-900">Belum absen</h2>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{missing.length}</span>
          </header>
          {missing.length === 0 ? (
            <div class="flex flex-col items-center gap-2 px-6 py-10 text-center">
              <CheckCircle class="size-8 text-emerald-300" />
              <p class="text-sm font-medium text-slate-900">Semua sudah absen</p>
            </div>
          ) : (
            <ul class="divide-y divide-slate-100">
              {missing.map((row) => (
                <li class="px-5 py-3" data-reveal="fade">
                  <p class="text-sm text-slate-900">{row.name}</p>
                  <p class="text-xs text-slate-500">{label(row.jabatan, row.role)}</p>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    ) : (
      <div class="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
          <header class="flex flex-wrap items-center gap-2 border-b border-slate-200 px-5 py-4">
            <ChartBar class="size-4 text-slate-400" />
            <h2 class="text-sm font-semibold text-slate-900">
              {period.mode === "bulanan" ? "Rekap per pegawai" : "Kehadiran per bulan"}
            </h2>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{summary.length}</span>
          </header>

          {summary.length === 0 ? (
            <div class="flex flex-col items-center gap-2 px-6 py-12 text-center">
              <Users class="size-8 text-slate-300" />
              <p class="text-sm font-medium text-slate-900">Tidak ada pegawai</p>
              <p class="max-w-sm text-sm text-slate-500">
                {q ? `Tidak ada nama, email, atau jabatan yang cocok dengan “${q}”.` : "Belum ada akun pegawai."}
              </p>
            </div>
          ) : (
            <div class="overflow-x-auto">
              {period.mode === "bulanan" ? (
                <table class="w-full min-w-[42rem] text-sm">
                  <thead>
                    <tr class="border-b border-slate-200 bg-slate-50/60 text-left text-xs font-medium tracking-wide text-slate-500 uppercase">
                      <th scope="col" class="px-5 py-2.5">Pegawai</th>
                      <th scope="col" class="px-3 py-2.5 text-right">Hadir</th>
                      <th scope="col" class="px-3 py-2.5 text-right">Pulang lengkap</th>
                      <th scope="col" class="px-3 py-2.5 text-right">Tanpa pulang</th>
                      <th scope="col" class="px-5 py-2.5">Terakhir hadir</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {summary.map((row) => {
                      const tanpaPulang = row.days_in - row.days_out;
                      return (
                        <tr data-summary-row class="transition-colors hover:bg-slate-50/80">
                          <td class="px-5 py-3">
                            <p class="font-medium text-slate-900">{row.name}</p>
                            <p class="text-xs text-slate-500">{label(row.jabatan, row.role)}</p>
                          </td>
                          <td class="px-3 py-3 text-right font-medium tabular-nums text-slate-900">{row.days_in}</td>
                          <td class="px-3 py-3 text-right tabular-nums text-slate-600">{row.days_out}</td>
                          <td class="px-3 py-3 text-right tabular-nums">
                            {tanpaPulang > 0 ? (
                              <span class="rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">
                                {tanpaPulang}
                              </span>
                            ) : (
                              <span class="text-slate-400">–</span>
                            )}
                          </td>
                          <td class="px-5 py-3 text-xs text-slate-600">
                            {row.last_day ? (
                              <a
                                href={`/dashboard/absensi?${new URLSearchParams({ mode: "harian", tanggal: row.last_day, ...(q ? { q } : {}) })}`}
                                class="text-brand-600 hover:text-brand-700"
                              >
                                {formatDate(row.last_day)}
                              </a>
                            ) : (
                              <span class="text-slate-400">Belum pernah</span>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              ) : (
                <table data-year-grid class="w-full min-w-[46rem] text-sm">
                  <thead>
                    <tr class="border-b border-slate-200 bg-slate-50/60 text-xs font-medium text-slate-500">
                      <th scope="col" class="sticky left-0 bg-slate-50/60 px-5 py-2.5 text-left font-medium tracking-wide uppercase">
                        Pegawai
                      </th>
                      {MONTHS.map((month) => (
                        <th scope="col" class="px-1.5 py-2.5 text-center font-medium tabular-nums">{month}</th>
                      ))}
                      <th scope="col" class="px-3 py-2.5 text-right font-medium tracking-wide uppercase">Total</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {summary.map((row) => (
                      <tr class="transition-colors hover:bg-slate-50/80">
                        <td class="sticky left-0 bg-white px-5 py-2.5">
                          <p class="font-medium text-slate-900">{row.name}</p>
                          <p class="text-xs text-slate-500">{label(row.jabatan, row.role)}</p>
                        </td>
                        {MONTHS.map((_, i) => {
                          const days = months.get(row.user_id)?.get(i + 1) ?? 0;
                          return (
                            <td class="px-1.5 py-2.5 text-center tabular-nums">
                              {days > 0 ? (
                                <a
                                  href={`/dashboard/absensi?${new URLSearchParams({ mode: "bulanan", bulan: `${period.key}-${String(i + 1).padStart(2, "0")}`, ...(q ? { q } : {}) })}`}
                                  class="inline-block min-w-6 rounded px-1.5 py-0.5 font-medium text-brand-700 hover:bg-brand-50"
                                  title={`${row.name} · ${MONTHS[i]} ${period.key}: ${days} hari`}
                                >
                                  {days}
                                </a>
                              ) : (
                                <span class="text-slate-300">·</span>
                              )}
                            </td>
                          );
                        })}
                        <td class="px-3 py-2.5 text-right font-semibold tabular-nums text-slate-900">{row.days_in}</td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot>
                    <tr class="border-t border-slate-200 bg-slate-50/60 text-xs font-medium text-slate-600">
                      <td class="sticky left-0 bg-slate-50/60 px-5 py-2.5">Total hari hadir</td>
                      {monthTotals.map((total) => (
                        <td class="px-1.5 py-2.5 text-center tabular-nums">{total > 0 ? total : "·"}</td>
                      ))}
                      <td class="px-3 py-2.5 text-right tabular-nums">{monthTotals.reduce((sum, n) => sum + n, 0)}</td>
                    </tr>
                  </tfoot>
                </table>
              )}
            </div>
          )}
        </section>

        <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
          <header class="flex items-center gap-2 border-b border-slate-200 px-5 py-4">
            <UserMinus class="size-4 text-slate-400" />
            <h2 class="text-sm font-semibold text-slate-900">Tidak pernah absen</h2>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">{missing.length}</span>
          </header>
          {missing.length === 0 ? (
            <div class="flex flex-col items-center gap-2 px-6 py-10 text-center">
              <CheckCircle class="size-8 text-emerald-300" />
              <p class="text-sm font-medium text-slate-900">Semua pernah absen</p>
              <p class="text-xs text-slate-500">Setidaknya sekali dalam periode ini.</p>
            </div>
          ) : (
            <ul class="divide-y divide-slate-100">
              {missing.map((row) => (
                <li class="px-5 py-3" data-reveal="fade">
                  <p class="text-sm text-slate-900">{row.name}</p>
                  <p class="text-xs text-slate-500">{label(row.jabatan, row.role)}</p>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    )
  }

  <p class="mt-3 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
    <InformationCircle class="size-3.5 shrink-0 text-slate-400" />
    Angka di halaman ini adalah jumlah hari yang tercatat, bukan persentase: sistem belum punya kalender hari
    kerja, cuti, atau izin, jadi penyebut persentase akan mengarang.
  </p>
  </div>
</DashboardLayout>
