---
// Kategori detail — one work unit and its "Jenis Aktivitas Unit Kerja" rows.
//
// Input flow: "+ Tambah aktivitas" opens a modal form. Saving goes through an Astro
// Action (src/actions), so the page is re-rendered without a full reload; "Simpan &
// tambah lagi" reopens the modal on a clean, empty form for the next entry.
// Deleting is its own modal ("Hapus aktivitas") where rows are ticked and removed in one
// go — no per-row button in the table.
import { ArrowLeft, Check, ChevronRight, ClipboardDocumentList, Plus, Trash, XMark } from "../../../lib/icons";
import Button from "../../../components/ui/Button.astro";
import ChoiceGroup from "../../../components/ui/ChoiceGroup.astro";
import Input from "../../../components/ui/Input.astro";
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { CLASSIFICATIONS, PERIODES } from "../../../lib/activities";
import { requireAdmin } from "../../../lib/auth";
import { findCategory } from "../../../lib/categories";
import { listActivities } from "../../../lib/db";
import { formatDate, formatRange } from "../../../lib/format";

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const category = findCategory(Astro.params.id);
if (!category) return new Response("Kategori tidak ditemukan", { status: 404 });
const { id: categoryId, icon: Icon, label } = category;

// The form starts empty; the month and year of the day field come from today (server).
const flagValues = () => CLASSIFICATIONS.map(({ value }) => value);

// What the modal shows: a fresh form with the unit's defaults, or the row being
// edited (?edit=<id>).
let draft = {
  name: "",
  start_date: "",
  end_date: "",
  classifications: ["utama"] as string[],
  periode: "Harian",
  frequency: "1",
  minutes: "60",
  sdm: "1",
};
let dialogOpen = Astro.url.searchParams.has("add");
let editId: number | undefined;

const activities = listActivities(categoryId);
const edited = activities.find((activity) => activity.id === Number(Astro.url.searchParams.get("edit") ?? 0));

if (edited) {
  editId = edited.id;
  dialogOpen = true;
  draft = {
    name: edited.name,
    start_date: edited.start_date,
    end_date: edited.end_date,
    classifications: flagValues().filter((flag) => edited[flag]),
    periode: edited.periode,
    frequency: String(edited.frequency),
    minutes: String(edited.minutes),
    sdm: String(edited.sdm),
  };
}

// Shown before the modal's JS takes over: the same formula the server applies on save.
const volume = (frequency: string, minutes: string, sdm: string) => {
  const total = Number(frequency) * Number(minutes) * Number(sdm);
  return frequency && minutes && sdm && Number.isFinite(total) ? total.toLocaleString("id-ID") : "–";
};
---

<DashboardLayout title={label} user={session.user}>
  <a
    href="/dashboard/categories"
    data-reveal="left"
    class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-900"
  >
    <ArrowLeft class="size-4" />
    Semua kategori
  </a>

  <div class="mt-4 flex items-center gap-3" data-reveal="up">
    <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600">
      <Icon class="size-5" />
    </span>
    <div>
      <h1 class="text-xl font-semibold tracking-wide text-slate-900 uppercase">{label}</h1>
      <p class="mt-0.5 text-sm text-slate-500">Unit kerja di lingkungan sistem informasi tenaga kerja.</p>
    </div>
  </div>

  <div class="mt-8 flex flex-wrap items-center justify-between gap-3" data-reveal="up">
    <h2 class="text-sm font-semibold text-slate-900">Jenis Aktivitas Unit Kerja</h2>
    <div class="flex flex-wrap items-center gap-2">
      <Button size="sm" variant="danger" type="button" data-delete-open disabled={activities.length === 0}>
        <Trash class="size-4" />Hapus
      </Button>
      <Button size="sm" variant="outline" type="button" data-manage-open>
        <ClipboardDocumentList class="size-4" />Edit
      </Button>
      <Button size="sm" type="button" data-activity-open><Plus class="size-4" />Tambah</Button>
    </div>
  </div>

  <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white" data-reveal="up">
    <table class="w-full min-w-[56rem] text-left text-xs">
      <thead class="border-b border-slate-200 text-[11px] tracking-wide text-slate-500 uppercase">
        <tr>
          <th class="px-4 py-2.5 font-medium">Jenis Aktivitas</th>
          <th class="px-4 py-2.5 font-medium">Mulai</th>
          <th class="px-4 py-2.5 font-medium">Tenggat</th>
          <th class="px-3 py-2.5 text-center font-medium">Utama</th>
          <th class="px-3 py-2.5 text-center font-medium">Periodik</th>
          <th class="px-3 py-2.5 text-center font-medium">Bukan Tupoksi</th>
          <th class="px-4 py-2.5 font-medium">Periode</th>
          <th class="px-4 py-2.5 text-right font-medium">Frekuensi/ Tahun</th>
          <th class="px-4 py-2.5 text-right font-medium">Durasi (Menit)</th>
          <th class="px-4 py-2.5 text-right font-medium">Jumlah SDM</th>
          <th class="px-4 py-2.5 text-right font-medium">Volume Kerja</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {
          activities.length === 0 ? (
            <tr>
              <td colspan="10" class="px-4 py-8 text-center text-slate-500">
                Belum ada jenis aktivitas untuk unit ini.
              </td>
            </tr>
          ) : (
            activities.map((activity) => (
              <tr class="align-top" data-reveal="fade">
                <td class="px-4 py-2.5 font-medium text-slate-900">{activity.name}</td>
                <td class="px-4 py-2.5 whitespace-nowrap text-slate-600">{formatDate(activity.start_date)}</td>
                <td class="px-4 py-2.5 whitespace-nowrap text-slate-600">{formatDate(activity.end_date)}</td>
                {CLASSIFICATIONS.map(({ value }) => (
                  <td class="px-3 py-2.5 text-center">
                    {activity[value] ? (
                      <Check class="mx-auto size-3.5 text-brand-600" />
                    ) : (
                      <span class="text-slate-300">–</span>
                    )}
                  </td>
                ))}
                <td class="px-4 py-2.5 text-slate-600">{activity.periode}</td>
                <td class="px-4 py-2.5 text-right text-slate-600 tabular-nums">{activity.frequency}</td>
                <td class="px-4 py-2.5 text-right text-slate-600 tabular-nums">{activity.minutes}</td>
                <td class="px-4 py-2.5 text-right text-slate-600 tabular-nums">{activity.sdm}</td>
                <td class="px-4 py-2.5 text-right text-slate-600 tabular-nums" data-count={activity.volume}>
                  {activity.volume.toLocaleString("id-ID")}
                </td>
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>

  <dialog
    id="activity-dialog"
    data-open={dialogOpen ? "" : undefined}
    class="app-dialog w-[calc(100vw-2rem)] max-w-2xl"
    aria-labelledby="activity-dialog-title"
  >
    {/* Wadah field — submit-nya ditangani Astro Action. */}
    <form
      method="POST"
      class="p-5 sm:p-6"
      data-activity-form
      data-category-id={categoryId}
      data-edit-id={editId}
    >
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="activity-dialog-title" class="text-base font-semibold text-slate-900">
            {editId ? "Ubah aktivitas" : "Tambah aktivitas"}
          </h2>
          <p class="mt-0.5 text-xs text-slate-500">Unit {label}</p>
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label="Tutup"
          class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
        >
          <XMark class="size-4" />
        </button>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <Input
            label="Jenis aktivitas"
            name="name"
            value={draft.name}
            placeholder="mis. Rekonsiliasi laporan bulanan"
            required
          />
        </div>
        <Input label="Mulai" name="start_date" type="date" value={draft.start_date} />
        <Input label="Tenggat" name="end_date" type="date" value={draft.end_date} />
        <Input label="Durasi (menit)" name="minutes" type="number" value={draft.minutes} required />
        <div class="sm:col-span-2">
          <ChoiceGroup
            label="Klasifikasi"
            multiple
            options={CLASSIFICATIONS}
            selected={draft.classifications}
            hint="Bisa pilih lebih dari satu."
          />
        </div>
        <div class="sm:col-span-2">
          <ChoiceGroup
            label="Periode"
            name="periode"
            options={PERIODES.map((periode) => ({ value: periode, label: periode }))}
            value={draft.periode}
          />
        </div>
        <div class="grid gap-4 sm:col-span-2 sm:grid-cols-3">
          <Input label="Frekuensi/ Tahun" name="frequency" type="number" value={draft.frequency} required />
          <Input label="Jumlah SDM" name="sdm" type="number" value={draft.sdm} required />
          <div>
            <span class="mb-1.5 block text-sm font-medium text-slate-700">Volume Kerja</span>
            <p
              data-volume
              class="flex h-11 w-full items-center rounded-lg border border-slate-200 bg-slate-50 px-3.5 text-sm text-slate-700 tabular-nums"
            >
              {volume(draft.frequency, draft.minutes, draft.sdm)}
            </p>
            <p class="mt-1.5 text-xs text-slate-500">frekuensi × durasi × SDM.</p>
          </div>
        </div>
      </div>

      <p data-activity-error hidden class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">
      </p>

      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <Button variant="outline" type="button" data-dialog-close>Batal</Button>
        {!editId && (
          <Button variant="outline" type="submit" name="next" value="again" data-save-again>
            Simpan &amp; Buat
          </Button>
        )}
        <Button type="submit">Simpan</Button>
      </div>
    </form>
  </dialog>

  <dialog
    id="delete-dialog"
    class="app-dialog w-[calc(100vw-2rem)] max-w-lg"
    aria-labelledby="delete-dialog-title"
  >
    {/* Wadah field — submit-nya ditangani Astro Action. */}
    <form method="POST" data-delete-form data-category-id={categoryId}>
      <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
        <div>
          <h2 id="delete-dialog-title" class="text-base font-semibold text-slate-900">Hapus aktivitas</h2>
          <p class="mt-0.5 text-xs text-slate-500">Unit {label} — pilih aktivitas yang ingin dihapus.</p>
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label="Tutup"
          class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
        >
          <XMark class="size-4" />
        </button>
      </div>

      <div class="mt-4 max-h-[50vh] overflow-y-auto border-y border-slate-200">
        {
          activities.length === 0 ? (
            <p class="px-5 py-6 text-sm text-slate-500 sm:px-6">Belum ada aktivitas untuk dihapus.</p>
          ) : (
            <ul class="divide-y divide-slate-100">
              {activities.map((activity) => (
                <li>
                  <label class="flex cursor-pointer items-start gap-3 px-5 py-3 transition-colors hover:bg-slate-50 has-[:focus-visible]:bg-slate-50 sm:px-6">
                    <input
                      type="checkbox"
                      name="ids"
                      value={activity.id}
                      class="mt-0.5 size-4 shrink-0 accent-brand-600"
                    />
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-medium text-slate-900">{activity.name}</span>
                      <span class="mt-0.5 block text-xs text-slate-500">
                        {formatRange(activity.start_date, activity.end_date)} · {activity.periode}
                      </span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="flex flex-col-reverse gap-2 p-5 sm:flex-row sm:justify-end sm:px-6">
        <Button variant="outline" type="button" data-dialog-close>Batal</Button>
        <Button variant="dangerSolid" type="submit" data-delete-submit disabled={activities.length === 0}>
          <Trash class="size-4" />Hapus terpilih<span data-delete-count></span>
        </Button>
      </div>
    </form>
  </dialog>

  <dialog id="manage-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-2xl" aria-labelledby="manage-dialog-title">
    <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
      <div>
        <h2 id="manage-dialog-title" class="text-base font-semibold text-slate-900">Aktivitas unit {label}</h2>
        <p class="mt-0.5 text-xs text-slate-500">Klik satu aktivitas untuk mengubahnya.</p>
      </div>
      <button
        type="button"
        data-dialog-close
        aria-label="Tutup"
        class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
      >
        <XMark class="size-4" />
      </button>
    </div>

    <div class="mt-4 max-h-[60vh] overflow-y-auto border-y border-slate-200">
      {
        activities.length === 0 ? (
          <p class="px-5 py-6 text-sm text-slate-500 sm:px-6">Belum ada aktivitas untuk unit ini.</p>
        ) : (
          <ul class="divide-y divide-slate-100">
            {activities.map((activity) => (
              <li>
                <a
                  href={`/dashboard/categories/${categoryId}?edit=${activity.id}`}
                  class="flex items-start gap-3 px-5 py-3 transition-colors hover:bg-slate-50 focus-visible:-outline-offset-2 focus-visible:outline-2 focus-visible:outline-brand-600 sm:px-6"
                >
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-slate-900">{activity.name}</span>
                    <span class="mt-0.5 block text-xs text-slate-500">
                      {formatRange(activity.start_date, activity.end_date)} · {activity.periode} ·{" "}
                      {activity.frequency}×/tahun ·{" "}
                      {activity.minutes} menit · {activity.sdm} SDM · volume {activity.volume.toLocaleString("id-ID")}
                    </span>
                  </span>
                  <ChevronRight class="mt-0.5 size-4 shrink-0 text-slate-400" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="flex justify-end p-5 sm:px-6">
      <Button variant="outline" type="button" data-dialog-close>Tutup</Button>
    </div>
  </dialog>
</DashboardLayout>

<script>
  import { actions } from "astro:actions";
  import type { Periode } from "../../../lib/activities";
  import { refreshPage, toast } from "../../../scripts/dashboard.ts";
  import { countTo } from "../../../scripts/motion.ts";

  // The router swaps the DOM but keeps this module, so the dialogs are wired again on
  // every astro:page-load.
  const init = () => {
    // The body is replaced on every navigation, so this marker is per page.
    if (document.body.dataset.categoryWired) return;
    document.body.dataset.categoryWired = "1";

    const wireDialog = (
      dialogId: string,
      openSelector: string,
      hooks: {
        onOpen?: (dialog: HTMLDialogElement) => void;
        onClose?: (dialog: HTMLDialogElement) => void;
      } = {},
    ) => {
      const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
      if (!dialog) return;

      const open = () => {
        dialog.showModal();
        hooks.onOpen?.(dialog);
      };

      document.querySelector(openSelector)?.addEventListener("click", open);
      dialog
        .querySelectorAll("[data-dialog-close]")
        .forEach((button) => button.addEventListener("click", () => dialog.close()));

      dialog.addEventListener("close", () => {
        // Drop ?add=1 on close, so a refresh doesn't reopen the add modal.
        if (location.search) history.replaceState(null, "", location.pathname);
        hooks.onClose?.(dialog);
      });

      if (dialog.dataset.open !== undefined) open();
    };

    wireDialog("activity-dialog", "[data-activity-open]", {
      onOpen: (dialog) => {
        const nameInput = dialog.querySelector<HTMLInputElement>("#field-name");
        nameInput?.focus();
        nameInput?.select();
        // The work volume counts from zero as the dialog opens, so the number
        // climbs along with the panel.
        const out = dialog.querySelector<HTMLElement>("[data-volume]");
        if (out) out.dataset.value = "0";
        syncVolume();
      },
    });

    /** Keeps "Hapus terpilih (n)" in step with what is ticked. */
    const syncDeleteButton = (dialog: HTMLDialogElement) => {
      const submit = dialog.querySelector<HTMLButtonElement>("[data-delete-submit]");
      const count = dialog.querySelector<HTMLElement>("[data-delete-count]");
      const selected = [...dialog.querySelectorAll<HTMLInputElement>('input[name="ids"]')].filter(
        (box) => box.checked,
      ).length;

      if (submit) submit.disabled = selected === 0;
      if (count) count.textContent = selected ? ` (${selected})` : "";
    };

    const deleteDialog = document.getElementById("delete-dialog") as HTMLDialogElement | null;
    deleteDialog
      ?.querySelectorAll<HTMLInputElement>('input[name="ids"]')
      .forEach((box) => box.addEventListener("change", () => syncDeleteButton(deleteDialog)));

    wireDialog("delete-dialog", "[data-delete-open]", {
      onOpen: syncDeleteButton,
      // Ticks must not survive closing the modal, or the next visit would delete them.
      onClose: (dialog) => {
        dialog.querySelector("form")?.reset();
        syncDeleteButton(dialog);
      },
    });

    wireDialog("manage-dialog", "[data-manage-open]");

    /** Mirrors the server rule: Volume Kerja = frekuensi/tahun × durasi × jumlah SDM. */
    function syncVolume() {
      const dialog = document.getElementById("activity-dialog") as HTMLDialogElement | null;
      const out = dialog?.querySelector<HTMLElement>("[data-volume]");
      if (!dialog || !out) return;

      const raw = (name: string) =>
        dialog.querySelector<HTMLInputElement>(`#field-${name}`)?.value.trim() ?? "";
      const [frequency, minutes, sdm] = ["frequency", "minutes", "sdm"].map(raw);
      const total = Number(frequency) * Number(minutes) * Number(sdm);
      if (!frequency || !minutes || !sdm || !Number.isFinite(total)) {
        out.textContent = "–";
        return;
      }
      // The number walks from the old value to the new one instead of jumping.
      countTo(out, total);
    }

    document.getElementById("activity-dialog")?.addEventListener("input", syncVolume);
    syncVolume();

    // Simpan aktivitas — Astro Action, jadi halamannya tidak dimuat ulang.
    const activityForm = document.querySelector<HTMLFormElement>("[data-activity-form]");
    const activityError = document.querySelector<HTMLElement>("[data-activity-error]");
    activityForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(activityForm);
      const editId = activityForm.dataset.editId ? Number(activityForm.dataset.editId) : undefined;
      const again = (event.submitter as HTMLButtonElement | null)?.value === "again";

      const { error } = await actions.saveActivity({
        categoryId: activityForm.dataset.categoryId ?? "",
        id: editId,
        name: String(data.get("name") ?? ""),
        start_date: String(data.get("start_date") ?? ""),
        end_date: String(data.get("end_date") ?? ""),
        utama: data.has("utama"),
        periodik: data.has("periodik"),
        bukan_tupoksi: data.has("bukan_tupoksi"),
        periode: String(data.get("periode") ?? "Harian") as Periode,
        frequency: Number(data.get("frequency")),
        minutes: Number(data.get("minutes")),
        sdm: Number(data.get("sdm")),
      });

      if (error) {
        if (activityError) {
          activityError.textContent = error.message ?? "Aktivitas gagal disimpan.";
          activityError.hidden = false;
        }
        return;
      }
      if (activityError) activityError.hidden = true;

      // "Simpan & Buat" membuka lagi modalnya dengan form yang kosong.
      await refreshPage(
        again ? `/dashboard/categories/${activityForm.dataset.categoryId}?add=1` : location.href,
      );
      toast(editId ? "Aktivitas diperbarui." : "Aktivitas tersimpan.");
    });

    // Hapus aktivitas yang dicentang.
    const deleteForm = document.querySelector<HTMLFormElement>("[data-delete-form]");
    deleteForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const ids = [...deleteForm.querySelectorAll<HTMLInputElement>('input[name="ids"]:checked')].map(
        (box) => Number(box.value),
      );
      if (ids.length === 0) return;

      const { error } = await actions.deleteActivities({
        categoryId: deleteForm.dataset.categoryId ?? "",
        ids,
      });
      if (error) {
        toast(error.message ?? "Aktivitas gagal dihapus.", "error");
        return;
      }
      await refreshPage();
      toast(ids.length === 1 ? "Aktivitas dihapus." : `${ids.length} aktivitas dihapus.`);
    });
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>
