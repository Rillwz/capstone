---
// User management — create (default password), edit and delete. Passwords are only ever
// stored as bcrypt hashes and are never selected for this page.
//
// Deleting is a two-step flow: confirm in a modal, then a 15 second undo window
// before the account is really removed. The window lives in the page, so leaving
// in the meantime cancels the deletion (by design).
//
// The list is the focus: creating an account and managing Posisi/Jabatan open in
// dialogs, and search + the level filter run in the browser over the rendered rows.
//
// Both flows run through Astro Actions (src/actions) — tidak ada form POST, tidak ada
// muat ulang halaman.
import {
  Briefcase,
  Check,
  Lock,
  MonitorSmartphone,
  Pencil,
  Plus,
  Search,
  Trash,
  TriangleAlert,
  Undo2,
  UserPlus,
  Users,
  X,
} from "@lucide/astro";
import PasswordReveal from "../../components/admin/PasswordReveal.astro";
import Button from "../../components/ui/Button.astro";
import Input from "../../components/ui/Input.astro";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { requireAdmin } from "../../lib/auth";
import { listPositions, listUsers } from "../../lib/db";
import { DEFAULT_USER_PASSWORD } from "../../lib/defaults";
import { describeDevice, formatDateTime, roleLabel } from "../../lib/format";

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const currentUser = session.user;

const users = listUsers();
const positions = listPositions();

const counts = {
  all: users.length,
  admin: users.filter((user) => user.role === 0).length,
  level1: users.filter((user) => user.role === 1).length,
  level2: users.filter((user) => user.role === 2).length,
};

// Gaya tombol ikon-saja (Ubah/Hapus) di baris tabel dan daftar jabatan.
const iconButton =
  "grid size-8 shrink-0 place-items-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 disabled:pointer-events-none disabled:opacity-50";
const dangerButton =
  "grid size-8 shrink-0 place-items-center rounded-lg text-slate-500 transition-colors hover:bg-red-50 hover:text-red-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 disabled:pointer-events-none disabled:opacity-50";

/** The row template — kept in one place so the header and the rows stay aligned. */
const rowGrid =
  "grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 md:grid-cols-[auto_minmax(0,1.2fr)_minmax(0,1fr)_auto_minmax(0,1.1fr)_auto] md:gap-x-4";

const initials = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? "")
    .join("");

const levelFilters = [
  { value: "", label: "Semua", count: counts.all },
  { value: "0", label: "Admin", count: counts.admin },
  { value: "1", label: "Level 1", count: counts.level1 },
  { value: "2", label: "Level 2", count: counts.level2 },
];
---

<DashboardLayout title="Pengguna" user={currentUser}>
  <div class="flex flex-wrap items-end justify-between gap-3" data-reveal="up">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">Pengguna</h1>
      <p class="mt-1 text-sm text-slate-500">
        {counts.all} akun · {counts.admin} admin · {counts.level1} level 1 · {counts.level2} level 2
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <Button variant="outline" type="button" data-open="positions-dialog">
        <Briefcase class="size-4" />
        Kelola Jabatan
      </Button>
      <Button type="button" data-open="create-dialog">
        <UserPlus class="size-4" />
        Tambah Pengguna
      </Button>
    </div>
  </div>

  {/* Pencarian & filter — menyaring baris yang sudah dirender, tanpa ke server. */}
  <div class="mt-6 flex flex-wrap items-center gap-3" data-reveal="up">
    <div class="relative min-w-0 flex-1 basis-full sm:basis-auto sm:max-w-xs">
      <Search class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-slate-400" />
      <label for="field-user-search" class="sr-only">Cari pengguna</label>
      <input
        id="field-user-search"
        type="search"
        autocomplete="off"
        placeholder="Cari nama, email, atau jabatan…"
        class="h-10 w-full rounded-lg border border-slate-300 bg-white pr-3 pl-9 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
        data-user-search
      />
    </div>

    <div
      role="group"
      aria-label="Filter level"
      class="flex flex-wrap items-center gap-1 rounded-lg border border-slate-200 bg-white p-1"
    >
      {
        levelFilters.map((filter) => (
          <button
            type="button"
            data-role-filter={filter.value}
            aria-pressed={filter.value === "" ? "true" : "false"}
            class="rounded-md px-2.5 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 aria-pressed:bg-brand-50 aria-pressed:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-brand-600"
          >
            {filter.label}
            <span class="ml-1 text-slate-400 tabular-nums">{filter.count}</span>
          </button>
        ))
      }
    </div>

    <p data-user-count role="status" class="ml-auto text-xs text-slate-500 tabular-nums">
      {counts.all} pengguna
    </p>
  </div>

  <div class="mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
    {/* Header baris: hanya tampil saat kolomnya juga tampil (md+). */}
    <div
      class:list={[
        rowGrid,
        "hidden border-b border-slate-200 bg-slate-50/60 px-5 py-2.5 text-xs font-medium tracking-wide text-slate-500 uppercase md:grid",
      ]}
    >
      <span class="size-9" aria-hidden="true"></span>
      <span>Nama</span>
      <span>Posisi/Jabatan</span>
      <span>Level</span>
      <span>Terakhir masuk</span>
      {/* Lebar tetap = dua tombol ikon, supaya kolom tiap baris sejajar. */}
      <span class="w-[66px]">
        <span class="sr-only">Tindakan</span>
      </span>
    </div>

    <ul data-user-list class="divide-y divide-slate-100">
      {
        users.map((user) => {
          const isSelf = user.id === Number(currentUser.id);
          const isAdmin = user.role === 0;
          const search = `${user.name} ${user.email} ${user.jabatan}`.toLowerCase();
          return (
            <li
              class:list={[
                rowGrid,
                "group px-4 py-3.5 transition-colors hover:bg-slate-50/80 sm:px-5",
              ]}
              data-user-row
              data-search={search}
              data-role={user.role}
              data-reveal="fade"
            >
              <span
                class:list={[
                  "row-start-1 grid size-9 shrink-0 place-items-center rounded-full text-xs font-semibold",
                  isAdmin ? "bg-brand-50 text-brand-700" : "bg-slate-100 text-slate-600",
                ]}
                aria-hidden="true"
              >
                {initials(user.name)}
              </span>

              <div class="col-start-2 min-w-0">
                <p class="flex items-center gap-1.5 truncate text-sm font-medium text-slate-900">
                  {user.name}
                  {isSelf && (
                    <span class="shrink-0 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold tracking-wide text-slate-500 uppercase">
                      Anda
                    </span>
                  )}
                </p>
                <p class="truncate text-xs text-slate-500" title={user.email}>
                  {user.email}
                </p>
              </div>

              <div class="col-start-2 col-end-4 row-start-2 flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1 md:contents">
                <span class="min-w-0 truncate text-sm text-slate-600 md:col-start-3">
                  {user.jabatan || <span class="text-slate-400">—</span>}
                </span>

                <span class="md:col-start-4">
                  <span
                    class:list={[
                      "inline-flex rounded-full px-2 py-0.5 text-xs font-medium",
                      isAdmin ? "bg-brand-50 text-brand-700" : "bg-slate-100 text-slate-600",
                    ]}
                  >
                    {roleLabel(user.role)}
                  </span>
                </span>

                <span class="min-w-0 basis-full text-xs text-slate-500 md:basis-auto md:col-start-5">
                  {user.last_login ? (
                    <>
                      <span class="inline-flex items-center gap-1.5 text-slate-700">
                        <MonitorSmartphone class="size-3.5 shrink-0 text-slate-400" />
                        {describeDevice(user.last_login.user_agent)}
                      </span>
                      <span class="block truncate">
                        {formatDateTime(user.last_login.created_at)} · IP {user.last_login.ip}
                      </span>
                    </>
                  ) : (
                    <span class="text-slate-400">Belum pernah masuk</span>
                  )}
                </span>
              </div>

              <div class="col-start-3 row-start-1 flex w-[66px] items-center justify-end gap-0.5 md:col-start-6">
                <button
                  type="button"
                  class={iconButton}
                  data-edit-open
                  data-user-id={user.id}
                  data-name={user.name}
                  data-email={user.email}
                  data-jabatan={user.jabatan}
                  data-role={user.role}
                  aria-label={`Ubah ${user.name}`}
                  title="Ubah data pengguna"
                >
                  <Pencil class="size-4" />
                </button>
                {!isAdmin && !isSelf && (
                  <button
                    type="button"
                    class={dangerButton}
                    data-delete-open
                    data-user-id={user.id}
                    data-name={user.name}
                    data-email={user.email}
                    data-jabatan={user.jabatan}
                    aria-label={`Hapus ${user.name}`}
                    title="Hapus pengguna"
                  >
                    <Trash class="size-4" />
                  </button>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>

    {
      users.length === 0 && (
        <div class="flex flex-col items-center gap-2 px-6 py-14 text-center">
          <Users class="size-8 text-slate-300" />
          <p class="text-sm font-medium text-slate-900">Belum ada pengguna</p>
          <p class="max-w-sm text-sm text-slate-500">
            Tambahkan akun pertama dengan tombol "Tambah pengguna".
          </p>
        </div>
      )
    }

    {/* Hasil pencarian/filter kosong — disembunyikan selama daftarnya utuh. */}
    <div data-user-empty hidden class="flex flex-col items-center gap-2 px-6 py-14 text-center">
      <Search class="size-8 text-slate-300" />
      <p class="text-sm font-medium text-slate-900">Tidak ada pengguna yang cocok</p>
      <p class="max-w-sm text-sm text-slate-500">Coba kata kunci lain atau ubah filter level.</p>
      <Button variant="outline" size="sm" type="button" data-user-reset class="mt-1">
        <X class="size-4" />
        Reset pencarian
      </Button>
    </div>
  </div>

  <p class="mt-3 inline-flex items-center gap-1.5 text-xs text-slate-500">
    <Lock class="size-3.5 text-slate-400" />
    Kata sandi tersimpan sebagai hash dan tidak dapat dilihat.
  </p>

  {/* Tambah pengguna — dialog, supaya daftar pengguna tetap jadi fokus halaman. */}
  <dialog id="create-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-lg" aria-labelledby="create-title">
    <form method="POST" data-create-form>
      <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
        <div>
          <h2 id="create-title" class="text-base font-semibold text-slate-900">Tambah pengguna</h2>
          <p class="mt-0.5 text-xs text-slate-500">Akun langsung aktif dengan kata sandi default.</p>
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label="Tutup"
          class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
        >
          <X class="size-4" />
        </button>
      </div>

      <div class="grid gap-4 p-5 sm:grid-cols-2 sm:px-6">
        <Input label="Nama lengkap" name="name" placeholder="mis. Siti Rahma" required />
        <Input label="Email" name="email" type="email" placeholder="nama@instansi.id" required />
        <div>
          <label for="field-jabatan" class="mb-1.5 block text-sm font-medium text-slate-700">
            Posisi/Jabatan
          </label>
          <select
            id="field-jabatan"
            name="jabatan"
            class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
          >
            <option value="">— Tanpa jabatan —</option>
            {positions.map((position) => <option value={position.label}>{position.label}</option>)}
          </select>
        </div>
        <div>
          <label for="field-role" class="mb-1.5 block text-sm font-medium text-slate-700">
            Level <span class="text-slate-400">(akses)</span>
          </label>
          <select
            id="field-role"
            name="role"
            class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
          >
            <option value="1" selected>Level 1</option>
            <option value="2">Level 2</option>
          </select>
        </div>
      </div>

      <div class="mx-5 mb-5 rounded-lg bg-slate-50 px-3 py-2.5 text-sm text-slate-600 sm:mx-6">
        <p class="flex flex-wrap items-center gap-1.5">
          Kata sandi default:
          <PasswordReveal value={DEFAULT_USER_PASSWORD} />
        </p>
        <p class="mt-1 text-xs text-slate-500">
          Sampaikan kepada pengguna dan minta segera menggantinya lewat halaman Profil.
        </p>
      </div>

      <p data-create-error hidden class="mx-5 mb-5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 sm:mx-6" role="alert"></p>

      <div class="flex flex-col-reverse gap-2 border-t border-slate-200 bg-slate-50/60 p-5 sm:flex-row sm:justify-end sm:px-6">
        <Button variant="outline" type="button" data-dialog-close>Batal</Button>
        <Button type="submit"><UserPlus class="size-4" />Tambah pengguna</Button>
      </div>
    </form>
  </dialog>

  {/* Posisi/Jabatan — sumber pilihan dropdown, dikelola di dialog sendiri. */}
  <dialog id="positions-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-lg" aria-labelledby="positions-title">
    <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
      <div>
        <h2 id="positions-title" class="text-base font-semibold text-slate-900">Posisi/Jabatan</h2>
        <p class="mt-0.5 text-xs text-slate-500">
          Pilihan untuk form pengguna. Mengubah nama di sini ikut memperbarui akun yang memakainya.
        </p>
      </div>
      <button
        type="button"
        data-dialog-close
        aria-label="Tutup"
        class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
      >
        <X class="size-4" />
      </button>
    </div>

    <form data-position-add class="mt-4 flex items-end gap-2 px-5 sm:px-6">
      <Input
        label="Jabatan baru"
        name="label"
        id="field-position-new"
        placeholder="mis. Staf Keuangan"
        required
        class="min-w-0 flex-1"
      />
      <Button type="submit" size="md"><Plus class="size-4" />Tambah</Button>
    </form>

    <p data-position-error hidden class="mx-5 mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 sm:mx-6" role="alert"></p>

    {
      positions.length > 0 ? (
        <ul class="mt-4 max-h-[50vh] overflow-y-auto border-y border-slate-200">
          {positions.map((position) => (
            <li class="flex items-center gap-2 px-5 py-2 transition-colors hover:bg-slate-50/80 sm:px-6">
              <form data-position-edit class="flex min-w-0 flex-1 items-center gap-2" data-id={position.id}>
                <input
                  name="label"
                  value={position.label}
                  required
                  aria-label={`Nama jabatan ${position.label}`}
                  class="h-9 min-w-0 flex-1 rounded-lg border border-transparent px-2.5 text-sm text-slate-900 transition-colors hover:border-slate-300 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
                />
                <button
                  type="submit"
                  class={iconButton}
                  title="Simpan nama jabatan"
                  aria-label={`Simpan ${position.label}`}
                >
                  <Check class="size-4" />
                </button>
              </form>
              <button
                type="button"
                class={dangerButton}
                data-position-delete
                data-id={position.id}
                data-label={position.label}
                title="Hapus jabatan"
                aria-label={`Hapus ${position.label}`}
              >
                <Trash class="size-4" />
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <div class="mx-5 mt-4 flex flex-col items-center gap-2 rounded-lg border border-dashed border-slate-300 px-6 py-10 text-center sm:mx-6">
          <Briefcase class="size-8 text-slate-300" />
          <p class="text-sm font-medium text-slate-900">Belum ada jabatan</p>
          <p class="max-w-xs text-sm text-slate-500">
            Tambahkan satu di atas — jabatan itu langsung muncul di dropdown form pengguna.
          </p>
        </div>
      )
    }

    <div class="flex justify-end p-5 sm:px-6">
      <Button variant="outline" type="button" data-dialog-close>Tutup</Button>
    </div>
  </dialog>

  {/* Ubah pengguna — satu dialog, diisi dari data atribut baris. */}
  <dialog id="edit-user-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-lg" aria-labelledby="edit-user-title">
    <form method="POST" data-edit-form>
      <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
        <div class="min-w-0">
          <h2 id="edit-user-title" class="text-base font-semibold text-slate-900">Ubah pengguna</h2>
          <p data-edit-subtitle class="mt-0.5 truncate text-xs text-slate-500"></p>
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label="Tutup"
          class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
        >
          <X class="size-4" />
        </button>
      </div>

      <div class="grid gap-4 p-5 sm:grid-cols-2 sm:px-6">
        <Input label="Nama lengkap" name="name" id="field-edit-name" required />
        <Input label="Email" name="email" id="field-edit-email" type="email" required />
        <div>
          <label for="field-edit-jabatan" class="mb-1.5 block text-sm font-medium text-slate-700">
            Posisi/Jabatan
          </label>
          <select
            id="field-edit-jabatan"
            name="jabatan"
            class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
          >
            <option value="">— Tanpa jabatan —</option>
            {positions.map((position) => <option value={position.label}>{position.label}</option>)}
          </select>
        </div>
        <div>
          <label for="field-edit-role" class="mb-1.5 block text-sm font-medium text-slate-700">
            Level <span class="text-slate-400">(akses)</span>
          </label>
          <select
            id="field-edit-role"
            name="role"
            class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
          >
            <option value="0">Admin</option>
            <option value="1">Level 1</option>
            <option value="2">Level 2</option>
          </select>
        </div>
      </div>

      <p class="mx-5 mb-5 flex items-center gap-1.5 text-xs text-slate-500 sm:mx-6">
        <Lock class="size-3.5 text-slate-400" />
        Kata sandi tidak berubah di sini.
      </p>

      <p data-edit-error hidden class="mx-5 mb-5 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700 sm:mx-6" role="alert"></p>

      <div class="flex flex-col-reverse gap-2 border-t border-slate-200 bg-slate-50/60 p-5 sm:flex-row sm:justify-end sm:px-6">
        <Button variant="outline" type="button" data-dialog-close>Batal</Button>
        <Button type="submit" data-edit-submit>Simpan perubahan</Button>
      </div>
    </form>
  </dialog>

  <dialog
    id="delete-dialog"
    class="app-dialog w-[calc(100vw-2rem)] max-w-md"
    aria-labelledby="delete-dialog-title"
  >
    <div class="p-5 sm:p-6">
      <div class="flex items-start gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-red-50 text-red-600">
          <TriangleAlert class="size-5" />
        </span>
        <div class="min-w-0 flex-1">
          <h2 id="delete-dialog-title" class="text-base font-semibold text-slate-900">
            Hapus pengguna ini?
          </h2>
          <div class="mt-2 flex items-center gap-2.5 rounded-lg border border-slate-200 px-3 py-2">
            <span
              data-dialog-initials
              class="grid size-8 shrink-0 place-items-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600"
              aria-hidden="true"
            >
            </span>
            <div class="min-w-0">
              <p data-dialog-name class="truncate text-sm font-medium text-slate-900"></p>
              <p data-dialog-email class="truncate text-xs text-slate-500"></p>
            </div>
          </div>
          <p class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-xs leading-relaxed text-red-700">
            Akun, riwayat login, dan postingannya akan dihapus permanen. Tindakan ini tidak dapat
            dibatalkan setelah 15 detik.
          </p>
        </div>
      </div>

      <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <Button variant="outline" type="button" data-dialog-cancel>
          <X class="size-4" />
          Batal
        </Button>
        <Button variant="dangerSolid" type="button" data-dialog-confirm>
          <Trash class="size-4" />
          Ya, hapus
        </Button>
      </div>
    </div>
  </dialog>

  <div id="delete-pending" hidden role="status" aria-live="polite" class="fixed inset-x-0 bottom-6 z-50 px-4">
    <div class="mx-auto w-full max-w-sm overflow-hidden rounded-xl bg-inverse text-oninverse shadow-2xl">
      <div class="flex items-center gap-3 px-4 py-3">
        <Trash class="size-4 shrink-0 text-slate-400" />
        <p class="min-w-0 flex-1 text-sm">
          Menghapus <span data-pending-name class="font-semibold"></span>…
        </p>
        <button
          type="button"
          data-pending-undo
          class="inline-flex shrink-0 items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-semibold text-brand-300 transition-colors hover:bg-oninverse/10 hover:text-oninverse focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400"
        >
          <Undo2 class="size-4" />
          Batalkan
        </button>
      </div>
      <div class="h-1 bg-oninverse/15">
        <div data-pending-progress class="h-full bg-brand-400"></div>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  import { actions } from "astro:actions";
  import { refreshPage, toast } from "../../scripts/dashboard.ts";
  import { hideToast, showToast } from "../../scripts/motion.ts";

  const UNDO_MS = 15000;

  // The router swaps the DOM but keeps this module, so the flow is wired again on
  // every astro:page-load.
  const init = () => {
    // The body is replaced on every navigation, so this marker is per page.
    if (document.body.dataset.usersWired) return;
    document.body.dataset.usersWired = "1";

    const openDialog = (id: string) => {
      const dialog = document.getElementById(id);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    };

    /** Buka/tutup dialog: satu delegasi untuk semua tombol `data-open` & `data-dialog-close`. */
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;

      const opener = target.closest<HTMLElement>("[data-open]");
      if (opener) {
        openDialog(opener.dataset.open ?? "");
        return;
      }

      const closer = target.closest<HTMLElement>("[data-dialog-close]");
      if (closer) {
        closer.closest("dialog")?.close();
        return;
      }

      // Klik pada area gelap di luar kartu menutup dialog.
      if (event.target instanceof HTMLDialogElement) event.target.close();
    });

    // Tambah pengguna — Astro Action.
    const createForm = document.querySelector<HTMLFormElement>("[data-create-form]");
    const createError = document.querySelector<HTMLElement>("[data-create-error]");
    createForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(createForm);
      const submit = createForm.querySelector<HTMLButtonElement>("[type=submit]");
      if (submit) submit.disabled = true;

      const { error } = await actions.createUserAccount({
        name: String(data.get("name") ?? ""),
        email: String(data.get("email") ?? ""),
        role: Number(data.get("role") ?? 1),
        jabatan: String(data.get("jabatan") ?? ""),
      });

      if (submit) submit.disabled = false;

      if (error) {
        if (createError) {
          createError.textContent = error.message ?? "Pengguna gagal dibuat.";
          createError.hidden = false;
        }
        return;
      }
      createForm.reset();
      createForm.closest("dialog")?.close();
      await refreshPage();
      toast("Pengguna berhasil dibuat.");
    });

    // Posisi/Jabatan — tambah, ubah nama (Enter / tombol centang), hapus.
    //
    // Setiap perubahan merender ulang halaman (dropdown form ikut segar), jadi dialognya
    // dibuka kembali setelah itu — admin tetap di tempatnya, tidak terlempar ke daftar.
    const refreshKeepingDialog = async (id: string) => {
      await refreshPage();
      const dialog = document.getElementById(id);
      if (dialog instanceof HTMLDialogElement && !dialog.open) dialog.showModal();
    };

    const positionError = document.querySelector<HTMLElement>("[data-position-error]");
    const showPositionError = (message: string) => {
      if (!positionError) return;
      positionError.textContent = message;
      positionError.hidden = false;
    };
    const clearPositionError = () => {
      if (positionError) positionError.hidden = true;
    };

    document.querySelector<HTMLFormElement>("[data-position-add]")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      const label = String(new FormData(form).get("label") ?? "").trim();
      if (!label) return;
      clearPositionError();

      const { error } = await actions.createPosition({ label });
      if (error) {
        showPositionError(error.message ?? "Jabatan gagal ditambahkan.");
        return;
      }
      await refreshKeepingDialog("positions-dialog");
      toast("Jabatan ditambahkan.");
      document.querySelector<HTMLInputElement>("#field-position-new")?.focus();
    });

    document.querySelectorAll<HTMLFormElement>("[data-position-edit]").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const label = String(new FormData(form).get("label") ?? "").trim();
        if (!label) return;
        clearPositionError();

        const { error } = await actions.updatePosition({ id: Number(form.dataset.id ?? 0), label });
        if (error) {
          showPositionError(error.message ?? "Jabatan gagal diubah.");
          return;
        }
        await refreshKeepingDialog("positions-dialog");
        toast("Jabatan diperbarui.");
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-position-delete]").forEach((button) => {
      button.addEventListener("click", async () => {
        const label = button.dataset.label ?? "";
        if (!window.confirm(`Hapus jabatan "${label}" dari daftar pilihan?`)) return;
        clearPositionError();

        const { error } = await actions.deletePosition({ id: Number(button.dataset.id ?? 0) });
        if (error) {
          showPositionError(error.message ?? "Jabatan gagal dihapus.");
          return;
        }
        await refreshKeepingDialog("positions-dialog");
        toast("Jabatan dihapus.");
      });
    });

    // Ubah pengguna — satu dialog, diisi dari data atribut baris.
    const editDialog = document.getElementById("edit-user-dialog") as HTMLDialogElement | null;
    const editForm = document.querySelector<HTMLFormElement>("[data-edit-form]");
    const editError = document.querySelector<HTMLElement>("[data-edit-error]");
    const editSubtitle = document.querySelector<HTMLElement>("[data-edit-subtitle]");

    if (editDialog && editForm) {
      const field = (name: string) => editForm.elements.namedItem(name) as HTMLInputElement | null;
      let editingId = 0;

      document.querySelectorAll<HTMLButtonElement>("[data-edit-open]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          editingId = Number(trigger.dataset.userId ?? 0);
          field("name")!.value = trigger.dataset.name ?? "";
          field("email")!.value = trigger.dataset.email ?? "";
          field("role")!.value = trigger.dataset.role ?? "1";
          if (editSubtitle) editSubtitle.textContent = trigger.dataset.email ?? "";

          // Jabatan yang sudah dihapus dari daftar tetap ditampilkan sebagai pilihan
          // sementara, supaya menyimpan form tidak diam-diam mengosongkannya.
          const jabatan = field("jabatan") as unknown as HTMLSelectElement;
          const current = trigger.dataset.jabatan ?? "";
          jabatan.querySelectorAll("[data-jabatan-stale]").forEach((option) => option.remove());
          if (current && ![...jabatan.options].some((option) => option.value === current)) {
            const option = new Option(current, current);
            option.dataset.jabatanStale = "1";
            jabatan.add(option);
          }
          jabatan.value = current;

          if (editError) editError.hidden = true;
          editDialog.showModal();
        });
      });

      editForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submit = editForm.querySelector<HTMLButtonElement>("[data-edit-submit]");
        if (submit) submit.disabled = true;

        const { error } = await actions.updateUserAccount({
          id: editingId,
          name: field("name")?.value ?? "",
          email: field("email")?.value ?? "",
          jabatan: field("jabatan")?.value ?? "",
          role: Number(field("role")?.value ?? 1),
        });

        if (submit) submit.disabled = false;

        if (error) {
          if (editError) {
            editError.textContent = error.message ?? "Pengguna gagal diubah.";
            editError.hidden = false;
          }
          return;
        }
        editDialog.close();
        await refreshPage();
        toast("Pengguna berhasil diubah.");
      });
    }

    // Pencarian + filter level — menyaring baris yang sudah dirender. Cukup untuk
    // daftar seukuran ini; pindahkan ke query server bila jumlah akun jadi ribuan.
    const rows = [...document.querySelectorAll<HTMLElement>("[data-user-row]")];
    const search = document.querySelector<HTMLInputElement>("[data-user-search]");
    const countLabel = document.querySelector<HTMLElement>("[data-user-count]");
    const emptyState = document.querySelector<HTMLElement>("[data-user-empty]");
    const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-role-filter]")];

    if (rows.length > 0) {
      let role = "";
      let query = "";

      const apply = () => {
        let shown = 0;
        for (const row of rows) {
          const matchesRole = role === "" || row.dataset.role === role;
          const matchesQuery = query === "" || (row.dataset.search ?? "").includes(query);
          const visible = matchesRole && matchesQuery;
          row.hidden = !visible;
          if (visible) shown++;
        }

        if (countLabel) {
          countLabel.textContent =
            shown === rows.length ? `${rows.length} pengguna` : `${shown} dari ${rows.length} pengguna`;
        }
        if (emptyState) emptyState.hidden = shown > 0;
      };

      search?.addEventListener("input", () => {
        query = search.value.trim().toLowerCase();
        apply();
      });

      filters.forEach((button) => {
        button.addEventListener("click", () => {
          role = button.dataset.roleFilter ?? "";
          filters.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
          apply();
        });
      });

      document.querySelector("[data-user-reset]")?.addEventListener("click", () => {
        if (search) search.value = "";
        query = "";
        role = "";
        filters.forEach((other) => other.setAttribute("aria-pressed", String(other.dataset.roleFilter === "")));
        apply();
        search?.focus();
      });
    }

    const dialog = document.getElementById("delete-dialog") as HTMLDialogElement | null;
    const notice = document.getElementById("delete-pending") as HTMLElement | null;
    // The script stays loaded across navigations — other pages have no delete flow.
    if (!dialog || !notice) return;

    const confirmButton = dialog.querySelector<HTMLButtonElement>("[data-dialog-confirm]")!;
    const dialogName = dialog.querySelector<HTMLElement>("[data-dialog-name]")!;
    const dialogEmail = dialog.querySelector<HTMLElement>("[data-dialog-email]")!;
    const dialogInitials = dialog.querySelector<HTMLElement>("[data-dialog-initials]")!;

    const noticeName = notice.querySelector<HTMLElement>("[data-pending-name]")!;
    const noticeProgress = notice.querySelector<HTMLElement>("[data-pending-progress]")!;
    const undoButton = notice.querySelector<HTMLButtonElement>("[data-pending-undo]")!;

    const triggers = [...document.querySelectorAll<HTMLButtonElement>("[data-delete-open]")];

    let asked: HTMLButtonElement | null = null; // row currently shown in the modal
    let pending: HTMLButtonElement | null = null; // row waiting out the undo window
    let timer: number | undefined;

    // shortcut: one pending delete at a time — the action runs once, so a second row
    // would silently lose its own countdown. Move to a queue if batch deletes are needed.
    const lockRows = (locked: boolean) => triggers.forEach((trigger) => (trigger.disabled = locked));

    const cancelPending = () => {
      window.clearTimeout(timer);
      // Inline, and always "1": `html.js [data-reveal]` sets opacity 0 until the
      // reveal animation runs, so clearing the value would hide the row.
      const row = pending?.closest("li");
      if (row) row.style.opacity = "1";
      pending = null;
      lockRows(false);
      hideToast(notice);
      noticeProgress.classList.remove("pending-countdown");
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        asked = trigger;
        const name = trigger.dataset.name ?? "";
        dialogName.textContent = name;
        dialogEmail.textContent = trigger.dataset.email ?? "";
        dialogInitials.textContent = name
          .split(" ")
          .filter(Boolean)
          .slice(0, 2)
          .map((part) => part[0]?.toUpperCase() ?? "")
          .join("");
        dialog.showModal();
      });
    });

    dialog.addEventListener("close", () => (asked = null));

    confirmButton.addEventListener("click", () => {
      const row = asked;
      dialog.close();
      if (!row || pending) return;

      pending = row;
      // Inline, for the same reason cancelPending() clears it inline.
      const pendingRow = row.closest("li");
      if (pendingRow) pendingRow.style.opacity = "0.5";
      lockRows(true);

      noticeName.textContent = row.dataset.name ?? "";
      showToast(notice);
      noticeProgress.classList.remove("pending-countdown");
      void noticeProgress.offsetWidth; // restart the bar on a repeat run
      noticeProgress.classList.add("pending-countdown");

      // The undo window runs out → the account is really deleted.
      timer = window.setTimeout(async () => {
        const { error } = await actions.deleteUserAccount({ id: Number(row.dataset.userId ?? 0) });
        if (error) {
          toast(error.message ?? "Pengguna gagal dihapus.", "error");
          cancelPending();
          return;
        }
        await refreshPage();
        toast("Pengguna dihapus.");
      }, UNDO_MS);
    });

    undoButton.addEventListener("click", cancelPending);
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>
