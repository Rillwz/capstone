---
// Titik lokasi absensi — satu kantor, satu geofence. Dipisah dari halaman laporan karena
// peta MapLibre harus di-mount ulang setiap navigasi, sedangkan filter laporan adalah link
// GET: menyatukannya membuat form yang setengah terisi hilang saat admin mengganti periode.
import { ArrowLeft, CheckCircle, InformationCircle, MapPin, ShieldCheck } from "../../../lib/icons";
import Button from "../../../components/ui/Button.astro";
import Input from "../../../components/ui/Input.astro";
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { requireAdmin } from "../../../lib/auth";
import { getAttendanceLocation } from "../../../lib/db";
import { ATTENDANCE_RADIUS_MAX, ATTENDANCE_RADIUS_MIN } from "../../../lib/attendance";

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const office = getAttendanceLocation();
---

<DashboardLayout title="Titik Lokasi Absensi" user={session.user}>
  <div class="flex flex-wrap items-end justify-between gap-3" data-reveal="up">
    <div>
      <a
        href="/dashboard/absensi"
        class="mb-1 inline-flex items-center gap-1 text-xs font-medium text-slate-500 hover:text-slate-900"
      >
        <ArrowLeft class="size-3.5" />
        Kembali ke laporan
      </a>
      <h1 class="text-xl font-semibold text-slate-900">Titik lokasi absensi</h1>
      <p class="mt-1 text-sm text-slate-500">
        Satu kantor, satu radius. Absen di luar lingkaran ini ditolak.
      </p>
    </div>
    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">Satu kantor</span>
  </div>

  <section class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
    <header class="flex flex-wrap items-center gap-2 border-b border-slate-200 px-5 py-4">
      <ShieldCheck class="size-4 text-slate-400" />
      <h2 class="text-sm font-semibold text-slate-900">Titik kantor</h2>
    </header>

    <div class="grid gap-4 p-5 lg:grid-cols-[minmax(0,1fr)_24rem]">
      <div class="overflow-hidden rounded-lg border border-slate-200">
        <div
          data-location-map
          class="h-72 w-full bg-slate-100"
          data-lat={office ? String(office.latitude) : "-6.2"}
          data-lng={office ? String(office.longitude) : "106.8166"}
          data-radius={office ? String(office.radius_m) : "100"}
        >
        </div>
        <p class="border-t border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-500">
          Geser pin untuk memindahkan titik; lingkaran menunjukkan radius absen.
        </p>
      </div>

      <form data-location-form class="space-y-3">
        <Input label="Nama lokasi" name="label" placeholder="Kantor Pusat" value={office ? office.label : ""} required />
        <div class="grid grid-cols-2 gap-3">
          <Input label="Latitude" name="latitude" type="number" step="any" value={office ? String(office.latitude) : ""} required />
          <Input label="Longitude" name="longitude" type="number" step="any" value={office ? String(office.longitude) : ""} required />
        </div>
        <div>
          <label for="field-radius_m" class="mb-1.5 block text-sm font-medium text-slate-700">
            Radius <span class="text-brand-600">*</span>
          </label>
          <input
            id="field-radius_m"
            name="radius_m"
            type="number"
            min={ATTENDANCE_RADIUS_MIN}
            max={ATTENDANCE_RADIUS_MAX}
            value={office ? String(office.radius_m) : "100"}
            required
            data-radius-input
            class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3.5 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-offset-0 focus:outline-brand-600"
          />
          <p class="mt-1 text-xs text-slate-500">{ATTENDANCE_RADIUS_MIN}–{ATTENDANCE_RADIUS_MAX} meter.</p>
          <p data-radius-warning hidden class="mt-1 flex items-start gap-1.5 text-xs text-amber-700">
            <InformationCircle class="mt-0.5 size-3.5 shrink-0" />
            GPS browser sering meleset ±20–50 m; radius di bawah 30 m akan menolak absen yang sah.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <Button type="button" variant="outline" size="sm" data-location-here>
            <MapPin class="size-4" />
            Gunakan lokasi saya
          </Button>
          <Button type="submit" size="sm" data-location-submit>
            <CheckCircle class="size-4" />
            Simpan
          </Button>
        </div>
        <p data-location-error hidden role="alert" class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></p>
      </form>
    </div>
  </section>

  <p class="mt-3 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
    <InformationCircle class="size-3.5 shrink-0 text-slate-400" />
    Absen hanya tercatat bila koordinat pegawai berada dalam radius titik ini, dan akurasi GPS-nya lebih
    baik dari radius. Riwayat absen menyimpan nama kantor saat kejadian, jadi mengganti nama tidak menulis
    ulang masa lalu.
  </p>
</DashboardLayout>

<script>
  import { actions } from "astro:actions";
  import { refreshPage, toast } from "../../../scripts/dashboard.ts";
  import { mountAttendanceMap, type AttendanceMap } from "../../../scripts/attendance-map.ts";

  // The router swaps the DOM but keeps modules: the map must be removed on navigation.
  let map: AttendanceMap | null = null;
  let wired = false;

  type Point = { latitude: number; longitude: number };
  let picked: Point | null = null;

  const form = () => document.querySelector<HTMLFormElement>("[data-location-form]");
  const errorBox = () => document.querySelector<HTMLElement>("[data-location-error]");

  function showError(message: string) {
    const box = errorBox();
    if (!box) return;
    box.textContent = message;
    box.hidden = false;
  }

  function syncForm(point: Point) {
    picked = point;
    const f = form();
    if (!f) return;
    const lat = f.querySelector<HTMLInputElement>('input[name="latitude"]');
    const lng = f.querySelector<HTMLInputElement>('input[name="longitude"]');
    if (lat) lat.value = point.latitude.toFixed(6);
    if (lng) lng.value = point.longitude.toFixed(6);
  }

  async function init() {
    const container = document.querySelector<HTMLElement>("[data-location-map]");
    // Wire the handlers before the map resolves: mounting is async (dynamic import), and an
    // input typed in that window must not be swallowed.
    if (!wired) {
      wired = true;
      wire();
    }
    if (!container || container.dataset.mounted) return;
    container.dataset.mounted = "1";

    const lat = Number(container.dataset.lat);
    const lng = Number(container.dataset.lng);
    const radius = Number(container.dataset.radius) || 100;
    map = await mountAttendanceMap(container, {
      latitude: lat,
      longitude: lng,
      zoom: 16,
      radius,
      draggable: true,
      onPick: (point) => syncForm(point),
    });
  }

  function wire() {
    document.addEventListener("input", (event) => {
      const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-radius-input]");
      if (!input) return;
      const radius = Number(input.value);
      map?.setRadius(radius);
      const warning = document.querySelector<HTMLElement>("[data-radius-warning]");
      if (warning) warning.hidden = !(radius > 0 && radius < 30);
    });

    document.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;

      const here = target.closest("[data-location-here]");
      if (here) {
        if (!window.isSecureContext) {
          showError("Lokasi hanya bisa dibaca lewat HTTPS atau localhost.");
          return;
        }
        navigator.geolocation.getCurrentPosition(
          (position) => {
            const point = {
              latitude: position.coords.latitude,
              longitude: position.coords.longitude,
            };
            syncForm(point);
            map?.setCenter(point.latitude, point.longitude, 17);
          },
          () => showError("Lokasi gagal dibaca. Isi koordinat manual bila perlu."),
          { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 },
        );
      }
    });

    document.addEventListener("submit", async (event) => {
      const f = (event.target as HTMLElement).closest<HTMLFormElement>("[data-location-form]");
      if (!f) return;
      event.preventDefault();

      const data = new FormData(f);
      const payload = {
        label: String(data.get("label") ?? ""),
        latitude: Number(data.get("latitude")),
        longitude: Number(data.get("longitude")),
        radius_m: Number(data.get("radius_m")),
      };
      if (picked) {
        payload.latitude = picked.latitude;
        payload.longitude = picked.longitude;
      }

      const submit = f.querySelector<HTMLButtonElement>("[data-location-submit]");
      const box = errorBox();
      if (box) box.hidden = true;
      if (submit) submit.disabled = true;

      // One office: this creates the point the first time and overwrites it afterwards.
      const { error } = await actions.saveAttendanceLocation(payload);

      if (submit) submit.disabled = false;

      if (error) {
        showError(error.message || "Lokasi gagal disimpan.");
        return;
      }
      await refreshPage();
      toast("Titik lokasi absensi disimpan.");
    });
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    map?.destroy();
    map = null;
  });
  init();
</script>
