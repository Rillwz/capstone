---
// Penugasan — per-user view: pick a user on the left, see every activity they carry on
// the right, grouped by unit kerja. "Tambah penugasan" opens one dialog holding the whole
// activity catalog (all units); the unit dropdown only filters panels client-side, so
// there is no reload between picking a user, a unit and the activities.
import { ClipboardCheck, ClipboardX, Plus, Search, Trash, TriangleAlert, UserRound, X } from "@lucide/astro";
import Button from "../../components/ui/Button.astro";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { requireAdmin } from "../../lib/auth";
import { categories } from "../../lib/categories";
import {
  createAssignments,
  deleteAssignment,
  deleteAssignmentActivity,
  listActivityCatalog,
  listAssignedActivitiesForUser,
  listAssignmentUsers,
  listUsers,
} from "../../lib/db";

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const members = listUsers().filter((user) => user.role !== 0);
const counts = new Map(listAssignmentUsers().map((row) => [row.id, row]));

let error: string | undefined;
let selectedId = Number(Astro.url.searchParams.get("user")) || 0;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action"));
  const userId = Number(form.get("userId"));
  selectedId = userId;
  const member = members.find((user) => user.id === userId);

  if (!member) {
    error = "Pengguna tidak valid.";
  } else if (action === "create") {
    const activityIds = [...form.getAll("activityIds").values()]
      .map((value) => Number(value))
      .filter((value) => Number.isInteger(value));
    if (activityIds.length === 0) {
      error = "Pilih minimal satu jenis aktivitas.";
    } else {
      const added = createAssignments(userId, activityIds);
      return Astro.redirect(`/dashboard/assignments?user=${userId}&saved=${added}`);
    }
  } else if (action === "remove-activity") {
    const activityId = Number(form.get("activityId"));
    if (Number.isInteger(activityId)) deleteAssignmentActivity(userId, activityId);
    return Astro.redirect(`/dashboard/assignments?user=${userId}&removed=1`);
  } else if (action === "remove-all") {
    deleteAssignment(userId);
    return Astro.redirect(`/dashboard/assignments?user=${userId}&cleared=1`);
  }
}

if (!members.some((user) => user.id === selectedId)) selectedId = members[0]?.id ?? 0;
const selected = members.find((user) => user.id === selectedId);

const catalog = selectedId ? listActivityCatalog(selectedId) : [];
const assignedIds = new Set(catalog.filter((activity) => activity.assigned).map((activity) => activity.id));

// Group the user's activities by unit, keeping the catalog's unit order.
const assignedActivities = selectedId ? listAssignedActivitiesForUser(selectedId) : [];
const byUnit = categories
  .map((category) => ({
    category,
    activities: assignedActivities.filter((activity) => activity.category_id === category.id),
  }))
  .filter((group) => group.activities.length > 0);

const totalActivities = byUnit.reduce((sum, group) => sum + group.activities.length, 0);
const unitsWithActivities = categories.filter((category) =>
  catalog.some((activity) => activity.category_id === category.id),
);
// Nothing left to hand out: every activity already belongs to this user.
const canAssign = catalog.some((activity) => !activity.assigned);

const saved = Number(Astro.url.searchParams.get("saved")) || 0;
const removed = Astro.url.searchParams.has("removed");
const cleared = Astro.url.searchParams.has("cleared");
---

<DashboardLayout title="Penugasan" user={session.user}>
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Penugasan</h1>
    <p class="mt-1 text-sm text-slate-500">
      Tetapkan jenis aktivitas unit kerja yang menjadi tanggung jawab tiap pengguna.
    </p>
  </div>

  {
    saved > 0 && (
      <p
        data-notice
        data-notice-params="saved"
        class="notice mt-6 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700"
        role="status"
      >
        {saved === 1 ? "Aktivitas ditugaskan." : `${saved} aktivitas ditugaskan.`}
      </p>
    )
  }
  {
    removed && (
      <p
        data-notice
        data-notice-params="removed"
        class="notice mt-6 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700"
        role="status"
      >
        Aktivitas dilepas dari penugasan.
      </p>
    )
  }
  {
    cleared && (
      <p
        data-notice
        data-notice-params="cleared"
        class="notice mt-6 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700"
        role="status"
      >
        Semua penugasan pengguna ini dihapus.
      </p>
    )
  }

  <div class="mt-6 grid items-start gap-6 lg:grid-cols-[19rem_1fr]">
    <!-- Left: the people you can assign to -->
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white">
      <header class="border-b border-slate-200 px-4 py-3">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="text-sm font-semibold text-slate-900">Pengguna</h2>
          <p data-user-count role="status" class="shrink-0 text-xs text-slate-500">{members.length} pengguna</p>
        </div>
        <p class="mt-0.5 text-xs text-slate-500">Pilih pengguna untuk mengelola penugasannya.</p>

        <div class="relative mt-3">
          <Search class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" />
          <label for="user-search" class="sr-only">Cari pengguna</label>
          <input
            id="user-search"
            type="search"
            data-user-search
            placeholder="Cari nama atau email"
            autocomplete="off"
            enterkeyhint="search"
            class="h-9 w-full rounded-lg border border-slate-300 bg-white pl-9 pr-9 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-2 focus:outline-brand-600 [&::-webkit-search-cancel-button]:appearance-none"
          />
          <button
            type="button"
            data-user-search-clear
            aria-label="Bersihkan pencarian"
            title="Bersihkan pencarian"
            hidden
            class="absolute right-1.5 top-1/2 grid size-6 -translate-y-1/2 place-items-center rounded-md text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
          >
            <X class="size-3.5" />
          </button>
          <kbd
            data-user-search-hint
            hidden
            class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-[10px] leading-none text-slate-400"
          >
            /
          </kbd>
        </div>
      </header>
      <ul class="divide-y divide-slate-100">
        {
          members.map((member) => {
            const row = counts.get(member.id);
            const active = member.id === selectedId;
            return (
              <li data-user-item data-search={`${member.name} ${member.email}`.toLowerCase()}>
                <a
                  href={`/dashboard/assignments?user=${member.id}`}
                  aria-current={active ? "true" : undefined}
                  class:list={[
                    "flex items-center gap-3 px-4 py-3 transition-colors",
                    active ? "bg-brand-50" : "hover:bg-slate-50",
                  ]}
                >
                  <span
                    class:list={[
                      "grid size-9 shrink-0 place-items-center rounded-full text-sm font-semibold",
                      active ? "bg-brand-600 text-onbrand" : "bg-slate-100 text-slate-500",
                    ]}
                  >
                    <UserRound class="size-4" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span
                      data-user-name
                      class:list={["block truncate text-sm font-medium", active ? "text-brand-700" : "text-slate-900"]}
                    >
                      {member.name}
                    </span>
                    <span data-user-email class="mt-0.5 block truncate text-xs text-slate-400">
                      {member.email}
                    </span>
                    <span class="mt-0.5 block truncate text-xs text-slate-500">
                      {row
                        ? `${row.activity_count} aktivitas · ${row.unit_count} unit`
                        : "Belum ada penugasan"}
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
        {
          members.length === 0 ? (
            <li class="px-4 py-8 text-center">
              <UserRound class="mx-auto size-6 text-slate-300" />
              <p class="mt-2 text-sm font-medium text-slate-900">Belum ada pengguna</p>
              <p class="mt-1 text-xs text-slate-500">Tambahkan pengguna dulu lewat menu Pengguna.</p>
            </li>
          ) : (
            <li data-user-empty hidden class="px-4 py-8 text-center">
              <UserRound class="mx-auto size-6 text-slate-300" />
              <p class="mt-2 text-sm font-medium text-slate-900">Pengguna tidak ditemukan</p>
              <p class="mt-1 text-xs text-slate-500">Coba nama atau email lain.</p>
              <button
                type="button"
                data-user-search-reset
                class="mt-3 text-xs font-medium text-brand-600 transition-colors hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-brand-600"
              >
                Bersihkan pencarian
              </button>
            </li>
          )
        }
      </ul>
    </section>

    <!-- Right: what this person carries -->
    <section class="min-w-0">
      {
        !selected ? (
          <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
            <UserRound class="mx-auto size-8 text-slate-300" />
            <p class="mt-2 text-sm font-medium text-slate-900">Belum ada pengguna level 1 atau 2</p>
            <p class="mt-1 text-sm text-slate-500">Tambahkan pengguna dulu lewat menu Pengguna.</p>
          </div>
        ) : (
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
            <header class="flex flex-col gap-3 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-center">
              <div class="min-w-0 flex-1">
                <h2 class="truncate text-base font-semibold text-slate-900">{selected.name}</h2>
                <p class="text-xs text-slate-500">
                  {selected.email}
                  {totalActivities > 0
                    ? ` · ${totalActivities} aktivitas di ${byUnit.length} unit kerja`
                    : " · belum ada penugasan"}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                {totalActivities > 0 && (
                  <Button variant="ghost" size="sm" type="button" data-clear-open>
                    <Trash class="size-4" />
                    Hapus semua
                  </Button>
                )}
                <Button
                  size="sm"
                  type="button"
                  data-assign-open
                  disabled={!canAssign}
                  title={canAssign ? undefined : "Semua aktivitas sudah ditugaskan ke pengguna ini"}
                >
                  <Plus class="size-4" />
                  Tambah penugasan
                </Button>
              </div>
            </header>

            {!canAssign && catalog.length > 0 && (
              <p class="border-b border-slate-200 bg-slate-50 px-5 py-2.5 text-xs text-slate-500">
                Semua jenis aktivitas sudah ditugaskan ke pengguna ini. Lepas salah satu untuk
                menugaskannya ulang.
              </p>
            )}

            {byUnit.length === 0 ? (
              <div class="px-5 py-12 text-center">
                <ClipboardX class="mx-auto size-8 text-slate-300" />
                {catalog.length === 0 ? (
                  <>
                    <p class="mt-2 text-sm font-medium text-slate-900">Belum ada jenis aktivitas</p>
                    <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">
                      Tambahkan jenis aktivitas unit kerja dulu lewat menu Kategori.
                    </p>
                    <Button class="mt-4" size="sm" variant="outline" href="/dashboard/categories">
                      Buka kategori
                    </Button>
                  </>
                ) : (
                  <>
                    <p class="mt-2 text-sm font-medium text-slate-900">Belum ada aktivitas untuk pengguna ini</p>
                    <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">
                      Klik <span class="font-medium text-slate-700">Tambah penugasan</span> untuk memilih unit kerja
                      beserta jenis aktivitasnya.
                    </p>
                  </>
                )}
              </div>
            ) : (
              <div class="divide-y divide-slate-200">
                {byUnit.map(({ category, activities }) => (
                  <div class="px-5 py-4">
                    <div class="flex items-center gap-2">
                      <category.icon class="size-4 text-slate-400" />
                      <h3 class="text-sm font-semibold text-slate-900">{category.label}</h3>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                        {activities.length}
                      </span>
                    </div>
                    <ul class="mt-2 divide-y divide-slate-100">
                      {activities.map((activity) => (
                        <li class="flex items-center gap-3 py-2">
                          <span class="min-w-0 flex-1 text-sm text-slate-800">{activity.name}</span>
                          <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                            {activity.periode}
                          </span>
                          <form method="POST" class="shrink-0">
                            <input type="hidden" name="action" value="remove-activity" />
                            <input type="hidden" name="userId" value={selected.id} />
                            <input type="hidden" name="activityId" value={activity.id} />
                            <button
                              type="submit"
                              aria-label={`Lepas ${activity.name}`}
                              class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-slate-500 transition-colors hover:bg-red-50 hover:text-red-600 focus-visible:outline-2 focus-visible:outline-brand-600"
                            >
                              <X class="size-3.5" />
                              Lepas
                            </button>
                          </form>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        )
      }
    </section>
  </div>

  <!-- Assignment dialog: the whole catalog, filtered by the unit dropdown (no reloads). -->
  <dialog
    id="assign-dialog"
    class="app-dialog w-[calc(100vw-2rem)] max-w-2xl"
    aria-labelledby="assign-title"
    data-reopen={error ? "true" : undefined}
  >
    <form method="POST" data-assign-form>
      <input type="hidden" name="action" value="create" />
      <input type="hidden" name="userId" value={selected?.id ?? 0} />

      <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
        <div>
          <h2 id="assign-title" class="text-base font-semibold text-slate-900">Tambah penugasan</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            {selected?.name} — pilih unit kerja, lalu centang jenis aktivitasnya.
          </p>
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label="Tutup"
          class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
        >
          <X class="size-4" />
        </button>
      </div>

      <div class="px-5 pt-4 sm:px-6">
        {
          error && (
            <p class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600" role="alert">
              {error}
            </p>
          )
        }
        <label for="unit-picker" class="mb-1.5 block text-sm font-medium text-slate-700">Unit kerja</label>
        <select
          id="unit-picker"
          name="unit"
          data-unit-picker
          class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
        >
          {
            unitsWithActivities.map((category, index) => (
              <option value={category.id} selected={index === 0}>
                {category.label}
              </option>
            ))
          }
        </select>
      </div>

      <div class="mt-4 max-h-[50vh] overflow-y-auto border-y border-slate-200 px-5 py-4 sm:px-6">
        {
          unitsWithActivities.map((category, index) => (
            <fieldset data-unit-panel={category.id} hidden={index > 0}>
              <legend class="sr-only">{category.label}</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                {catalog
                  .filter((activity) => activity.category_id === category.id)
                  .map((activity) => (
                    <label
                      class:list={[
                        "flex items-start gap-2.5 rounded-lg border px-3 py-2 text-sm transition-colors",
                        assignedIds.has(activity.id)
                          ? "border-slate-200 bg-slate-50 text-slate-400"
                          : "cursor-pointer border-slate-200 hover:bg-slate-50",
                      ]}
                    >
                      <input
                        type="checkbox"
                        name="activityIds"
                        value={activity.id}
                        disabled={assignedIds.has(activity.id)}
                        class="mt-0.5 size-4 shrink-0 rounded border-slate-300 text-brand-600 focus:ring-brand-600"
                      />
                      <span class="min-w-0">
                        <span class="block">{activity.name}</span>
                        <span class="block text-xs text-slate-400">
                          {assignedIds.has(activity.id) ? "sudah ditugaskan · " : ""}
                          {activity.periode}
                        </span>
                      </span>
                    </label>
                  ))}
              </div>
            </fieldset>
          ))
        }
      </div>

      <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-end sm:px-6">
        <p data-dialog-hint class="text-xs text-slate-500 sm:mr-auto"></p>
        <div class="flex flex-col-reverse gap-2 sm:flex-row">
          <Button variant="outline" type="button" data-dialog-close>Batal</Button>
          <Button type="submit" disabled={!canAssign}>
            <ClipboardCheck class="size-4" />
            Simpan penugasan
          </Button>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="clear-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-md" aria-labelledby="clear-title">
    <form method="POST">
      <input type="hidden" name="action" value="remove-all" />
      <input type="hidden" name="userId" value={selected?.id ?? 0} />
      <div class="p-5 sm:p-6">
        <div class="flex items-start gap-3">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-red-50 text-red-600">
            <TriangleAlert class="size-5" />
          </span>
          <div class="min-w-0 flex-1">
            <h2 id="clear-title" class="text-base font-semibold text-slate-900">Hapus semua penugasan?</h2>
            <p class="mt-1.5 text-sm text-slate-600">
              {totalActivities} aktivitas milik{" "}
              <span class="font-medium text-slate-900">{selected?.name}</span> akan dilepas dari semua unit
              kerja.
            </p>
          </div>
        </div>
        <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <Button variant="outline" type="button" data-dialog-close>
            Batal
          </Button>
          <Button variant="dangerSolid" type="submit">
            <Trash class="size-4" />
            Ya, hapus semua
          </Button>
        </div>
      </div>
    </form>
  </dialog>
</DashboardLayout>

<script>
  import "../../scripts/notices.ts";

  const assignDialog = document.getElementById("assign-dialog") as HTMLDialogElement | null;
  const clearDialog = document.getElementById("clear-dialog") as HTMLDialogElement | null;

  const open = (dialog: HTMLDialogElement | null) => {
    if (!dialog) return;
    dialog.showModal();
    document.documentElement.style.overflow = "hidden";
  };

  [assignDialog, clearDialog].forEach((dialog) => {
    if (!dialog) return;
    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });
    // Backdrop click closes; clicks inside the panel do not.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelectorAll<HTMLElement>("[data-dialog-close]").forEach((button) => {
      button.addEventListener("click", () => dialog.close());
    });
  });

  document.querySelector("[data-assign-open]")?.addEventListener("click", () => open(assignDialog));
  document.querySelector("[data-clear-open]")?.addEventListener("click", () => open(clearDialog));

  // A rejected POST re-renders the page; reopen the dialog so the error sits beside the form.
  if (assignDialog?.dataset.reopen) open(assignDialog);

  // Flash notices leave on their own: 4s to read, then the fade-out. Their URL params go
  // with them so a refresh cannot show them twice.
  // Unit dropdown filters the catalog panels; the submit hint follows the selections.
  const form = document.querySelector<HTMLFormElement>("[data-assign-form]");
  const picker = document.querySelector<HTMLSelectElement>("[data-unit-picker]");
  const hint = document.querySelector<HTMLElement>("[data-dialog-hint]");

  const syncPanels = () => {
    const unit = picker?.value;
    document.querySelectorAll<HTMLElement>("[data-unit-panel]").forEach((panel) => {
      panel.hidden = panel.dataset.unitPanel !== unit;
    });
    if (!form || !hint) return;
    const checked = form.querySelectorAll<HTMLInputElement>('input[name="activityIds"]:checked').length;
    hint.textContent = checked === 0 ? "Belum ada aktivitas dipilih." : `${checked} aktivitas dipilih.`;
  };

  picker?.addEventListener("change", syncPanels);
  form?.addEventListener("change", syncPanels);
  syncPanels();
</script>

<script>
  // User search — filters the people list in place. No reload: the selected user's
  // panel on the right stays as it is, and the query never touches the URL.
  const searchInput = document.querySelector<HTMLInputElement>("[data-user-search]");
  const searchClear = document.querySelector<HTMLButtonElement>("[data-user-search-clear]");
  const searchHint = document.querySelector<HTMLElement>("[data-user-search-hint]");
  const searchCount = document.querySelector<HTMLElement>("[data-user-count]");
  const searchEmpty = document.querySelector<HTMLElement>("[data-user-empty]");
  const userItems = [...document.querySelectorAll<HTMLElement>("[data-user-item]")];

  /** Wraps the matched part of a label in <mark>. Text nodes only — a name is never
      turned into markup. */
  const highlight = (el: HTMLElement | null, query: string) => {
    if (!el) return;
    const text = el.textContent ?? "";
    el.replaceChildren();
    if (!query) {
      el.textContent = text;
      return;
    }
    const haystack = text.toLowerCase();
    let cursor = 0;
    let at = haystack.indexOf(query);
    while (at !== -1) {
      if (at > cursor) el.append(text.slice(cursor, at));
      const mark = document.createElement("mark");
      mark.textContent = text.slice(at, at + query.length);
      mark.className = "rounded bg-brand-100 px-0.5 text-brand-900";
      el.append(mark);
      cursor = at + query.length;
      at = haystack.indexOf(query, cursor);
    }
    el.append(text.slice(cursor));
  };

  const applyUserSearch = (raw: string) => {
    const query = raw.trim().toLowerCase();
    let visible = 0;

    for (const item of userItems) {
      const match = !query || (item.dataset.search ?? "").includes(query);
      item.hidden = !match;
      // Hidden rows are reset too, so no stale highlight is left behind.
      highlight(item.querySelector<HTMLElement>("[data-user-name]"), match ? query : "");
      highlight(item.querySelector<HTMLElement>("[data-user-email]"), match ? query : "");
      if (match) visible++;
    }

    if (searchCount) {
      searchCount.textContent = query
        ? `${visible} dari ${userItems.length} pengguna`
        : `${userItems.length} pengguna`;
    }
    if (searchEmpty) searchEmpty.hidden = !query || visible > 0;
    if (searchClear) searchClear.hidden = raw.length === 0;
    if (searchHint) searchHint.hidden = raw.length > 0;
  };

  searchInput?.addEventListener("input", () => applyUserSearch(searchInput.value));

  searchInput?.addEventListener("keydown", (event) => {
    // Esc clears the query and keeps the caret in the field.
    if (event.key === "Escape" && searchInput.value) {
      event.preventDefault();
      searchInput.value = "";
      applyUserSearch("");
      return;
    }
    // Enter jumps to the first person still on screen.
    if (event.key === "Enter") {
      userItems.find((item) => !item.hidden)?.querySelector<HTMLAnchorElement>("a")?.focus();
    }
  });

  document.querySelectorAll<HTMLElement>("[data-user-search-clear], [data-user-search-reset]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!searchInput) return;
      searchInput.value = "";
      applyUserSearch("");
      searchInput.focus();
    });
  });

  // "/" focuses the search from anywhere on the page, unless the caret is already in a field.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    const tag = target?.tagName;
    if (target?.isContentEditable || tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
    event.preventDefault();
    searchInput?.focus();
  });

  applyUserSearch("");
</script>

<style>
  /* The divider follows the last visible row, so filtering never leaves a stray line.
     shortcut: needs :has() (2023+ browsers) — without it only the trailing hairline
     is off; drop this rule if the browser floor ever goes lower. */
  [data-user-item]:not(:has(~ li:not([hidden]))) {
    border-bottom-width: 0;
  }
</style>
