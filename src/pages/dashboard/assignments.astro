---
// Penugasan — per-user view: pick a user on the left, see every activity they carry on
// the right, grouped by unit kerja. "Tambah penugasan" opens one dialog holding the whole
// activity catalog (all units); the unit dropdown only filters panels client-side, so
// there is no reload between picking a user, a unit and the activities.
//
// Aksinya memakai Astro Action (src/actions) — assigning, melepas, dan mengosongkan
// penugasan tidak memuat ulang halaman.
import {
  ClipboardCheck,
  ClipboardX,
  Plus,
  Search,
  Trash,
  TriangleAlert,
  UserRound,
  Users,
  X,
  Zap,
} from "@lucide/astro";
import Button from "../../components/ui/Button.astro";
import DirectAssignDialog from "../../components/admin/DirectAssignDialog.astro";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { requireAdmin } from "../../lib/auth";
import { listCategories } from "../../lib/categories";
import {
  listActivityCatalog,
  listAssignedActivitiesForUser,
  listAssignmentUsers,
  listUsers,
} from "../../lib/db";

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const members = listUsers().filter((user) => user.role !== 0);
const categories = listCategories();
const counts = new Map(listAssignmentUsers().map((row) => [row.id, row]));

let selectedId = Number(Astro.url.searchParams.get("user")) || 0;

if (!members.some((user) => user.id === selectedId)) selectedId = members[0]?.id ?? 0;
const selected = members.find((user) => user.id === selectedId);

const catalog = selectedId ? listActivityCatalog(selectedId) : [];
const assignedIds = new Set(catalog.filter((activity) => activity.assigned).map((activity) => activity.id));

// Katalog tanpa filter "sudah ditugaskan" — dipakai dialog massal, di sana yang
// menentukan adalah pasangan orang × aktivitas, bukan satu orang. id 0 = tidak ada
// pengguna, jadi flag `assigned` selalu 0.
const fullCatalog = listActivityCatalog(0);

// Group the user's activities by unit, keeping the catalog's unit order.
const assignedActivities = selectedId ? listAssignedActivitiesForUser(selectedId) : [];
const byUnit = categories
  .map((category) => ({
    category,
    activities: assignedActivities.filter((activity) => activity.category_id === category.id),
  }))
  .filter((group) => group.activities.length > 0);

const totalActivities = byUnit.reduce((sum, group) => sum + group.activities.length, 0);
const unitsWithActivities = categories.filter((category) =>
  catalog.some((activity) => activity.category_id === category.id),
);
// Nothing left to hand out: every activity already belongs to this user.
const canAssign = catalog.some((activity) => !activity.assigned);

// Posisi/Jabatan tampil sebagai badge di daftar pengguna. Yang kosong tetap diberi
// penanda supaya barisnya tidak terlihat "bolong" — bukan cuma hilang begitu saja.
// inline-block (bukan inline-flex) supaya `truncate` benar-benar memberi elipsis.
const jabatanBadge =
  "inline-block max-w-full truncate rounded-md bg-slate-100 px-1.5 py-0.5 align-middle text-[11px] font-medium leading-4 text-slate-600";
const noJabatanBadge =
  "inline-block max-w-full truncate rounded-md border border-dashed border-slate-200 px-1.5 py-0.5 align-middle text-[11px] leading-4 text-slate-400";
---

<DashboardLayout title="Penugasan" user={session.user}>
  <div class="flex flex-wrap items-end justify-between gap-3" data-reveal="up">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">Penugasan</h1>
      <p class="mt-1 text-sm text-slate-500">
        Tetapkan jenis aktivitas unit kerja yang menjadi tanggung jawab tiap pengguna.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <Button type="button" variant="outline" data-direct-open disabled={members.length === 0}>
        <Zap class="size-4" />
        Penugasan Langsung
      </Button>
      <Button type="button" variant="outline" data-bulk-open disabled={members.length === 0}>
        <Users class="size-4" />
        Penugasan Massal
      </Button>
    </div>
  </div>

  <div class="mt-6 grid items-start gap-6 lg:grid-cols-[19rem_1fr]">
    <!-- Left: the people you can assign to -->
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
      <header class="border-b border-slate-200 px-4 py-3">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="text-sm font-semibold text-slate-900">Pengguna</h2>
          <p data-user-count role="status" class="shrink-0 text-xs text-slate-500">{members.length} pengguna</p>
        </div>
        <p class="mt-0.5 text-xs text-slate-500">Pilih pengguna untuk mengelola penugasannya.</p>

        <div class="relative mt-3">
          <Search class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" />
          <label for="user-search" class="sr-only">Cari pengguna</label>
          <input
            id="user-search"
            type="search"
            data-user-search
            placeholder="Cari nama, email, atau jabatan"
            autocomplete="off"
            enterkeyhint="search"
            class="h-9 w-full rounded-lg border border-slate-300 bg-white pl-9 pr-9 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-2 focus:outline-brand-600 [&::-webkit-search-cancel-button]:appearance-none"
          />
          <button
            type="button"
            data-user-search-clear
            aria-label="Bersihkan pencarian"
            title="Bersihkan pencarian"
            hidden
            class="absolute right-1.5 top-1/2 grid size-6 -translate-y-1/2 place-items-center rounded-md text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
          >
            <X class="size-3.5" />
          </button>
          <kbd
            data-user-search-hint
            hidden
            class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-slate-200 bg-slate-50 px-1.5 py-0.5 font-sans text-[10px] leading-none text-slate-400"
          >
            /
          </kbd>
        </div>
      </header>
      <ul class="divide-y divide-slate-100">
        {
          members.map((member) => {
            const row = counts.get(member.id);
            const active = member.id === selectedId;
            return (
              <li
                data-user-item
                data-reveal="fade"
                data-search={`${member.name} ${member.email} ${member.jabatan}`.toLowerCase()}
              >
                <a
                  href={`/dashboard/assignments?user=${member.id}`}
                  aria-current={active ? "true" : undefined}
                  class:list={[
                    "flex items-center gap-3 px-4 py-3 transition-colors",
                    active ? "bg-brand-50" : "hover:bg-slate-50",
                  ]}
                >
                  <span
                    class:list={[
                      "grid size-9 shrink-0 place-items-center rounded-full text-sm font-semibold",
                      active ? "bg-brand-600 text-onbrand" : "bg-slate-100 text-slate-500",
                    ]}
                  >
                    <UserRound class="size-4" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span
                      data-user-name
                      class:list={["block truncate text-sm font-medium", active ? "text-brand-700" : "text-slate-900"]}
                    >
                      {member.name}
                    </span>
                    <span data-user-email class="mt-0.5 block truncate text-xs text-slate-400">
                      {member.email}
                    </span>
                    <span class="mt-1.5 flex items-center justify-between gap-2">
                      {member.jabatan ? (
                        <span
                          data-user-jabatan
                          class:list={[jabatanBadge, "min-w-0"]}
                          title={`Posisi/Jabatan: ${member.jabatan}`}
                        >
                          {member.jabatan}
                        </span>
                      ) : (
                        <span class={noJabatanBadge} title="Belum diisi di menu Pengguna">
                          Tanpa jabatan
                        </span>
                      )}
                      <span class="shrink-0 text-xs text-slate-500">
                        {row ? `${row.activity_count} aktivitas · ${row.unit_count} unit` : "Belum ada penugasan"}
                      </span>
                    </span>
                  </span>
                </a>
              </li>
            );
          })
        }
        {
          members.length === 0 ? (
            <li class="px-4 py-8 text-center">
              <UserRound class="mx-auto size-6 text-slate-300" />
              <p class="mt-2 text-sm font-medium text-slate-900">Belum ada pengguna</p>
              <p class="mt-1 text-xs text-slate-500">Tambahkan pengguna dulu lewat menu Pengguna.</p>
            </li>
          ) : (
            <li data-user-empty hidden class="px-4 py-8 text-center">
              <UserRound class="mx-auto size-6 text-slate-300" />
              <p class="mt-2 text-sm font-medium text-slate-900">Pengguna tidak ditemukan</p>
              <p class="mt-1 text-xs text-slate-500">Coba nama atau email lain.</p>
              <button
                type="button"
                data-user-search-reset
                class="mt-3 text-xs font-medium text-brand-600 transition-colors hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-brand-600"
              >
                Bersihkan pencarian
              </button>
            </li>
          )
        }
      </ul>
    </section>

    <!-- Right: what this person carries -->
    <section class="min-w-0" data-reveal="up">
      {
        !selected ? (
          <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
            <UserRound class="mx-auto size-8 text-slate-300" />
            <p class="mt-2 text-sm font-medium text-slate-900">Belum ada pengguna level 1 atau 2</p>
            <p class="mt-1 text-sm text-slate-500">Tambahkan pengguna dulu lewat menu Pengguna.</p>
          </div>
        ) : (
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
            <header class="flex flex-col gap-3 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-center">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <h2 class="truncate text-base font-semibold text-slate-900">{selected.name}</h2>
                  {selected.jabatan ? (
                    <span class={jabatanBadge} title={`Posisi/Jabatan: ${selected.jabatan}`}>
                      {selected.jabatan}
                    </span>
                  ) : (
                    <span class={noJabatanBadge} title="Belum diisi di menu Pengguna">
                      Tanpa jabatan
                    </span>
                  )}
                </div>
                <p class="mt-0.5 text-xs text-slate-500">
                  {selected.email}
                  {totalActivities > 0
                    ? ` · ${totalActivities} aktivitas di ${byUnit.length} unit kerja`
                    : " · belum ada penugasan"}
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                {totalActivities > 0 && (
                  <Button variant="ghost" size="sm" type="button" data-clear-open>
                    <Trash class="size-4" />
                    Hapus semua
                  </Button>
                )}
                <Button
                  size="sm"
                  type="button"
                  data-assign-open
                  disabled={!canAssign}
                  title={canAssign ? undefined : "Semua aktivitas sudah ditugaskan ke pengguna ini"}
                >
                  <Plus class="size-4" />
                  Tambah
                </Button>
              </div>
            </header>

            {!canAssign && catalog.length > 0 && (
              <p class="border-b border-slate-200 bg-slate-50 px-5 py-2.5 text-xs text-slate-500">
                Semua jenis aktivitas sudah ditugaskan ke pengguna ini. Lepas salah satu untuk
                menugaskannya ulang.
              </p>
            )}

            {byUnit.length === 0 ? (
              <div class="px-5 py-12 text-center">
                <ClipboardX class="mx-auto size-8 text-slate-300" />
                {catalog.length === 0 ? (
                  <>
                    <p class="mt-2 text-sm font-medium text-slate-900">Belum ada jenis aktivitas</p>
                    <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">
                      Tambahkan jenis aktivitas unit kerja dulu lewat menu Kategori.
                    </p>
                    <Button class="mt-4" size="sm" variant="outline" href="/dashboard/categories">
                      Buka kategori
                    </Button>
                  </>
                ) : (
                  <>
                    <p class="mt-2 text-sm font-medium text-slate-900">Belum ada aktivitas untuk pengguna ini</p>
                    <p class="mx-auto mt-1 max-w-sm text-sm text-slate-500">
                      Klik <span class="font-medium text-slate-700">Tambah penugasan</span> untuk memilih unit kerja
                      beserta jenis aktivitasnya.
                    </p>
                  </>
                )}
              </div>
            ) : (
              <div class="divide-y divide-slate-200">
                {byUnit.map(({ category, activities }) => (
                  <div class="px-5 py-4" data-reveal="up">
                    <div class="flex items-center gap-2">
                      <category.icon class="size-4 text-slate-400" />
                      <h3 class="text-sm font-semibold text-slate-900">{category.label}</h3>
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                        {activities.length}
                      </span>
                    </div>
                    <ul class="mt-2 divide-y divide-slate-100">
                      {activities.map((activity) => (
                        <li class="flex items-center gap-3 py-2" data-reveal="fade">
                          <span class="min-w-0 flex-1 text-sm text-slate-800">{activity.name}</span>
                          <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                            {activity.periode}
                          </span>
                          <button
                            type="button"
                            data-remove-activity
                            data-user-id={selected.id}
                            data-activity-id={activity.id}
                            aria-label={`Lepas ${activity.name}`}
                            class="inline-flex shrink-0 items-center gap-1 rounded-lg px-2 py-1 text-xs font-medium text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
                          >
                            <X class="size-3.5" />
                            Lepas
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        )
      }
    </section>
  </div>

  <!-- Assignment dialog: the whole catalog, filtered by the unit dropdown (no reloads). -->
  <dialog id="assign-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-2xl" aria-labelledby="assign-title">
    {/* Formulir ini cuma wadah field-nya — submit-nya ditangani Astro Action. */}
    <form method="POST" data-assign-form data-user-id={selected?.id ?? 0}>
      <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
        <div>
          <h2 id="assign-title" class="text-base font-semibold text-slate-900">Tambah Penugasan</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            {selected?.name} — pilih unit kerja, lalu centang jenis aktivitasnya.
          </p>
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label="Tutup"
          class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
        >
          <X class="size-4" />
        </button>
      </div>

      <div class="px-5 pt-4 sm:px-6">
        <p data-assign-error hidden class="mb-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600" role="alert">
        </p>
        <label for="unit-picker" class="mb-1.5 block text-sm font-medium text-slate-700">Unit kerja</label>
        <select
          id="unit-picker"
          name="unit"
          data-unit-picker
          class="h-11 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
        >
          {
            unitsWithActivities.map((category, index) => (
              <option value={category.id} selected={index === 0}>
                {category.label}
              </option>
            ))
          }
        </select>
      </div>

      <div class="mt-4 max-h-[50vh] overflow-y-auto border-y border-slate-200 px-5 py-4 sm:px-6">
        {
          unitsWithActivities.map((category, index) => (
            <fieldset data-unit-panel={category.id} hidden={index > 0}>
              <legend class="sr-only">{category.label}</legend>
              <div class="grid gap-2 sm:grid-cols-2">
                {catalog
                  .filter((activity) => activity.category_id === category.id)
                  .map((activity) => (
                    <label
                      class:list={[
                        "flex items-start gap-2.5 rounded-lg border px-3 py-2 text-sm transition-colors",
                        assignedIds.has(activity.id)
                          ? "border-slate-200 bg-slate-50 text-slate-400"
                          : "cursor-pointer border-slate-200 hover:bg-slate-50",
                      ]}
                    >
                      <input
                        type="checkbox"
                        name="activityIds"
                        value={activity.id}
                        disabled={assignedIds.has(activity.id)}
                        class="mt-0.5 size-4 shrink-0 rounded border-slate-300 text-brand-600 focus:ring-brand-600"
                      />
                      <span class="min-w-0">
                        <span class="block">{activity.name}</span>
                        <span class="block text-xs text-slate-400">
                          {assignedIds.has(activity.id) ? "sudah ditugaskan · " : ""}
                          {activity.periode}
                        </span>
                      </span>
                    </label>
                  ))}
              </div>
            </fieldset>
          ))
        }
      </div>

      <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-end sm:px-6">
        <p data-dialog-hint class="text-xs text-slate-500 sm:mr-auto"></p>
        <div class="flex flex-col-reverse gap-2 sm:flex-row">
          <Button variant="outline" type="button" data-dialog-close>Batal</Button>
          <Button type="submit" disabled={!canAssign}>
            <ClipboardCheck class="size-4" />
            Simpan
          </Button>
        </div>
      </div>
    </form>
  </dialog>

  <!-- Penugasan massal: pilih pekerjaan dulu, lalu pilih banyak orang sekaligus.
       Kebalikan dari alur per-user di atas; yang sudah terpasang dilewati, tidak gagal. -->
  <dialog id="bulk-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-2xl" aria-labelledby="bulk-title">
    <form method="POST" data-bulk-form>
      <div class="flex items-start justify-between gap-3 p-5 pb-0 sm:px-6">
        <div>
          <h2 id="bulk-title" class="text-base font-semibold text-slate-900">Tambah Penugasan Massal</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            Pilih jenis aktivitas, lalu centang pengguna yang akan memegangnya.
          </p>
        </div>
        <button
          type="button"
          data-dialog-close
          aria-label="Tutup"
          class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-brand-600"
        >
          <X class="size-4" />
        </button>
      </div>

      <p data-bulk-error hidden class="mx-5 mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600 sm:mx-6" role="alert"></p>

      <div class="mt-4 max-h-[58vh] overflow-y-auto border-y border-slate-200">
        <!-- Langkah 1: pekerjaan -->
        <section class="px-5 py-4 sm:px-6">
          <div class="flex items-center justify-between gap-2">
            <label for="bulk-unit" class="text-sm font-medium text-slate-900">1. Jenis aktivitas</label>
            <button
              type="button"
              data-bulk-activity-all
              disabled={unitsWithActivities.length === 0}
              class="text-xs font-medium text-brand-600 transition-colors hover:text-brand-700 disabled:text-slate-400 focus-visible:outline-2 focus-visible:outline-brand-600"
            >
              Centang semua unit ini
            </button>
          </div>

          {
            unitsWithActivities.length === 0 ? (
              <p class="mt-2 rounded-lg border border-dashed border-slate-300 px-3 py-4 text-center text-sm text-slate-500">
                Belum ada jenis aktivitas. Tambahkan dulu lewat menu Kategori.
              </p>
            ) : (
              <>
                <select
                  id="bulk-unit"
                  data-bulk-unit
                  class="mt-2 h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm text-slate-900 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
                >
                  {unitsWithActivities.map((category, index) => (
                    <option value={category.id} selected={index === 0}>
                      {category.label}
                    </option>
                  ))}
                </select>

                <div class="mt-2">
                  {unitsWithActivities.map((category, index) => (
                    <fieldset data-bulk-panel={category.id} hidden={index > 0}>
                      <legend class="sr-only">{category.label}</legend>
                      <div class="grid gap-1.5 sm:grid-cols-2">
                        {fullCatalog
                          .filter((activity) => activity.category_id === category.id)
                          .map((activity) => (
                            <label class="flex cursor-pointer items-start gap-2.5 rounded-lg border border-slate-200 px-3 py-2 text-sm transition-colors hover:bg-slate-50 has-[:checked]:border-brand-300 has-[:checked]:bg-brand-50">
                              <input
                                type="checkbox"
                                name="bulkActivityIds"
                                value={activity.id}
                                data-bulk-activity={category.id}
                                class="mt-0.5 size-4 shrink-0 rounded border-slate-300 text-brand-600 focus:ring-brand-600"
                              />
                              <span class="min-w-0">
                                <span class="block">{activity.name}</span>
                                <span class="block text-xs text-slate-400">{activity.periode}</span>
                              </span>
                            </label>
                          ))}
                      </div>
                    </fieldset>
                  ))}
                </div>
              </>
            )
          }
        </section>

        <!-- Langkah 2: orangnya -->
        <section class="border-t border-slate-200 px-5 py-4 sm:px-6">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <p class="text-sm font-medium text-slate-900">2. Pengguna</p>
              <p data-bulk-user-count class="text-xs text-slate-500">
                {members.length} pengguna level 1 &amp; 2
              </p>
            </div>
            <button
              type="button"
              data-bulk-user-all
              class="text-xs font-medium text-brand-600 transition-colors hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-brand-600"
            >
              Pilih semua
            </button>
          </div>

          <div class="relative mt-2">
            <Search class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-slate-400" />
            <label for="bulk-user-search" class="sr-only">Cari pengguna</label>
            <input
              id="bulk-user-search"
              type="search"
              data-bulk-user-search
              autocomplete="off"
              placeholder="Cari nama, email, atau jabatan"
              class="h-9 w-full rounded-lg border border-slate-300 bg-white pr-3 pl-9 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-2 focus:outline-brand-600 [&::-webkit-search-cancel-button]:appearance-none"
            />
          </div>

          <ul class="mt-2 divide-y divide-slate-100 rounded-lg border border-slate-200">
            {members.map((member) => {
              const row = counts.get(member.id);
              return (
                <li
                  data-bulk-user-item
                  data-search={`${member.name} ${member.email} ${member.jabatan}`.toLowerCase()}
                >
                  <label class="flex cursor-pointer items-center gap-3 px-3 py-2.5 transition-colors hover:bg-slate-50 has-[:checked]:bg-brand-50 max-sm:items-start">
                    <input
                      type="checkbox"
                      name="bulkUserIds"
                      value={member.id}
                      data-bulk-user
                      class="size-4 shrink-0 rounded border-slate-300 text-brand-600 focus:ring-brand-600 max-sm:mt-0.5"
                    />
                    <span class="min-w-0 flex-1">
                      <span class="flex items-start justify-between gap-2">
                        <span class="min-w-0 truncate text-sm text-slate-900">{member.name}</span>
                        {/* Di layar sempit hitungannya ikut baris nama — kolom kanan tidak muat. */}
                        <span class="shrink-0 text-xs text-slate-500 sm:hidden">
                          {row ? `${row.activity_count} aktivitas` : "Belum ada"}
                        </span>
                      </span>
                      <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1">
                        {member.jabatan ? (
                          <span class={jabatanBadge} title={`Posisi/Jabatan: ${member.jabatan}`}>
                            {member.jabatan}
                          </span>
                        ) : (
                          <span class={noJabatanBadge} title="Belum diisi di menu Pengguna">
                            Tanpa jabatan
                          </span>
                        )}
                        <span class="min-w-0 truncate text-xs text-slate-400">{member.email}</span>
                      </span>
                    </span>
                    <span class="hidden shrink-0 text-xs text-slate-500 sm:block">
                      {row ? `${row.activity_count} aktivitas` : "Belum ada"}
                    </span>
                  </label>
                </li>
              );
            })}
            <li data-bulk-user-empty hidden class="px-3 py-6 text-center">
              <p class="text-sm font-medium text-slate-900">Pengguna tidak ditemukan</p>
              <p class="mt-1 text-xs text-slate-500">Coba nama atau email lain.</p>
            </li>
          </ul>
        </section>
      </div>

      <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-end sm:px-6">
        <p data-bulk-hint class="text-xs text-slate-500 sm:mr-auto"></p>
        <div class="flex flex-col-reverse gap-2 sm:flex-row">
          <Button variant="outline" type="button" data-dialog-close>Batal</Button>
          <Button type="submit" disabled={members.length === 0}>
            <ClipboardCheck class="size-4" />
            Simpan
          </Button>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="clear-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-md" aria-labelledby="clear-title">
    {/* Wadah field — submit-nyahandled oleh Astro Action. */}
    <form method="POST" data-clear-form data-user-id={selected?.id ?? 0}>
      <div class="p-5 sm:p-6">
        <div class="flex items-start gap-3">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-red-50 text-red-600">
            <TriangleAlert class="size-5" />
          </span>
          <div class="min-w-0 flex-1">
            <h2 id="clear-title" class="text-base font-semibold text-slate-900">Hapus semua penugasan?</h2>
            <p class="mt-1.5 text-sm text-slate-600">
              {totalActivities} aktivitas milik{" "}
              <span class="font-medium text-slate-900">{selected?.name}</span> akan dilepas dari semua unit
              kerja.
            </p>
          </div>
        </div>
        <div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <Button variant="outline" type="button" data-dialog-close>
            Batal
          </Button>
          <Button variant="dangerSolid" type="submit">
            <Trash class="size-4" />
            Ya, hapus semua
          </Button>
        </div>
      </div>
    </form>
  </dialog>

  <DirectAssignDialog members={members} />
</DashboardLayout>

<script>
  import { actions } from "astro:actions";
  import { refreshPage, toast } from "../../scripts/dashboard.ts";

  // The router swaps the DOM but keeps this module, so the dialogs are wired again on
  // every astro:page-load.
  const init = () => {
    // The body is replaced on every navigation, so this marker is per page.
    if (document.body.dataset.assignWired) return;
    document.body.dataset.assignWired = "1";

    const assignDialog = document.getElementById("assign-dialog") as HTMLDialogElement | null;
    const bulkDialog = document.getElementById("bulk-dialog") as HTMLDialogElement | null;
    const clearDialog = document.getElementById("clear-dialog") as HTMLDialogElement | null;

    const open = (dialog: HTMLDialogElement | null) => {
      if (!dialog) return;
      dialog.showModal();
      document.documentElement.style.overflow = "hidden";
    };

    [assignDialog, bulkDialog, clearDialog].forEach((dialog) => {
      if (!dialog || dialog.dataset.assignWired) return;
      dialog.dataset.assignWired = "1";

      dialog.addEventListener("close", () => {
        document.documentElement.style.overflow = "";
      });
      // Backdrop click closes; clicks inside the panel do not.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.querySelectorAll<HTMLElement>("[data-dialog-close]").forEach((button) => {
        button.addEventListener("click", () => dialog.close());
      });
    });

    document.querySelector("[data-assign-open]")?.addEventListener("click", () => open(assignDialog));
    document.querySelector("[data-bulk-open]")?.addEventListener("click", () => open(bulkDialog));
    document.querySelector("[data-clear-open]")?.addEventListener("click", () => open(clearDialog));

    // Unit dropdown filters the catalog panels; the submit hint follows the selections.
    const form = document.querySelector<HTMLFormElement>("[data-assign-form]");
    const picker = document.querySelector<HTMLSelectElement>("[data-unit-picker]");
    const hint = document.querySelector<HTMLElement>("[data-dialog-hint]");
    const assignError = document.querySelector<HTMLElement>("[data-assign-error]");

    const syncPanels = () => {
      const unit = picker?.value;
      document.querySelectorAll<HTMLElement>("[data-unit-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.unitPanel !== unit;
      });
      if (!form || !hint) return;
      const checked = form.querySelectorAll<HTMLInputElement>('input[name="activityIds"]:checked').length;
      hint.textContent = checked === 0 ? "Belum ada aktivitas dipilih." : `${checked} aktivitas dipilih.`;
    };

    picker?.addEventListener("change", syncPanels);
    form?.addEventListener("change", syncPanels);
    syncPanels();

    // Tambah penugasan — Astro Action, jadi halamannya tidak dimuat ulang.
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const activityIds = [...form.querySelectorAll<HTMLInputElement>('input[name="activityIds"]:checked')].map(
        (box) => Number(box.value),
      );
      if (activityIds.length === 0) {
        if (assignError) {
          assignError.textContent = "Pilih minimal satu jenis aktivitas.";
          assignError.hidden = false;
        }
        return;
      }
      if (assignError) assignError.hidden = true;

      const { data, error } = await actions.assignActivities({
        userId: Number(form.dataset.userId ?? 0),
        activityIds,
      });
      if (error) {
        if (assignError) {
          assignError.textContent = error.message ?? "Penugasan gagal disimpan.";
          assignError.hidden = false;
        }
        return;
      }

      assignDialog?.close();
      await refreshPage();
      toast(
        data?.added === 1 ? "Aktivitas ditugaskan." : `${data?.added ?? 0} aktivitas ditugaskan.`,
      );
    });

    // Penugasan massal: pekerjaan dulu, lalu orangnya. Hitungan di footer ikut
    // berubah setiap centang; yang sudah terpasang dilewati oleh server.
    const bulkForm = document.querySelector<HTMLFormElement>("[data-bulk-form]");
    const bulkUnit = document.querySelector<HTMLSelectElement>("[data-bulk-unit]");
    const bulkHint = document.querySelector<HTMLElement>("[data-bulk-hint]");
    const bulkError = document.querySelector<HTMLElement>("[data-bulk-error]");
    const bulkUserSearch = document.querySelector<HTMLInputElement>("[data-bulk-user-search]");
    const bulkUserItems = [...document.querySelectorAll<HTMLElement>("[data-bulk-user-item]")];

    const bulkPicked = (name: "bulkActivityIds" | "bulkUserIds") => [
      ...(bulkForm?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`) ?? []),
    ];

    const syncBulk = () => {
      const unit = bulkUnit?.value;
      document.querySelectorAll<HTMLElement>("[data-bulk-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.bulkPanel !== unit;
      });

      // Tombol "centang semua" berubah jadi "Kosongkan" saat semua yang terlihat
      // sudah dicentang — supaya jelas klik berikutnya mengosongkan, bukan menambah.
      const allButton = document.querySelector<HTMLElement>("[data-bulk-user-all]");
      if (allButton) {
        const visibleBoxes = bulkUserItems
          .filter((item) => !item.hidden)
          .map((item) => item.querySelector<HTMLInputElement>("[data-bulk-user]"))
          .filter((box): box is HTMLInputElement => box !== null);
        const allChecked = visibleBoxes.length > 0 && visibleBoxes.every((box) => box.checked);
        allButton.textContent = allChecked ? "Kosongkan" : "Pilih semua";
      }

      const activityButton = document.querySelector<HTMLElement>("[data-bulk-activity-all]");
      if (activityButton) {
        const unitBoxes = [...document.querySelectorAll<HTMLInputElement>("[data-bulk-activity]")].filter(
          (box) => box.dataset.bulkActivity === unit,
        );
        const allChecked = unitBoxes.length > 0 && unitBoxes.every((box) => box.checked);
        activityButton.textContent = allChecked ? "Kosongkan unit ini" : "Centang semua unit ini";
      }

      const activities = bulkPicked("bulkActivityIds").length;
      const users = bulkPicked("bulkUserIds").length;
      if (bulkHint) {
        if (activities === 0 && users === 0) bulkHint.textContent = "Belum ada yang dipilih.";
        else if (activities === 0) bulkHint.textContent = "Pilih minimal satu jenis aktivitas.";
        else if (users === 0) bulkHint.textContent = "Pilih minimal satu pengguna.";
        else bulkHint.textContent = `${activities} aktivitas × ${users} pengguna = ${activities * users} penugasan.`;
      }
    };

    // Tombol "centang semua" bekerja pada yang terlihat: unit yang sedang dibuka /
    // pengguna yang lolos pencarian. Klik kedua mengosongkan lagi.
    const toggleAll = (boxes: HTMLInputElement[]) => {
      const target = !boxes.every((box) => box.checked);
      boxes.forEach((box) => (box.checked = target));
      syncBulk();
    };

    document.querySelector("[data-bulk-activity-all]")?.addEventListener("click", () => {
      const inUnit = [...document.querySelectorAll<HTMLInputElement>("[data-bulk-activity]")].filter(
        (box) => box.dataset.bulkActivity === bulkUnit?.value,
      );
      toggleAll(inUnit);
    });

    document.querySelector("[data-bulk-user-all]")?.addEventListener("click", () => {
      toggleAll(
        bulkUserItems
          .filter((item) => !item.hidden)
          .map((item) => item.querySelector<HTMLInputElement>("[data-bulk-user]"))
          .filter((box): box is HTMLInputElement => box !== null),
      );
    });

    bulkUserSearch?.addEventListener("input", () => {
      const query = bulkUserSearch.value.trim().toLowerCase();
      for (const item of bulkUserItems) {
        item.hidden = query !== "" && !(item.dataset.search ?? "").includes(query);
      }
      const empty = document.querySelector<HTMLElement>("[data-bulk-user-empty]");
      const visible = bulkUserItems.filter((item) => !item.hidden).length;
      if (empty) empty.hidden = visible > 0;
      const counter = document.querySelector<HTMLElement>("[data-bulk-user-count]");
      if (counter) {
        counter.textContent = query
          ? `${visible} dari ${bulkUserItems.length} pengguna`
          : `${bulkUserItems.length} pengguna level 1 & 2`;
      }
    });

    bulkUnit?.addEventListener("change", syncBulk);
    bulkForm?.addEventListener("change", syncBulk);
    syncBulk();

    // Dialog ditutup (Batal / Esc / simpan) → bersihkan pilihan, pencarian, dan error,
    // supaya buka berikutnya mulai dari nol.
    bulkDialog?.addEventListener("close", () => {
      bulkForm?.reset();
      if (bulkUserSearch) bulkUserSearch.value = "";
      bulkUserItems.forEach((item) => (item.hidden = false));
      const empty = document.querySelector<HTMLElement>("[data-bulk-user-empty]");
      if (empty) empty.hidden = true;
      const counter = document.querySelector<HTMLElement>("[data-bulk-user-count]");
      if (counter) counter.textContent = `${bulkUserItems.length} pengguna level 1 & 2`;
      if (bulkError) bulkError.hidden = true;
      syncBulk();
    });

    bulkForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const activityIds = bulkPicked("bulkActivityIds").map((box) => Number(box.value));
      const userIds = bulkPicked("bulkUserIds").map((box) => Number(box.value));

      const fail = (message: string) => {
        if (!bulkError) return;
        bulkError.textContent = message;
        bulkError.hidden = false;
      };
      if (activityIds.length === 0) return fail("Pilih minimal satu jenis aktivitas.");
      if (userIds.length === 0) return fail("Pilih minimal satu pengguna.");
      if (bulkError) bulkError.hidden = true;

      const submit = bulkForm.querySelector<HTMLButtonElement>("[type=submit]");
      if (submit) submit.disabled = true;
      const { data, error } = await actions.assignActivitiesToUsers({ userIds, activityIds });
      if (submit) submit.disabled = false;

      if (error) return fail(error.message ?? "Penugasan gagal disimpan.");

      bulkDialog?.close();
      await refreshPage();
      const added = data?.added ?? 0;
      const skipped = data?.skipped ?? 0;
      toast(
        skipped > 0
          ? `${added} penugasan baru, ${skipped} sudah ada sebelumnya.`
          : `${added} penugasan ditambahkan.`,
      );
    });

    // Hapus semua penugasan user ini.
    const clearForm = document.querySelector<HTMLFormElement>("[data-clear-form]");
    clearForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const { error } = await actions.clearAssignments({ userId: Number(clearForm.dataset.userId ?? 0) });
      if (error) {
        toast(error.message ?? "Penugasan gagal dihapus.", "error");
        return;
      }
      clearDialog?.close();
      await refreshPage();
      toast("Semua penugasan pengguna ini dihapus.");
    });

    // Lepas satu aktivitas dari user ini.
    document.querySelectorAll<HTMLButtonElement>("[data-remove-activity]").forEach((button) => {
      button.addEventListener("click", async () => {
        button.disabled = true;
        const { error } = await actions.removeActivity({
          userId: Number(button.dataset.userId ?? 0),
          activityId: Number(button.dataset.activityId ?? 0),
        });
        button.disabled = false;
        if (error) {
          toast(error.message ?? "Aktivitas gagal dilepas.", "error");
          return;
        }
        await refreshPage();
        toast("Aktivitas dilepas dari penugasan.");
      });
    });
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>

<script>
  // User search — filters the people list in place. No reload: the selected user's
  // panel on the right stays as it is, and the query never touches the URL.
  //
  // The router swaps the DOM but keeps this module, so the search is wired again on
  // every astro:page-load.
  const init = () => {
    const searchInput = document.querySelector<HTMLInputElement>("[data-user-search]");
    const searchClear = document.querySelector<HTMLButtonElement>("[data-user-search-clear]");
    const searchHint = document.querySelector<HTMLElement>("[data-user-search-hint]");
    const searchCount = document.querySelector<HTMLElement>("[data-user-count]");
    const searchEmpty = document.querySelector<HTMLElement>("[data-user-empty]");
    const userItems = [...document.querySelectorAll<HTMLElement>("[data-user-item]")];
    if (!searchInput || userItems.length === 0) return;

    /** Wraps the matched part of a label in <mark>. Text nodes only — a name is never
        turned into markup. */
    const highlight = (el: HTMLElement | null, query: string) => {
      if (!el) return;
      const text = el.textContent ?? "";
      el.replaceChildren();
      if (!query) {
        el.textContent = text;
        return;
      }
      const haystack = text.toLowerCase();
      let cursor = 0;
      let at = haystack.indexOf(query);
      while (at !== -1) {
        if (at > cursor) el.append(text.slice(cursor, at));
        const mark = document.createElement("mark");
        mark.textContent = text.slice(at, at + query.length);
        mark.className = "rounded bg-brand-100 px-0.5 text-brand-900";
        el.append(mark);
        cursor = at + query.length;
        at = haystack.indexOf(query, cursor);
      }
      el.append(text.slice(cursor));
    };

    const applyUserSearch = (raw: string) => {
      const query = raw.trim().toLowerCase();
      let visible = 0;

      for (const item of userItems) {
        const match = !query || (item.dataset.search ?? "").includes(query);
        item.hidden = !match;
        // Hidden rows are reset too, so no stale highlight is left behind.
        highlight(item.querySelector<HTMLElement>("[data-user-name]"), match ? query : "");
        highlight(item.querySelector<HTMLElement>("[data-user-email]"), match ? query : "");
        highlight(item.querySelector<HTMLElement>("[data-user-jabatan]"), match ? query : "");
        if (match) visible++;
      }

      if (searchCount) {
        searchCount.textContent = query
          ? `${visible} dari ${userItems.length} pengguna`
          : `${userItems.length} pengguna`;
      }
      if (searchEmpty) searchEmpty.hidden = !query || visible > 0;
      if (searchClear) searchClear.hidden = raw.length === 0;
      if (searchHint) searchHint.hidden = raw.length > 0;
    };

    searchInput.addEventListener("input", () => applyUserSearch(searchInput.value));

    searchInput.addEventListener("keydown", (event) => {
      // Esc clears the query and keeps the caret in the field.
      if (event.key === "Escape" && searchInput.value) {
        event.preventDefault();
        searchInput.value = "";
        applyUserSearch("");
        return;
      }
      // Enter jumps to the first person still on screen.
      if (event.key === "Enter") {
        userItems.find((item) => !item.hidden)?.querySelector<HTMLAnchorElement>("a")?.focus();
      }
    });

    document.querySelectorAll<HTMLElement>("[data-user-search-clear], [data-user-search-reset]").forEach((button) => {
      button.addEventListener("click", () => {
        searchInput.value = "";
        applyUserSearch("");
        searchInput.focus();
      });
    });

    // "/" focuses the search from anywhere on the page, unless the caret is already in a field.
    const onShortcut = (event: KeyboardEvent) => {
      if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      const tag = target?.tagName;
      if (target?.isContentEditable || tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT") return;
      event.preventDefault();
      searchInput.focus();
    };
    // The listener lives on the document, so it is attached only once.
    if (!document.body.dataset.assignSearchWired) {
      document.body.dataset.assignSearchWired = "1";
      document.addEventListener("keydown", onShortcut);
    }

    applyUserSearch("");
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  /* The divider follows the last visible row, so filtering never leaves a stray line.
     shortcut: needs :has() (2023+ browsers) — without it only the trailing hairline
     is off; drop this rule if the browser floor ever goes lower. */
  [data-user-item]:not(:has(~ li:not([hidden]))) {
    border-bottom-width: 0;
  }
</style>
