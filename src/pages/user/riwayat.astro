---
// Riwayat — catatan kemunculan yang sudah lewat: yang diselesaikan, yang diselesaikan
// terlambat, dan yang tidak sempat dikerjakan. Filter status lewat GET biasa, jadi
// halamannya tetap jalan tanpa JavaScript.
//
// Dua aksi lain berlaku di sini: membatalkan tanda selesai (barisnya kembali jadi
// "terlewat" atau muncul lagi di dashboard), dan menyunting catatan & tautan.
import { CalendarRange, CircleCheck, Inbox, TriangleAlert, Undo2 } from "@lucide/astro";
import NoteDialog from "../../components/user/NoteDialog.astro";
import TaskNote from "../../components/user/TaskNote.astro";
import Button from "../../components/ui/Button.astro";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { requireUser } from "../../lib/auth";
import { findCategory } from "../../lib/categories";
import { listHistory, materializeOverdue, setOccurrenceNote, undoOccurrence } from "../../lib/db";
import { formatDateTime, formatPeriod } from "../../lib/format";
import { parseNote } from "../../lib/notes";

const session = await requireUser(Astro);
if (session instanceof Response) return session;

const userId = Number(session.user!.id);
if (!Number.isInteger(userId)) return Astro.redirect("/login?error=SessionRequired");

const filter = Astro.url.searchParams.get("status");
const status = filter === "selesai" || filter === "terlewat" ? filter : undefined;

// Kemunculan yang lagi disunting catatannya — dialognya dirender terbuka.
let editingId = 0;
let editingPeriod = "";
let editingNote = "";
let editingLink = "";
let noteError: string | undefined;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  const activityId = Number(form.get("activityId"));
  const periodKey = String(form.get("periodKey") ?? "");

  if (Number.isInteger(activityId) && periodKey) {
    if (action === "undo") {
      const undone = undoOccurrence(userId, activityId, periodKey);
      if (undone) {
        // Filter statusnya dipertahankan —undo tidak boleh membuat daftar terasa kosong.
        const query = new URLSearchParams();
        if (filter) query.set("status", filter);
        query.set("undone", undone);
        return Astro.redirect(`/user/riwayat?${query}`);
      }
    } else if (action === "note") {
      const parsed = parseNote(form);
      if ("error" in parsed) {
        // Halaman dirender ulang dengan dialog terbuka dan pesan errornya.
        noteError = parsed.error;
        editingId = activityId;
        editingPeriod = periodKey;
        editingNote = String(form.get("note") ?? "");
        editingLink = String(form.get("link") ?? "");
      } else {
        const removed = setOccurrenceNote(
          userId,
          activityId,
          periodKey,
          parsed.value.note,
          parsed.value.link,
        );
        return Astro.redirect(`/user/riwayat?${removed ? "cleared" : "noted"}=1`);
      }
    }
  }
  if (!noteError) return Astro.redirect("/user/riwayat");
}

// Periode yang lewat tanpa penyelesaian dicatat lebih dulu, biar riwayatnya lengkap.
materializeOverdue(userId);
const history = listHistory(userId, status);

if (!editingId) {
  editingId = Number(Astro.url.searchParams.get("note") ?? 0) || 0;
  editingPeriod = Astro.url.searchParams.get("period") ?? "";
}
const editingTarget = history.find(
  (row) => row.activity_id === editingId && row.period_key === editingPeriod,
);
const editing = editingTarget
  ? {
      activityId: editingTarget.activity_id,
      periodKey: editingTarget.period_key,
      name: editingTarget.name,
      note: editingNote || editingTarget.note,
      link: editingLink || editingTarget.link,
    }
  : undefined;

const tabs = [
  { value: undefined, label: "Semua" },
  { value: "selesai" as const, label: "Selesai" },
  { value: "terlewat" as const, label: "Terlewat" },
];

const firstName = (session.user?.name ?? "Pengguna").split(" ")[0];
const undone = Astro.url.searchParams.get("undone");
const noted = Astro.url.searchParams.has("noted");
const cleared = Astro.url.searchParams.has("cleared");
---

<DashboardLayout title="Riwayat" user={session.user}>
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Riwayat tugas</h1>
    <p class="mt-1 text-sm text-slate-500">
      Catatan kemunculan tugas {firstName} — yang selesai, yang terlambat, dan yang terlewat.
    </p>
  </div>

  <nav class="mt-6 flex flex-wrap gap-1 rounded-xl border border-slate-200 bg-white p-1" aria-label="Filter status">
    {
      tabs.map((tab) => (
        <a
          href={tab.value ? `/user/riwayat?status=${tab.value}` : "/user/riwayat"}
          aria-current={status === tab.value ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600",
            status === tab.value
              ? "bg-brand-50 text-brand-700"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-900",
          ]}
        >
          {tab.label}
        </a>
      ))
    }
  </nav>

  {
    undone && (
      <p
        data-notice
        data-notice-params="undone"
        class="notice mt-6 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700"
        role="status"
      >
        {undone === "terlewat"
          ? "Tanda selesai dibatalkan — kemunculan itu kembali tercatat sebagai terlewat."
          : "Tanda selesai dibatalkan — tugasnya kembali terbuka."}
      </p>
    )
  }
  {
    noted && (
      <p
        data-notice
        data-notice-params="noted"
        class="notice mt-6 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700"
        role="status"
      >
        Catatan tersimpan.
      </p>
    )
  }
  {
    cleared && (
      <p
        data-notice
        data-notice-params="cleared"
        class="notice mt-6 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700"
        role="status"
      >
        Catatan dihapus.
      </p>
    )
  }

  {
    history.length === 0 ? (
      <div class="mt-4 flex flex-col items-center gap-2 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
        <Inbox class="size-8 text-slate-300" />
        <p class="text-sm font-medium text-slate-900">Belum ada riwayat</p>
        <p class="max-w-sm text-sm text-slate-500">
          Riwayat terisi begitu tugas Anda selesai atau lewat periodenya.
        </p>
      </div>
    ) : (
      <ul class="mt-4 space-y-2">
        {history.map((row) => {
          const category = findCategory(row.category_id);
          const UnitIcon = category?.icon ?? Inbox;
          return (
            <li
              class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4"
              data-task
              data-reveal="fade"
              data-name={row.name}
              data-activity-id={row.activity_id}
              data-period-key={row.period_key}
            >
              <span
                class:list={[
                  "grid size-9 shrink-0 place-items-center rounded-full",
                  row.status === "terlewat"
                    ? "bg-red-50 text-red-600"
                    : row.late
                      ? "bg-amber-50 text-amber-600"
                      : "bg-emerald-50 text-emerald-600",
                ]}
              >
                {row.status === "terlewat" ? (
                  <TriangleAlert class="size-4" />
                ) : (
                  <CircleCheck class="size-4" />
                )}
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-slate-900">{row.name}</p>
                <p class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-500">
                  <span class="inline-flex items-center gap-1">
                    <UnitIcon class="size-3.5" />
                    {category?.label ?? row.category_id}
                  </span>
                  <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">{row.periode}</span>
                  <span class="inline-flex items-center gap-1">
                    <CalendarRange class="size-3.5" />
                    {formatPeriod(row.periode, row.period_key)}
                  </span>
                </p>
                {row.completed_at && (
                  <p class="mt-1 text-xs text-slate-400">Selesai {formatDateTime(row.completed_at)}</p>
                )}

                <TaskNote
                  activityId={row.activity_id}
                  periodKey={row.period_key}
                  name={row.name}
                  note={row.note}
                  link={row.link}
                  noteHref={`/user/riwayat?note=${row.activity_id}&period=${encodeURIComponent(row.period_key)}`}
                />
              </div>

              <div class="flex shrink-0 flex-col items-end gap-2">
                <span
                  class:list={[
                    "rounded-full px-2 py-0.5 text-xs font-medium",
                    row.status === "terlewat"
                      ? "bg-red-50 text-red-700"
                      : row.late
                        ? "bg-amber-50 text-amber-700"
                        : "bg-emerald-50 text-emerald-700",
                  ]}
                >
                  {row.status === "terlewat" ? "Terlewat" : row.late ? "Terlambat" : "Selesai"}
                </span>

                {row.status === "selesai" && (
                  <form method="POST">
                    <input type="hidden" name="activityId" value={row.activity_id} />
                    <input type="hidden" name="periodKey" value={row.period_key} />
                    <Button variant="ghost" size="sm" type="submit" name="action" value="undo">
                      <Undo2 class="size-3.5" />
                      Batalkan
                    </Button>
                  </form>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )
  }

  <NoteDialog occurrence={editing} error={noteError} />
</DashboardLayout>

<script>
  import "../../scripts/notices.ts";
</script>
