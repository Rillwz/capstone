---
// Lupa kata sandi — dua langkah, tanpa token dan tanpa email: permintaan dicatat,
// lalu admin menjalankannya di /dashboard/permintaan-reset. Halaman ini hanya
// mengumpulkan email dan mengonfirmasi, karena admin tetap yang memegang sandi.
import { ArrowLeft, InformationCircle, LockClosed } from "../lib/icons";
import Layout from "../layouts/Layout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import Button from "../components/ui/Button.astro";
import Input from "../components/ui/Input.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import { createPasswordResetRequest } from "../lib/db";

const EMAIL_MAX = 200;
// Email login disimpan lowercase, jadi bandingkan dalam bentuk yang sama.
const normalize = (value: string) => value.trim().toLowerCase();

// "form" = isi email, "confirm" = panel "ya/kembali", "sent" = selesai.
let step: "form" | "confirm" | "sent" = Astro.url.searchParams.has("terkirim") ? "sent" : "form";
let email = normalize(Astro.url.searchParams.get("email") ?? "");
let error: string | undefined;

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  const action = String(data.get("action") ?? "");
  const input = normalize(String(data.get("email") ?? "")).slice(0, EMAIL_MAX);
  email = input;

  if (action === "ubah") {
    // "Ubah email" kembali ke langkah 1 dengan isian sebelumnya.
    step = "form";
  } else if (!input) {
    error = "Email wajib diisi.";
  } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input)) {
    error = "Format email tidak valid.";
  } else if (action === "konfirmasi") {
    // Hasilnya sengaja tidak ditampilkan: email yang tidak terdaftar dan email yang
    // sudah punya permintaan menunggu mendapat layar sukses yang sama, jadi halaman
    // ini tidak bisa dipakai menebak akun mana yang ada.
    createPasswordResetRequest(input);
    return Astro.redirect("/lupa-sandi?terkirim=1");
  } else {
    step = "confirm";
  }
}
---

<Layout title="Lupa kata sandi">
  <div class="fixed right-4 top-4 z-20">
    <ThemeToggle />
  </div>

  <main class="flex min-h-dvh">
    <section class="hidden lg:flex lg:w-[45%] xl:w-1/2 flex-col justify-between bg-brand-950 p-12 text-oninverse">
      <a href="/" class="flex items-center gap-2.5 text-lg font-semibold">
        <BrandLogo name="Assignment" />
      </a>

      <div class="max-w-md">
        <h2 class="text-3xl font-semibold leading-tight tracking-tight">
          <BrandLogo name="Assignment" logo={false} />
        </h2>
        <p class="mt-4 text-base leading-relaxed text-brand-200">
          Kata sandi tidak dikirim lewat email. Permintaan Anda masuk ke administrator, yang akan
          mengatur ulang sandi lalu menyampaikannya kepada Anda.
        </p>
      </div>

      <p class="text-sm text-brand-300">© 2026 Capstone Project</p>
    </section>

    <section class="flex min-w-0 flex-1 items-center justify-center px-5 py-12 sm:px-8">
      <div class="w-full max-w-sm">
        {
          step === "sent" ? (
            <>
              <span class="grid size-11 place-items-center rounded-xl bg-emerald-50 text-emerald-600">
                <InformationCircle class="size-5" />
              </span>
              <h1 class="mt-4 text-2xl font-semibold tracking-tight text-slate-900">Permintaan terkirim</h1>
              <p class="mt-2 text-sm text-slate-500">
                Administrator akan mengatur ulang kata sandi akun Anda dan menyampaikannya secara
                langsung. Setelah masuk, segera ganti sandi lewat halaman Profil.
              </p>
              <Button href="/login" size="lg" class="mt-8 w-full">
                Kembali ke halaman masuk
              </Button>
            </>
          ) : (
            <>
              <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Lupa kata sandi</h1>
              <p class="mt-2 text-sm text-slate-500">
                {step === "confirm"
                  ? "Periksa kembali email akun Anda sebelum mengirim permintaan."
                  : "Masukkan email akun Anda. Permintaan akan diteruskan ke administrator."}
              </p>

              {
                step === "confirm" ? (
                  <form method="POST" class="mt-6 space-y-5">
                    <input type="hidden" name="email" value={email} />
                    <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3">
                      <p class="text-xs font-medium tracking-wide text-slate-500 uppercase">Email akun</p>
                      <p class="mt-1 truncate text-sm font-medium text-slate-900" title={email}>
                        {email}
                      </p>
                    </div>
                    <div class="flex flex-col-reverse gap-2 sm:flex-row">
                      <Button
                        variant="outline"
                        size="lg"
                        type="submit"
                        name="action"
                        value="ubah"
                        class="sm:flex-1"
                      >
                        <ArrowLeft class="size-4" />
                        Ubah email
                      </Button>
                      <Button size="lg" type="submit" name="action" value="konfirmasi" class="sm:flex-1">
                        Ya, ajukan
                      </Button>
                    </div>
                  </form>
                ) : (
                  <form method="POST" class="mt-6 space-y-5">
                    <input type="hidden" name="action" value="lanjut" />
                    <Input
                      label="Email"
                      name="email"
                      type="email"
                      value={email}
                      error={error}
                      required
                    />
                    <Button size="lg" class="w-full">Lanjutkan</Button>
                  </form>
                )
              }

              <a
                href="/login"
                class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900"
              >
                <ArrowLeft class="size-4" />
                Kembali ke halaman masuk
              </a>

              <p class="mt-6 inline-flex items-start gap-1.5 text-xs text-slate-500">
                <LockClosed class="mt-0.5 size-3.5 shrink-0 text-slate-400" />
                Demi keamanan, halaman ini tidak memberi tahu apakah sebuah email terdaftar.
              </p>
            </>
          )
        }
      </div>
    </section>
  </main>
</Layout>
