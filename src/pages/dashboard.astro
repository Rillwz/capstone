---
// Admin dashboard — overview only. The post list lives at /dashboard/posts.
//
// The page answers one question first: what needs the admin's attention today? The
// attention strip is built from real gaps (pending resets, accounts with no work,
// activities nobody carries), then the metrics, then the detail lists.
import {
  ArrowTrendingUp,
  ChevronRight,
  ClipboardDocumentList,
  ExclamationTriangle,
  Key,
  PencilSquare,
  UserMinus,
  UserPlus,
  Users,
  Tag,
} from "../lib/icons";
import StatCard from "../components/ui/StatCard.astro";
import BarChart from "../components/ui/BarChart.astro";
import Button from "../components/ui/Button.astro";
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { requireAdmin } from "../lib/auth";
import {
  countPendingPasswordResets,
  getStats,
  listCategoryCoverage,
  listPosts,
  listRecentLogins,
  loginTrend,
} from "../lib/db";
import { describeDevice, formatDate, formatDateTime } from "../lib/format";
import { todayIso } from "../lib/tasks";

const session = await requireAdmin(Astro);
if (session instanceof Response) return session;

const stats = getStats();
const posts = listPosts(5);
const logins = listRecentLogins(6);
const coverage = listCategoryCoverage();
const pendingResets = countPendingPasswordResets();

const firstName = (session.user?.name ?? "Admin").split(" ")[0];
const todayLong = new Date(`${todayIso()}T00:00:00Z`).toLocaleDateString("id-ID", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Jakarta",
});

// Unassigned activity types: the coverage gap the admin can actually close.
const unassigned = stats.activities - stats.assignedActivities;
const coverageRatio = stats.activities > 0 ? Math.round((stats.assignedActivities / stats.activities) * 100) : 0;

// Only the gaps that exist, so the strip never shows an empty "needs attention".
const attention = [
  pendingResets > 0 && {
    href: "/dashboard/permintaan-reset",
    icon: Key,
    title: `${pendingResets} permintaan reset kata sandi`,
    detail: "Menunggu ditangani",
    tone: "warn" as const,
  },
  stats.usersWithoutAssignments > 0 && {
    href: "/dashboard/assignments",
    icon: UserMinus,
    title: `${stats.usersWithoutAssignments} akun belum punya penugasan`,
    detail: "Ruang kerja mereka kosong",
    tone: "warn" as const,
  },
  unassigned > 0 && {
    href: "/dashboard/assignments",
    icon: ClipboardDocumentList,
    title: `${unassigned} jenis aktivitas belum ditugaskan`,
    detail: `Dari ${stats.activities} aktivitas di ${stats.categories} unit kerja`,
    tone: "info" as const,
  },
].filter(Boolean) as Array<{
  href: string;
  icon: typeof Key;
  title: string;
  detail: string;
  tone: "warn" | "info";
}>;

const trend = loginTrend(7).map((day) => ({
  label: new Date(`${day.date}T00:00:00Z`).toLocaleDateString("id-ID", {
    weekday: "short",
    timeZone: "Asia/Jakarta",
  }),
  value: day.count,
  title: `${formatDate(day.date)} · ${day.count} login`,
}));
const trendTotal = trend.reduce((sum, day) => sum + day.value, 0);

const attentionTone = {
  warn: "border-amber-200 bg-amber-50/60 text-amber-700",
  info: "border-slate-200 bg-slate-50 text-slate-600",
} as const;
---

<DashboardLayout title="Dashboard" user={session.user}>
  <div class="flex flex-wrap items-end justify-between gap-3" data-reveal="up">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">Halo, {firstName}</h1>
      <p class="mt-1 text-sm text-slate-500">{todayLong}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <Button variant="outline" href="/dashboard/users"><UserPlus class="size-4" />Tambah pengguna</Button>
      <Button href="/dashboard/posts/new"><PencilSquare class="size-4" />Tulis postingan</Button>
    </div>
  </div>

  {
    attention.length > 0 && (
      <section class="mt-6" aria-labelledby="attention-title" data-reveal="up">
        <h2 id="attention-title" class="flex items-center gap-2 text-sm font-semibold text-slate-900">
          <ExclamationTriangle class="size-4 text-amber-600" />
          Perlu perhatian
        </h2>
        <ul class="mt-2 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {attention.map(({ href, icon: Icon, title, detail, tone }) => (
            <li class="min-w-0" data-reveal="fade">
              <a
                href={href}
                data-lift
                class:list={[
                  "group flex h-full items-center gap-3 rounded-xl border px-4 py-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600",
                  attentionTone[tone],
                ]}
              >
                <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-white/70 ring-1 ring-current/10">
                  <Icon class="size-4" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium">{title}</span>
                  <span class="mt-0.5 block text-xs opacity-80">{detail}</span>
                </span>
                <ChevronRight class="size-4 shrink-0 opacity-50 transition-transform group-hover:translate-x-0.5" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <StatCard
      label="Pengguna"
      value={stats.users}
      href="/dashboard/users"
      hint={`${stats.admins} admin · ${stats.level1} level 1 · ${stats.level2} level 2`}
    >
      <Users slot="icon" class="size-5" />
    </StatCard>

    <StatCard
      label="Aktivitas"
      value={stats.activities}
      href="/dashboard/categories"
      hint={`${stats.assignedActivities} ditugaskan · ${unassigned} belum`}
      meter={{
        value: stats.assignedActivities,
        max: stats.activities,
        label: `${coverageRatio}% aktivitas sudah ditugaskan`,
      }}
    >
      <ClipboardDocumentList slot="icon" class="size-5" />
    </StatCard>

    <StatCard
      label="Unit kerja"
      value={stats.categories}
      href="/dashboard/categories"
      hint="Kategori aktif"
    >
      <Tag slot="icon" class="size-5" />
    </StatCard>

    <StatCard
      label="Login (24 jam)"
      value={stats.logins24h}
      hint={stats.neverLoggedIn > 0 ? `${stats.neverLoggedIn} akun belum pernah masuk` : "Semua akun pernah masuk"}
    >
      <ArrowTrendingUp slot="icon" class="size-5" />
    </StatCard>
  </div>

  <div class="mt-6 grid items-start gap-6 lg:grid-cols-[1fr_22rem]">
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white" data-reveal="up">
      <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="text-sm font-semibold text-slate-900">Cakupan per unit kerja</h2>
          <p class="mt-0.5 text-xs text-slate-500">
            {coverageRatio}% dari {stats.activities} jenis aktivitas sudah dipegang seseorang.
          </p>
        </div>
        <a href="/dashboard/categories" class="text-sm font-medium text-brand-600 hover:text-brand-700">Kelola</a>
      </header>

      {
        coverage.length === 0 ? (
          <p class="px-5 py-8 text-sm text-slate-500">Belum ada unit kerja.</p>
        ) : (
          <ul class="divide-y divide-slate-100">
            {coverage.map((unit) => {
              const ratio = unit.activities > 0 ? unit.assigned / unit.activities : 0;
              return (
                <li data-reveal="fade">
                  <a
                    href={`/dashboard/categories/${unit.id}`}
                    class="group flex items-center gap-4 px-5 py-3 transition-colors hover:bg-slate-50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-600"
                  >
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-sm font-medium text-slate-900 group-hover:text-brand-700">
                        {unit.label}
                      </span>
                      <span class="mt-0.5 block text-xs text-slate-500 tabular-nums">
                        {unit.activities} aktivitas · {unit.people} orang
                      </span>
                    </span>
                    <span class="flex w-32 shrink-0 items-center gap-2 sm:w-44">
                      <span
                        class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200"
                        role="img"
                        aria-label={`${unit.assigned} dari ${unit.activities} aktivitas ditugaskan`}
                      >
                        <span
                          class:list={[
                            "block h-full rounded-full",
                            ratio === 1 ? "bg-emerald-600" : ratio > 0 ? "bg-brand-600" : "bg-slate-300",
                          ]}
                          style={`width: ${Math.round(ratio * 100)}%`}
                        />
                      </span>
                      <span class="w-10 shrink-0 text-right text-xs text-slate-500 tabular-nums">
                        {unit.assigned}/{unit.activities}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    <div class="grid gap-6">
      <section class="rounded-xl border border-slate-200 bg-white p-5" data-reveal="up">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="text-sm font-semibold text-slate-900">Login 7 hari</h2>
          <p class="text-xs text-slate-500 tabular-nums">{trendTotal} masuk</p>
        </div>
        <BarChart label="Login berhasil per hari, 7 hari terakhir" values={trend} class="mt-4" />

        <div class="mt-5 border-t border-slate-200 pt-4">
          <h3 class="text-xs font-medium uppercase tracking-wider text-slate-500">Aktivitas masuk</h3>
          {
            logins.length === 0 ? (
              <p class="mt-2 text-sm text-slate-500">Belum ada riwayat login.</p>
            ) : (
              <ul class="mt-2 space-y-3">
                {logins.slice(0, 4).map((log) => (
                  <li class="flex items-start gap-2.5" data-reveal="fade">
                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand-400" aria-hidden="true" />
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-sm font-medium text-slate-900">{log.name}</span>
                      <span class="block truncate text-xs text-slate-500">
                        {describeDevice(log.user_agent)} · {formatDateTime(log.created_at)}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
          <a
            href="/dashboard/users"
            class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-600 hover:text-brand-700"
          >
            Lihat pengguna
            <ChevronRight class="size-4" />
          </a>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white" data-reveal="up">
        <header class="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
          <h2 class="text-sm font-semibold text-slate-900">Postingan terbaru</h2>
          <a href="/dashboard/posts" class="text-sm font-medium text-brand-600 hover:text-brand-700">Semua</a>
        </header>

        {
          posts.length === 0 ? (
            <div class="px-5 py-6">
              <p class="text-sm text-slate-500">Belum ada postingan.</p>
              <Button variant="outline" size="sm" href="/dashboard/posts/new" class="mt-3">
                <PencilSquare class="size-4" />Tulis yang pertama
              </Button>
            </div>
          ) : (
            <ul class="divide-y divide-slate-100">
              {posts.map((post) => (
                <li data-reveal="fade">
                  <a href={`/dashboard/posts/${post.id}`} class="group flex items-center gap-3 px-5 py-3">
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-sm font-medium text-slate-900 group-hover:text-brand-700">
                        {post.title}
                      </span>
                      <span class="mt-0.5 block truncate text-xs text-slate-500">
                        {post.author_name} · {formatDateTime(post.created_at)}
                      </span>
                    </span>
                    <ChevronRight class="size-4 shrink-0 text-slate-300 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-600" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </div>
  </div>
</DashboardLayout>
