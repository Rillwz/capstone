---
// Ruang kerja level 1 & 2 — penugasan yang dipegang user, dikelompokkan per periode.
//
// Tiap penugasan menjadi kemunculan (occurrence) per periode; kemunculan periode
// berjalan ada di sini, dan periode yang lewat tanpa centang dicatat sebagai "terlewat"
// oleh materializeOverdue() (dijalankan sebelum halaman ini dirender).
import { CalendarCheck, CircleCheck, Inbox, TriangleAlert } from "@lucide/astro";
import TaskCard from "../components/user/TaskCard.astro";
import Button from "../components/ui/Button.astro";
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { requireUser } from "../lib/auth";
import { findCategory } from "../lib/categories";
import {
  completeOccurrence,
  countCompletedBetween,
  listMissedTasks,
  listUserOccurrences,
  materializeOverdue,
  undoOccurrence,
} from "../lib/db";
import { formatDate } from "../lib/format";
import { daysBetween, todayIso } from "../lib/tasks";

const session = await requireUser(Astro);
if (session instanceof Response) return session;

const userId = Number(session.user!.id);
if (!Number.isInteger(userId)) return Astro.redirect("/login?error=SessionRequired");

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  const activityId = Number(form.get("activityId"));
  const periodKey = String(form.get("periodKey") ?? "");

  if (Number.isInteger(activityId) && periodKey) {
    if (action === "complete") {
      const result = completeOccurrence(userId, activityId, periodKey);
      if (result !== "invalid") {
        return Astro.redirect(`/user?${result === "terlambat" ? "late" : "done"}=1`);
      }
    } else if (action === "undo") {
      if (undoOccurrence(userId, activityId, periodKey)) return Astro.redirect("/user?undone=1");
    }
  }
  return Astro.redirect("/user");
}

const today = todayIso();

// Catat dulu periode yang lewat tanpa penyelesaian, baru baca kemunculan periode berjalan.
materializeOverdue(userId);
const occurrences = listUserOccurrences(userId);
const missed = listMissedTasks(userId);

const groups = [
  { id: "hari-ini", title: "Hari ini", items: occurrences.filter((item) => item.due === today) },
  {
    id: "minggu-ini",
    title: "Minggu ini",
    items: occurrences.filter((item) => item.periode === "Mingguan" && item.due !== today),
  },
  {
    id: "bulan-ini",
    title: "Bulan ini",
    items: occurrences.filter((item) => item.periode === "Bulanan" && item.due !== today),
  },
  {
    id: "semester-ini",
    title: "Semester ini",
    items: occurrences.filter((item) => item.periode === "Semesteran" && item.due !== today),
  },
].filter((group) => group.items.length > 0);

const todayItems = groups.find((group) => group.id === "hari-ini")?.items ?? [];
const doneToday = todayItems.filter((item) => item.status === "selesai").length;
const missedCount = missed.reduce((sum, item) => sum + item.count, 0);
const doneThisMonth = countCompletedBetween(userId, `${today.slice(0, 7)}-01`, today);

const firstName = (session.user?.name ?? "Pengguna").split(" ")[0];
const todayLong = new Date(`${today}T00:00:00Z`).toLocaleDateString("id-ID", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Jakarta",
});

const stats = [
  { label: "Selesai hari ini", value: `${doneToday}/${todayItems.length}`, icon: CalendarCheck },
  { label: "Terlewat", value: missedCount, icon: TriangleAlert },
  { label: "Selesai bulan ini", value: doneThisMonth, icon: CircleCheck },
];

/** "Jatuh tempo hari ini" / "Jatuh tempo 25 Okt 2026" (+ keterlambatan). */
const dueText = (due: string) => {
  if (due === today) return "Jatuh tempo hari ini";
  const late = daysBetween(due, today);
  return `Jatuh tempo ${formatDate(due)}${late > 0 ? ` · terlambat ${late} hari` : ""}`;
};

const done = Astro.url.searchParams.has("done");
const late = Astro.url.searchParams.has("late");
const undone = Astro.url.searchParams.has("undone");
---

<DashboardLayout title="Dashboard" user={session.user}>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-xl font-semibold text-slate-900">Halo, {firstName}</h1>
      <p class="mt-1 text-sm text-slate-500">
        {todayLong} · {occurrences.length} tugas aktif.
      </p>
    </div>
  </div>

  {
    done && (
      <p
        data-notice
        data-notice-params="done"
        class="notice mt-6 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-700"
        role="status"
      >
        Tugas ditandai selesai.
      </p>
    )
  }
  {
    late && (
      <p
        data-notice
        data-notice-params="late"
        class="notice mt-6 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-700"
        role="status"
      >
        Tugas diselesaikan terlambat — tercatat di riwayat.
      </p>
    )
  }
  {
    undone && (
      <p
        data-notice
        data-notice-params="undone"
        class="notice mt-6 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-700"
        role="status"
      >
        Tanda selesai dibatalkan.
      </p>
    )
  }

  {
    occurrences.length > 0 && (
      <div class="mt-5 grid grid-cols-3 gap-2 sm:mt-6 sm:gap-3">
        {stats.map(({ label, value, icon: Icon }) => (
          <div class="rounded-xl border border-slate-200 bg-white p-3 sm:p-5">
            <span class="grid size-8 place-items-center rounded-lg bg-brand-50 text-brand-600 sm:size-9">
              <Icon class="size-4 sm:size-5" />
            </span>
            <p class="mt-2 text-xl font-semibold tracking-tight text-slate-900 sm:text-2xl">{value}</p>
            <p class="mt-0.5 text-xs leading-tight text-slate-500 sm:text-sm">{label}</p>
          </div>
        ))}
      </div>
    )
  }

  {
    missed.length > 0 && (
      <section class="mt-8">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-red-700">Terlewat</h2>
          <p class="text-xs text-slate-500">{missedCount} kemunculan</p>
        </div>
        <p class="mt-1 text-xs text-slate-500">
          Periode yang sudah lewat tanpa diselesaikan. Masih bisa diselesaikan — akan tercatat
          sebagai terlambat.
        </p>
        <ul class="mt-3 space-y-2">
          {missed.map((item) => {
            const category = findCategory(item.category_id);
            const UnitIcon = category?.icon ?? Inbox;
            return (
              <li class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50/70 p-4">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-red-100 text-red-600">
                  <TriangleAlert class="size-4" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium text-slate-900">{item.name}</p>
                  <p class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-600">
                    <span class="inline-flex items-center gap-1">
                      <UnitIcon class="size-3.5" />
                      {category?.label ?? item.category_id}
                    </span>
                    <span class="rounded-full bg-white px-2 py-0.5 text-slate-600">{item.periode}</span>
                    <span>
                      terlewat {item.count}× · terakhir {formatDate(item.last_due)}
                    </span>
                  </p>
                </div>
                <form method="POST" class="shrink-0">
                  <input type="hidden" name="activityId" value={item.activity_id} />
                  <input type="hidden" name="periodKey" value={item.last_key} />
                  <Button variant="outline" size="sm" name="action" value="complete">
                    Selesaikan
                  </Button>
                </form>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    groups.map((group) => (
      <section class="mt-8">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-sm font-semibold text-slate-900">{group.title}</h2>
          <p class="text-xs text-slate-500">
            {group.items.filter((item) => item.status === "selesai").length}/{group.items.length} selesai
          </p>
        </div>
        <ul class="mt-3 space-y-2">
          {group.items.map((item) => {
            const category = findCategory(item.category_id);
            return (
              <TaskCard
                name={item.name}
                unitLabel={category?.label ?? item.category_id}
                unitIcon={category?.icon ?? Inbox}
                periode={item.periode}
                dueText={dueText(item.due)}
                periodKey={item.period_key}
                activityId={item.activity_id}
                done={item.status === "selesai"}
                late={item.late}
              />
            );
          })}
        </ul>
      </section>
    ))
  }

  {
    occurrences.length === 0 && (
      <div class="mt-6 flex flex-col items-center gap-2 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
        <Inbox class="size-8 text-slate-300" />
        <p class="text-sm font-medium text-slate-900">Belum ada penugasan</p>
        <p class="max-w-sm text-sm text-slate-500">
          Admin belum memberi tugas pada akun Anda. Hubungi admin bila ini tidak sesuai.
        </p>
      </div>
    )
  }
</DashboardLayout>

<script>
  import "../scripts/notices.ts";
</script>
