---
// Ruang kerja level 1 & 2 — penugasan yang dipegang user, dikelompokkan per periode.
//
// Tiap penugasan menjadi kemunculan (occurrence) per periode; kemunculan periode
// berjalan ada di sini, dan periode yang lewat tanpa centang dicatat sebagai "terlewat"
// oleh materializeOverdue() (dijalankan sebelum halaman ini dirender).
//
// Semua aksi memakai Astro Action (src/actions) — menandai selesai, membatalkan, dan
// menyimpan catatan berjalan lewat RPC, jadi halaman tidak pernah dimuat ulang.
import { Check, CheckCircle, Clock, Inbox, ExclamationTriangle } from "../lib/icons";
import BarChart from "../components/ui/BarChart.astro";
import ContributionGraph from "../components/user/ContributionGraph.astro";
import NoteDialog from "../components/user/NoteDialog.astro";
import TaskCard from "../components/user/TaskCard.astro";
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { requireUser } from "../lib/auth";
import { findCategory } from "../lib/categories";
import {
  dailyDoneTrend,
  listDailyActivity,
  listMissedTasks,
  listUserOccurrences,
  markAssignmentsSeen,
  materializeOverdue,
  taskStats,
} from "../lib/db";
import { formatDate, formatMinutes, formatPeriod, formatPeriodShort } from "../lib/format";
import { daysBetween, todayIso } from "../lib/tasks";

const session = await requireUser(Astro);
if (session instanceof Response) return session;

const userId = Number(session.user!.id);
if (!Number.isInteger(userId)) return Astro.redirect("/login?error=SessionRequired");

const today = todayIso();

// "Sudah dibaca" tanpa JavaScript: form biasa ke halaman ini sendiri.
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("action") === "seen") {
    markAssignmentsSeen(userId);
    return Astro.redirect("/user?inbox=1");
  }
}

// Catat dulu periode yang lewat tanpa penyelesaian, baru baca kemunculan periode berjalan.
materializeOverdue(userId);
const occurrences = listUserOccurrences(userId);
const missed = listMissedTasks(userId);

// Urutan kerja, bukan urutan abjad: yang terlambat naik, yang selesai turun. Dihitung
// di server supaya urutannya sama saat halaman dibuka tanpa JavaScript.
const workingOrder = (a: (typeof occurrences)[number], b: (typeof occurrences)[number]) => {
  const rank = (item: (typeof occurrences)[number]) => {
    if (item.status === "selesai") return 2;
    return item.due < today ? 0 : 1;
  };
  return rank(a) - rank(b) || a.name.localeCompare(b.name, "id", { sensitivity: "base" });
};

const FILTERS = [
  { id: "semua", title: "Semua", periode: null },
  { id: "hari-ini", title: "Hari ini", periode: "Hari ini" },
  { id: "minggu-ini", title: "Minggu ini", periode: "Mingguan" },
  { id: "bulan-ini", title: "Bulan ini", periode: "Bulanan" },
  { id: "triwulan-ini", title: "Triwulan", periode: "Triwulan" },
  { id: "semester-ini", title: "Semester ini", periode: "Semesteran" },
  { id: "tahun-ini", title: "Tahun ini", periode: "Tahunan" },
  { id: "kegiatan", title: "Kegiatan", periode: "Kegiatan" },
] as const;

// "Hari ini" adalah grup tersendiri di paling atas, dan grup periode mengecualikan
// tugas yang jatuh tempo hari ini — satu kemunculan hanya boleh muncul satu kali,
// karena semua aksi menyasar kartunya lewat (activity_id, period_key).
const groups = FILTERS.filter((filter) => filter.periode !== null).map((filter) => ({
  id: filter.id,
  title: filter.title,
  items: occurrences
    .filter((item) =>
      filter.periode === "Hari ini"
        ? item.due === today
        : item.periode === filter.periode && item.due !== today,
    )
    .sort(workingOrder),
}));

// Satu sapuan untuk semua angka panel tugas dan bilah hari ini.
const panelDone = occurrences.filter((item) => item.status === "selesai").length;
const filters = FILTERS.map((filter) => ({
  ...filter,
  count:
    filter.periode === null
      ? occurrences.length
      : groups.find((group) => group.id === filter.id)?.items.length ?? 0,
}));

const stats = taskStats(userId);

// Grafik kontribusi: tahun yang dipilih (default tahun berjalan) + rekap hariannya.
const requestedYear = Number(Astro.url.searchParams.get("tahun"));
const currentYear = Number(today.slice(0, 4));
const graphYear =
  Number.isInteger(requestedYear) && requestedYear >= 2000 && requestedYear <= 2100
    ? requestedYear
    : currentYear;
const activity = listDailyActivity(userId);

// Kemunculan yang lagi disunting catatannya: dari ?note=&period= — jalur tanpa
// JavaScript, tempat server merender dialognya terbuka. Dengan JavaScript, dialog
// dibuka langsung dari kartu (lihat NoteDialog).
const editingId = Number(Astro.url.searchParams.get("note") ?? 0) || 0;
const editingPeriod = Astro.url.searchParams.get("period") ?? "";
const editingTarget = occurrences.find(
  (item) => item.activity_id === editingId && item.period_key === editingPeriod,
);
const editing = editingTarget
  ? {
      activityId: editingTarget.activity_id,
      periodKey: editingTarget.period_key,
      name: editingTarget.name,
      note: editingTarget.note,
      link: editingTarget.link,
    }
  : undefined;

const firstName = (session.user?.name ?? "Pengguna").split(" ")[0];
const todayLong = new Date(`${today}T00:00:00Z`).toLocaleDateString("id-ID", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Jakarta",
});

// Tugas hari ini: satu-satunya angka yang menuntut tindakan sekarang, dan satu-satunya
// yang perlu disegarkan saat sebuah kartu dicentang (lihat refreshTodaySummary).
const dueTodayItems = occurrences.filter((item) => item.due === today);
const openToday = dueTodayItems.filter((item) => item.status !== "selesai");
const doneToday = dueTodayItems.length - openToday.length;
const minutesToday = openToday.reduce((sum, item) => sum + item.minutes, 0);

// Ritme: tugas selesai per hari, 14 hari terakhir.
const doneTrend = dailyDoneTrend(userId, 14);
const doneTotal14 = doneTrend.reduce((sum, day) => sum + day.count, 0);
const averagePerDay = (doneTotal14 / doneTrend.length).toLocaleString("id-ID", {
  minimumFractionDigits: 1,
  maximumFractionDigits: 1,
});
const activeDays = doneTrend.filter((day) => day.count > 0).length;
// Only day numbers: a 14-bar row on a phone truncates "13 Okt" to "13 …" anyway.
const trend = doneTrend.map((day) => ({
  label: String(Number(day.date.slice(8, 10))),
  value: day.count,
  title: `${formatDate(day.date)} · ${day.count} tugas selesai`,
}));

/** "Jatuh tempo hari ini" / "Jatuh tempo 25 Okt 2026" (+ keterlambatan). */
const dueText = (due: string) => {
  if (due === today) return "Jatuh tempo hari ini";
  const late = daysBetween(due, today);
  return `Jatuh tempo ${formatDate(due)}${late > 0 ? ` · terlambat ${late} hari` : ""}`;
};
---

<DashboardLayout title="Dashboard" user={session.user}>
  {/* Kepala halaman: sapaan, lalu satu ringkasan yang menjawab "apa yang harus saya
      kerjakan sekarang". Bilah kemajuan per grup sudah ada di bawah, jadi tidak
      diulang di sini. */}
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3" data-reveal="up">
    <div class="min-w-0">
      <h1 class="text-xl font-semibold text-slate-900">Halo, {firstName}</h1>
      <p class="mt-1 text-sm text-slate-500">{todayLong}</p>
    </div>

    {
      dueTodayItems.length > 0 && (
        <div
          data-today-summary
          data-open={openToday.length}
          class="flex w-full items-center gap-3 rounded-xl border px-4 py-2.5 sm:w-auto sm:max-w-xs"
        >
          {/* Both states are rendered and CSS picks one: the live patch only flips
              `data-open`, so no icon markup is built in JavaScript. */}
          <Clock data-summary-icon="open" class="size-5 shrink-0 text-amber-700" />
          <CheckCircle data-summary-icon="done" class="size-5 shrink-0 text-emerald-700" />
          <span class="min-w-0" aria-live="polite">
            <span data-summary-title class="block text-sm font-semibold text-slate-900">
              {openToday.length > 0 ? `${openToday.length} tugas belum selesai` : "Tugas hari ini beres"}
            </span>
            <span data-summary-detail class="mt-0.5 block text-xs text-slate-600">
              {openToday.length > 0
                ? minutesToday > 0
                  ? `${formatMinutes(minutesToday)} lagi`
                  : `${doneToday}/${dueTodayItems.length} selesai`
                : `${doneToday}/${dueTodayItems.length} tugas selesai`}
            </span>
          </span>
        </div>
      )
    }
  </div>

  <p
    data-action-error
    hidden
    class="mt-6 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"
    role="alert"
  >
  </p>

  {/* Panel tugas: isi utama dashboard, ditaruh paling atas. Filternya chip periode —
      satu grup per jenis periode, dengan "Hari ini" sebagai sapuan lintas periode. */}
  <section class="mt-6" aria-labelledby="tugas-title" data-reveal="up">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="tugas-title" class="scroll-mt-24 text-sm font-semibold text-slate-900">Tugas</h2>
      <p class="text-xs text-slate-500">
        {panelDone}/{occurrences.length} selesai
      </p>
    </div>

    {
      occurrences.length > 0 && (
        <div
          role="group"
          aria-label="Filter periode"
          data-filter-bar
          class="mt-3 flex flex-wrap gap-1.5"
        >
          {filters
            .filter((filter) => filter.count > 0)
            .map((filter) => (
              <button
                type="button"
                data-filter={filter.id}
                aria-pressed={filter.id === "semua" ? "true" : "false"}
                class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-900 aria-pressed:border-brand-600 aria-pressed:bg-brand-600 aria-pressed:text-onbrand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              >
                {filter.title}
                <span class="tabular-nums opacity-60">{filter.count}</span>
              </button>
            ))}
        </div>
      )
    }

    {
      groups
        .filter((group) => group.items.length > 0)
        .map((group) => {
          const done = group.items.filter((item) => item.status === "selesai").length;
          return (
            <div class="mt-6" data-group={group.id}>
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-semibold text-slate-900">{group.title}</h3>
                <p data-group-count class="text-xs tabular-nums text-slate-500">
                  {done}/{group.items.length} selesai
                </p>
              </div>
              <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-slate-200">
                <div
                  data-progress-bar
                  class="h-full origin-left rounded-full bg-brand-600 transition-transform duration-300"
                  style={`transform: scaleX(${group.items.length > 0 ? done / group.items.length : 0})`}
                >
                </div>
              </div>

              <ul class="mt-3 space-y-2">
                {group.items.map((item) => {
                  const category = findCategory(item.category_id);
                  return (
                    <TaskCard
                      name={item.name}
                      unitLabel={category?.label ?? item.category_id}
                      unitIcon={category?.icon ?? Inbox}
                      periode={item.periode}
                      dueText={dueText(item.due)}
                      dueToday={item.due === today}
                      periodKey={item.period_key}
                      activityId={item.activity_id}
                      minutes={item.minutes}
                      done={item.status === "selesai"}
                      late={item.late}
                      note={item.note}
                      link={item.link}
                      giverName={item.giver_name}
                      giverEmail={item.giver_email}
                      noteHref={`/user?note=${item.activity_id}&period=${encodeURIComponent(item.period_key)}`}
                    />
                  );
                })}
              </ul>
            </div>
          );
        })
    }

    {
      occurrences.length === 0 && (
        <div class="mt-3 flex flex-col items-center gap-2 rounded-xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
          <Inbox class="size-8 text-slate-300" />
          <p class="text-sm font-medium text-slate-900">Belum ada penugasan</p>
          <p class="max-w-sm text-sm text-slate-500">
            Admin belum memberi tugas pada akun Anda. Hubungi admin bila ini tidak sesuai.
          </p>
        </div>
      )
    }
  </section>

  {/* Terlewat: pekerjaan yang bisa dibereskan sekarang, jadi naik ke atas grafik.
      Satu kartu berisi baris-baris, bukan satu kartu merah per aktivitas — dinding
      peringatan sebesar itu justru membuat daftar tugas di atas terasa tidak penting. */}
  {
    missed.length > 0 && (
      <section class="mt-8" data-reveal="up">
        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
          <h2 class="text-sm font-semibold text-red-700">Terlewat</h2>
          <p class="text-xs text-slate-500">{stats.missed} kemunculan</p>
        </div>
        <p class="mt-1 text-xs text-slate-500">
          Periode yang sudah lewat tanpa diselesaikan. Klik periodenya untuk menandai yang sudah
          dikerjakan.
        </p>

        <ul class="mt-3 divide-y divide-slate-100 rounded-xl border border-red-200 bg-white">
          {missed.map((item) => {
            const category = findCategory(item.category_id);
            const UnitIcon = category?.icon ?? Inbox;
            return (
              <li class="p-3.5 sm:p-4">
                <div class="flex items-start gap-3">
                  <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-red-50 text-red-600">
                    <ExclamationTriangle class="size-4" />
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                      <p class="text-sm font-medium text-slate-900">{item.name}</p>
                      <p class="flex items-center gap-1 text-xs text-slate-500">
                        <UnitIcon class="size-3.5" />
                        {category?.label ?? item.category_id}
                      </p>
                    </div>
                    <p class="mt-0.5 text-xs text-slate-500">
                      {item.count}× terlewat · terakhir {formatDate(item.last_due)}
                    </p>

                    {/* Satu chip per periode: yang di-undo muncul lagi di sini, dan bisa
                        langsung ditandai selesai lagi. */}
                    <ul class="mt-2 flex max-h-24 flex-wrap gap-1.5 overflow-y-auto">
                      {item.periods.map((key) => (
                        <li>
                          <button
                            type="button"
                            data-missed-chip
                            data-activity-id={item.activity_id}
                            data-period-key={key}
                            title={`Tandai selesai: ${formatPeriod(item.periode, key)}`}
                            class="inline-flex items-center gap-1 rounded-full border border-red-200 bg-white px-2.5 py-1 text-xs font-medium text-red-700 transition-colors hover:border-red-300 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
                          >
                            <Check class="size-3" />
                            {formatPeriodShort(item.periode, key)}
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {/* Ritme: satu kartu yang menjawab "apakah saya konsisten", bukan mengulang angka
      yang sudah ada di kepala halaman dan di tiap kelompok tugas. Akun yang belum punya
      riwayat sama sekali tidak mendapat kartu berisi nol. */}
  {
    (stats.doneMonth > 0 || stats.missed > 0) && (
      <section
        class="mt-8 rounded-xl border border-slate-200 bg-white p-4 sm:p-5"
        data-reveal="up"
        aria-labelledby="ritme-title"
      >
        <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
          <h2 id="ritme-title" class="text-sm font-semibold text-slate-900">Ritme 14 hari</h2>
          <p class="text-xs text-slate-500">
            <span data-stat="done-month" class="font-medium tabular-nums text-slate-700">{stats.doneMonth}</span>{" "}
            selesai bulan ini
          </p>
        </div>

        {/* The chart is a snapshot from page load: checking a task refreshes the
            summary and the group counters, not this history. Acceptable for a
            long-range rhythm; upgrade to a client patch if it starts to feel stale. */}
        {doneTotal14 > 0 ? (
          <BarChart label="Tugas selesai per hari, 14 hari terakhir" values={trend} class="mt-4" />
        ) : (
          <p class="mt-4 rounded-lg border border-dashed border-slate-200 px-3 py-6 text-center text-xs text-slate-500">
            Belum ada tugas yang selesai dalam 14 hari terakhir.
          </p>
        )}

        <dl class="mt-4 grid grid-cols-3 gap-2 border-t border-slate-200 pt-4">
          <div>
            <dt class="text-xs text-slate-500">Rata-rata/hari</dt>
            <dd class="mt-0.5 text-lg font-semibold tabular-nums text-slate-900">{averagePerDay}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">Hari aktif</dt>
            <dd class="mt-0.5 text-lg font-semibold tabular-nums text-slate-900">
              {activeDays}<span class="text-sm font-normal text-slate-500">/14</span>
            </dd>
          </div>
          <div>
            <dt class="text-xs text-slate-500">Terlewat</dt>
            <dd
              class:list={[
                "mt-0.5 text-lg font-semibold tabular-nums",
                stats.missed > 0 ? "text-red-700" : "text-slate-900",
              ]}
              data-stat="missed"
            >
              {stats.missed}
            </dd>
          </div>
        </dl>
      </section>
    )
  }

  <ContributionGraph
    year={graphYear}
    today={today}
    days={activity.days}
    years={activity.years}
  />

  <NoteDialog occurrence={editing} />
</DashboardLayout>

<script>
  import { actions } from "astro:actions";
  import {
    applyStats,
    graphYear,
    patchGraph,
    refreshGroupCounts,
    setTaskPending,
    setTaskState,
  } from "../scripts/tasks.ts";

  // Aksinya lewat Astro Action, jadi halamannya tidak pernah dimuat ulang: server
  // menjawab dengan keadaan baru, lalu DOM-nya diselaraskan di tempat.
  // Kotak errornya dicari saat dipakai — router menukar DOM, jadi rujukan yang
  // disimpan sejak awal akan menunjuk ke elemen yang sudah lepas.
  const showError = (message: string) => {
    const errorBox = document.querySelector<HTMLElement>("[data-action-error]");
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  const clearError = () => {
    const errorBox = document.querySelector<HTMLElement>("[data-action-error]");
    if (!errorBox) return;
    errorBox.textContent = "";
    errorBox.hidden = true;
  };

  /** Kartu tempat aksi ini berlaku. */
  const cardOf = (activityId: string, periodKey: string) =>
    document.querySelector<HTMLElement>(
      `[data-task][data-activity-id="${activityId}"][data-period-key="${periodKey}"]`,
    );

  /**
   * Menampilkan hanya grup filter yang dipilih; "semua" menampilkan semuanya.
   * Chip hanya dirender untuk grup yang berisi tugas, jadi tidak ada grup kosong
   * yang perlu dijelaskan.
   */
  const applyFilter = (id: string) => {
    document.querySelectorAll<HTMLElement>("[data-filter]").forEach((chip) => {
      chip.setAttribute("aria-pressed", String(chip.dataset.filter === id));
    });
    document.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
      group.hidden = id !== "semua" && group.dataset.group !== id;
    });
  };

  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;

    // Chip filter periode: menyaring grup yang sudah dirender, tanpa memuat ulang.
    const filterChip = target.closest<HTMLElement>("[data-filter]");
    if (filterChip) {
      applyFilter(filterChip.dataset.filter ?? "semua");
      return;
    }

    // Tandai selesai / batalkan dari kartu tugas.
    const toggle = target.closest<HTMLElement>("[data-task-toggle]");
    if (toggle) {
      event.preventDefault();
      clearError();

      const activityId = toggle.dataset.activityId ?? "";
      const periodKey = toggle.dataset.periodKey ?? "";
      const done = toggle.dataset.state === "done";
      const card = cardOf(activityId, periodKey);
      const name = card?.dataset.name ?? "";

      setTaskPending(card, true);
      const { data, error } = done
        ? await actions.undoTask({ activityId: Number(activityId), periodKey, year: graphYear() })
        : await actions.completeTask({
            activityId: Number(activityId),
            periodKey,
            year: graphYear(),
          });
      setTaskPending(card, false);

      if (error || !data) {
        showError(error?.message ?? "Tugas gagal diperbarui.");
        return;
      }
      if (!card) return;

      applyStats(data.stats);
      patchGraph(data.graph);
      setTaskState(
        card,
        { done: !done, late: !done && data.result === "terlambat", name },
      );
      return;
    }

    // Tandai satu periode yang terlewat selesai — chipnya hilang setelah itu.
    const chip = target.closest<HTMLElement>("[data-missed-chip]");
    if (chip) {
      event.preventDefault();
      clearError();

      const activityId = chip.dataset.activityId ?? "";
      const periodKey = chip.dataset.periodKey ?? "";
      const { data, error } = await actions.completeTask({
        activityId: Number(activityId),
        periodKey,
        year: graphYear(),
      });

      if (error || !data) {
        showError(error?.message ?? "Tugas gagal diperbarui.");
        return;
      }

      chip.closest("li")?.remove();
      applyStats(data.stats);
      patchGraph(data.graph);
      refreshGroupCounts();
    }
  });
</script>

<style>
  /* Tone of the today summary. Both states are painted by CSS so a live update only
     has to write `data-open` — text, colour and icon stay in sync from one source. */
  [data-today-summary] {
    border-color: var(--color-amber-200);
    background-color: var(--color-amber-50);
  }
  [data-today-summary] [data-summary-icon="done"] {
    display: none;
  }
  [data-today-summary][data-open="0"] {
    border-color: var(--color-emerald-200);
    background-color: var(--color-emerald-50);
  }
  [data-today-summary][data-open="0"] [data-summary-icon="open"] {
    display: none;
  }
  [data-today-summary][data-open="0"] [data-summary-icon="done"] {
    display: block;
  }
</style>
