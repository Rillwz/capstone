---
// Tabs — reusable tab strip (roving tabindex + arrow keys) and one panel per item.
// Each panel defaults to a card with an empty state; pass a named slot (name = item id)
// to override a panel's body.
interface Props {
  items: Array<{ id: string; label: string }>;
  ariaLabel?: string;
  class?: string;
}

const { items, ariaLabel = "Tab", class: className } = Astro.props;
---

<div data-tabs class:list={[className]}>
  <div role="tablist" aria-label={ariaLabel} class="flex flex-wrap gap-1 rounded-xl border border-slate-200 bg-white p-1">
    {
      items.map(({ id, label }, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${id}`}
          data-tab={id}
          aria-controls={`panel-${id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 aria-selected:bg-brand-50 aria-selected:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
        >
          {label}
        </button>
      ))
    }
  </div>

  {
    items.map(({ id, label }, i) => (
      <div
        role="tabpanel"
        id={`panel-${id}`}
        aria-labelledby={`tab-${id}`}
        data-panel={id}
        hidden={i !== 0}
        class="mt-4 rounded-xl border border-slate-200 bg-white p-5"
      >
        <h2 class="text-sm font-semibold text-slate-900">{label}</h2>
        <slot name={id}>
          <p class="mt-2 text-sm text-slate-500">Belum ada data pada kategori ini.</p>
        </slot>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => tab.addEventListener("click", () => select(i, false)));

    root.addEventListener("keydown", (event) => {
      const i = tabs.indexOf(document.activeElement as HTMLElement);
      if (i === -1) return;

      let next = i;
      if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
      else if (event.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;

      event.preventDefault();
      select(next);
    });
  });
</script>
