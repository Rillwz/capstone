---
// Segmented choice control — a few short options as toggle chips instead of a dropdown.
// Single choice (radios sharing `name`) or multiple choice (one checkbox per option,
// each named after its value).
interface Props {
  label: string;
  options: ReadonlyArray<{ value: string; label: string }>;
  name?: string;
  multiple?: boolean;
  value?: string;
  selected?: string[];
  hint?: string;
}

const { label, options, name, multiple = false, value, selected = [], hint } = Astro.props;
---

<fieldset class="min-w-0">
  <legend class="block pb-1.5 text-sm font-medium text-slate-700">{label}</legend>
  <div class="flex flex-wrap gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1">
    {
      options.map((option) => (
        <label class="flex-1 cursor-pointer rounded-md px-3 py-2 text-center text-sm font-medium text-slate-600 transition-colors hover:text-slate-900 has-[:checked]:bg-white has-[:checked]:text-brand-700 has-[:checked]:shadow-sm has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-brand-600">
          <input
            type={multiple ? "checkbox" : "radio"}
            name={multiple ? option.value : name}
            value={option.value}
            checked={multiple ? selected.includes(option.value) : option.value === value}
            class="sr-only"
          />
          {option.label}
        </label>
      ))
    }
  </div>
  {hint && <p class="mt-1.5 text-xs text-slate-500">{hint}</p>}
</fieldset>
