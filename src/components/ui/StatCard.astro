---
// Overview metric card. Icon comes from the caller via the `icon` slot.
interface Props {
  label: string;
  value: number | string;
  hint?: string;
}

const { label, value, hint } = Astro.props;
---

<div class="rounded-xl border border-slate-200 bg-white p-5" data-reveal>
  <div class="flex items-center gap-3">
    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600" data-reveal="scale">
      <slot name="icon" />
    </span>
    <p class="text-sm font-medium text-slate-500">{label}</p>
  </div>
  <p
    class="mt-3 text-2xl font-semibold tracking-tight text-slate-900 tabular-nums"
    data-count={typeof value === "number" ? value : undefined}
  >
    {value}
  </p>
  {hint && <p class="mt-1 text-xs text-slate-500">{hint}</p>}
</div>
