---
// The one place toasts appear, rendered once per dashboard page. The icon templates
// live here so src/scripts/toast.ts can clone them instead of writing raw SVG.
import { CheckCircle, ExclamationTriangle, InformationCircle, XCircle } from "../../lib/icons";
---

<div
  id="toast-region"
  class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4"
>
  <template data-toast-icon="success"><CheckCircle class="size-5" /></template>
  <template data-toast-icon="error"><XCircle class="size-5" /></template>
  <template data-toast-icon="warning"><ExclamationTriangle class="size-5" /></template>
  <template data-toast-icon="info"><InformationCircle class="size-5" /></template>
</div>
