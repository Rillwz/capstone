---
// Default-password display: masked until revealed. The value sits in the markup
// either way, so this only keeps it out of sight during a demo or screen share.
import { Eye, EyeOff } from "@lucide/astro";

interface Props {
  value: string;
  class?: string;
}

const { value, class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-1", className]}>
  <code
    data-password-display
    data-value={value}
    class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-700"
    >{"•".repeat(value.length)}</code
  >
  <button
    type="button"
    data-password-toggle
    aria-pressed="false"
    aria-label="Tampilkan kata sandi"
    title="Tampilkan kata sandi"
    class="grid size-6 place-items-center rounded-md text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
  >
    <Eye class="size-4" />
    <EyeOff class="size-4 hidden" />
  </button>
</span>

<script>
  // Handles every instance on the page. The router swaps the DOM but keeps this
  // module, so the buttons are wired again on every astro:page-load.
  const init = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-password-toggle]").forEach((button) => {
      if (button.dataset.passwordWired) return;
      button.dataset.passwordWired = "1";

      button.addEventListener("click", () => {
        const code = button.parentElement?.querySelector<HTMLElement>("[data-password-display]");
        const value = code?.dataset.value;
        if (!code || !value) return;

        const reveal = button.getAttribute("aria-pressed") !== "true";
        button.setAttribute("aria-pressed", String(reveal));
        const label = reveal ? "Sembunyikan kata sandi" : "Tampilkan kata sandi";
        button.setAttribute("aria-label", label);
        button.title = label;

        code.textContent = reveal ? value : "•".repeat(value.length);
        button.querySelector(".lucide-eye")?.classList.toggle("hidden", reveal);
        button.querySelector(".lucide-eye-off")?.classList.toggle("hidden", !reveal);
      });
    });
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>
