---
// Markdown editor with a live preview pane ("semacam WYSIWYG").
// Posts to the current URL — the page decides create vs. update. The save goes
// through an Astro Action, so publishing does not reload the page.
import { Bold, CodeBracket, H2, Italic, Link, ListBullet, ChatBubbleLeftEllipsis, XMark } from "../../lib/icons";
import Button from "../ui/Button.astro";
import Input from "../ui/Input.astro";

interface Props {
  post?: { title: string; body: string };
  error?: string;
  submitLabel?: string;
  /** Id postingan yang disunting — kosong untuk membuat yang baru. */
  postId?: number;
  /** Ke mana formulir dikirim: halaman baru atau suntingan. */
  action?: "create" | "update";
}

const { post, error, submitLabel = "Simpan", postId, action = "create" } = Astro.props;

const tools = [
  { md: "bold", icon: Bold, label: "Tebal" },
  { md: "italic", icon: Italic, label: "Miring" },
  { md: "heading", icon: H2, label: "Sub-judul" },
  { md: "list", icon: ListBullet, label: "Daftar" },
  { md: "quote", icon: ChatBubbleLeftEllipsis, label: "Kutipan" },
  { md: "code", icon: CodeBracket, label: "Kode" },
  { md: "link", icon: Link, label: "Tautan" },
];
---

{error && (
  <p class="mb-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600" role="alert">
    {error}
  </p>
)}

{/* Wadah field — submit-nya ditangani Astro Action. */}
<form
  method="POST"
  class="space-y-4"
  data-reveal="up"
  data-post-form
  data-post-id={postId}
  data-post-action={action}
>
  <Input label="Judul" name="title" value={post?.title} placeholder="Judul postingan" required />

  <div>
    <div class="mb-1.5 flex flex-wrap items-center justify-between gap-2">
      <span class="text-sm font-medium text-slate-700">
        Isi <span class="text-slate-400">(Markdown)</span>
      </span>
      <div class="flex items-center gap-1" role="toolbar" aria-label="Pemformatan">
        {tools.map(({ md, icon: Icon, label }) => (
          <button
            type="button"
            data-md={md}
            title={label}
            aria-label={label}
            class="grid size-8 place-items-center rounded-lg text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
          >
            <Icon class="size-4" />
          </button>
        ))}
      </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <textarea
        id="body"
        name="body"
        rows="18"
        required
        placeholder={"# Judul\n\nTulis pengumuman di sini…\n\n- poin pertama\n- poin kedua"}
        class="min-h-[26rem] w-full resize-y rounded-lg border border-slate-300 bg-white p-3.5 font-mono text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:border-brand-600 focus:outline-2 focus:outline-brand-600"
      >{post?.body}</textarea>

      <div class="min-h-[26rem] overflow-y-auto rounded-lg border border-slate-200 bg-white p-5">
        <p class="mb-3 text-xs font-medium tracking-wide text-slate-400 uppercase">Pratinjau</p>
        <div id="preview" class="prose-md"></div>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <Button type="submit">{submitLabel}</Button>
    <Button variant="outline" href="/dashboard/posts"><XMark class="size-4" />Batal</Button>
  </div>
</form>

<script>
  import { marked } from "marked";
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";
  import { toast } from "../../scripts/dashboard.ts";

  // Pratinjau = markdown server yang sama, dirender di klien.
  marked.use({ gfm: true, breaks: true });

  // The router swaps the DOM but keeps this module, so the editor is wired again on
  // every astro:page-load.
  const init = () => {
    const textarea = document.getElementById("body") as HTMLTextAreaElement | null;
    const preview = document.getElementById("preview");
    // shortcut: konten hanya ditulis admin (trusted), jadi HTML mentah tidak disanitasi.
    // Sanitasi kalau nanti postingan bisa ditulis pengguna biasa.

    if (!textarea || !preview || textarea.dataset.editorWired) return;
    textarea.dataset.editorWired = "1";

    // Terbitkan / sunting lewat Astro Action — halamannya tidak dimuat ulang.
    const form = textarea.closest<HTMLFormElement>("[data-post-form]");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const title = form.querySelector<HTMLInputElement>('[name="title"]')?.value ?? "";
      const body = textarea.value;
      if (!title.trim() || !body.trim()) {
        toast("Judul dan isi wajib diisi.", "warning");
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>("[type=submit]");
      if (submit) submit.disabled = true;

      const { data, error } = await actions.savePost({
        id: form.dataset.postId ? Number(form.dataset.postId) : undefined,
        title,
        body,
      });

      if (submit) submit.disabled = false;

      if (error || !data) {
        toast(error?.message ?? "Postingan gagal disimpan.", "error");
        return;
      }
      await navigate(data.url);
      toast(form.dataset.postAction === "update" ? "Postingan diperbarui." : "Postingan diterbitkan.");
    });

    let timer: ReturnType<typeof setTimeout> | undefined;
    const render = () => {
      preview.innerHTML = marked.parse(textarea.value, { async: false }) as string;
    };

    textarea.addEventListener("input", () => {
      clearTimeout(timer);
      timer = setTimeout(render, 120);
    });
    render();

    // Toolbar: wrap/replace the current selection.
    const wrap = (before: string, after = before) => {
      const { selectionStart: s, selectionEnd: e, value } = textarea;
      const selected = value.slice(s, e) || "teks";
      textarea.setRangeText(`${before}${selected}${after}`, s, e, "end");
      textarea.focus();
      render();
    };

    const prefixLines = (marker: string) => {
      const { selectionStart: s, selectionEnd: e, value } = textarea;
      const start = value.lastIndexOf("\n", s - 1) + 1;
      const end = value.indexOf("\n", e) === -1 ? value.length : value.indexOf("\n", e);
      const block = value
        .slice(start, end)
        .split("\n")
        .map((line) => `${marker}${line}`)
        .join("\n");
      textarea.setRangeText(block, start, end, "end");
      textarea.focus();
      render();
    };

    document.querySelectorAll<HTMLButtonElement>("[data-md]").forEach((button) => {
      if (button.dataset.mdWired) return;
      button.dataset.mdWired = "1";

      button.addEventListener("click", () => {
        switch (button.dataset.md) {
          case "bold":
            return wrap("**");
          case "italic":
            return wrap("_");
          case "heading":
            return prefixLines("## ");
          case "list":
            return prefixLines("- ");
          case "quote":
            return prefixLines("> ");
          case "code":
            return wrap("\n```\n", "\n```\n");
          case "link":
            return wrap("[", "](https://)");
        }
      });
    });
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>
