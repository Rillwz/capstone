---
// Satu tugas di ruang kerja user: nama, unit kerja, periode, jatuh tempo, dan tombol
// centang. Satu form untuk dua aksi — "complete" (tandai selesai) dan "undo" (batalkan).
import { Check, Clock } from "@lucide/astro";
import type { AstroComponent } from "@lucide/astro";

interface Props {
  name: string;
  unitLabel: string;
  unitIcon: AstroComponent;
  periode: string;
  dueText: string;
  periodKey: string;
  activityId: number;
  done: boolean;
  late?: boolean;
}

const { name, unitLabel, unitIcon: UnitIcon, periode, dueText, periodKey, activityId, done, late = false } =
  Astro.props;
---

<li class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4">
  <form method="POST" class="shrink-0">
    <input type="hidden" name="activityId" value={activityId} />
    <input type="hidden" name="periodKey" value={periodKey} />
    <button
      type="submit"
      name="action"
      value={done ? "undo" : "complete"}
      aria-label={done ? `Batalkan tanda selesai: ${name}` : `Tandai selesai: ${name}`}
      title={done ? "Batalkan tanda selesai" : "Tandai selesai"}
      class:list={[
        "grid size-9 place-items-center rounded-full border-2 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600",
        done
          ? "border-brand-600 bg-brand-600 text-onbrand"
          : "border-slate-300 bg-white text-slate-300 hover:border-brand-400 hover:text-brand-400",
      ]}
    >
      <Check class="size-4" />
    </button>
  </form>

  <div class="min-w-0 flex-1">
    <p class="text-sm font-medium text-slate-900">{name}</p>
    <p class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-slate-500">
      <span class="inline-flex items-center gap-1">
        <UnitIcon class="size-3.5" />
        {unitLabel}
      </span>
      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">{periode}</span>
      <span class="inline-flex items-center gap-1">
        <Clock class="size-3.5" />
        {dueText}
      </span>
    </p>
  </div>

  {
    done && (
      <span
        class:list={[
          "shrink-0 rounded-full px-2 py-0.5 text-xs font-medium",
          late ? "bg-amber-50 text-amber-700" : "bg-emerald-50 text-emerald-700",
        ]}
      >
        {late ? "Terlambat" : "Selesai"}
      </span>
    )
  }
</li>
