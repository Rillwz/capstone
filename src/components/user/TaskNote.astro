---
// Catatan & tautan satu kemunculan tugas: tombol "+" untuk menyunting, lalu catatan
// dan tautan yang sudah tersimpan. Dipakai di daftar tugas dan di riwayat.
//
// Tombolnya sebuah link: tanpa JavaScript, kliknya membuka dialog catatan lewat
// halaman (server merender dialognya terbuka); dengan JavaScript, kliknya membuka
// dialog langsung tanpa pindah halaman.
//
// Catatan dan tautannya selalu ada di markup (dibuat tersembunyi bila kosong),
// supaya aksi bisa menempelkan isinya tanpa memuat ulang halaman.
import { Link as LinkIcon, Plus } from "../../lib/icons";
import { linkLabel } from "../../lib/notes";

interface Props {
  activityId: number;
  periodKey: string;
  name: string;
  note?: string;
  link?: string;
  /** Fallback tanpa JavaScript: halaman dengan dialog catatan terbuka. */
  noteHref: string;
}

const { activityId, periodKey, name, note = "", link = "", noteHref } = Astro.props;
---

<div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
  <a
    href={noteHref}
    data-note-open
    data-activity-id={activityId}
    data-period-key={periodKey}
    data-name={name}
    class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-xs font-medium text-brand-600 transition-colors hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
  >
    <Plus class="size-3.5" />
    Catatan
  </a>

  <p
    data-note-text
    class:list={[
      "w-full text-xs leading-relaxed text-slate-600 line-clamp-2",
      !note && "hidden",
    ]}
    title={note}
  >
    {note}
  </p>

  <a
    data-note-link
    data-note-url={link}
    href={link || "#"}
    target="_blank"
    rel="noopener noreferrer"
    title={link}
    class:list={[
      "inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-xs font-medium text-brand-600 transition-colors hover:bg-brand-50 hover:text-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600",
      !link && "hidden",
    ]}
  >
    <LinkIcon class="size-3.5" />
    <span data-note-host>{linkLabel(link)}</span>
  </a>
</div>
