---
// Brand wordmark: optional UMSURA mark (white, so dark surfaces only) + "name" with "sup"
// as a styled superscript. CSS only — plays once on appear (staggered rise + a pop on the
// superscript), then the superscript pops again on hover.
type Props = {
  name: string;
  sup?: string;
  /** Show the mark to the left of the wordmark; set false for text-only brand marks. */
  logo?: boolean;
  class?: string;
};

const { name, sup = "+", logo = true, class: className } = Astro.props;
---

<span class:list={["brandmark", className]}>
  {logo && <img src="/umsura_light.png" alt="" width="600" height="120" class="brandmark-logo" />}
  <span class="brandmark-name">{name}</span><sup
    class="brandmark-sup text-white px-1 align-super text-[0.6em] font-bold leading-none text-brand-700">{sup}
  </sup>
</span>

<style>
  /* em-based, so the mark scales with whatever font size the wordmark is given. */
  .brandmark-logo {
    display: inline-block;
    height: 1.6em;
    width: auto;
    margin-right: 0.5em;
    vertical-align: middle;
  }

  .brandmark-name,
  .brandmark-sup {
    display: inline-block; /* transforms need an inline-block box */
  }

  /* fill-mode "backwards" keeps the end state out of the cascade, so the hover
     transform is not blocked by the finished entry animation. */
  @media (prefers-reduced-motion: no-preference) {
    .brandmark-logo {
      animation: brandmark-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .brandmark-name {
      animation: brandmark-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.05s backwards;
    }

    .brandmark-sup {
      animation: brandmark-pop 0.65s cubic-bezier(0.34, 1.56, 0.64, 1) 0.22s backwards;
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .brandmark:hover .brandmark-sup {
      transform: translateY(-0.08em) scale(1.16);
    }
  }

  @keyframes brandmark-rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(5px);
    }
  }

  @keyframes brandmark-pop {
    from {
      opacity: 0;
      transform: translateY(0.2em) scale(0.4);
    }
  }
</style>
