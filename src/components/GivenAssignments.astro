---
// Daftar instruksi yang diberikan satu orang, beserta progresnya.
//
// Dipakai dua tempat: /user/penugasan (level 1) dan /instruksi (admin). Satu komponen
// supaya angka, urutan dan legendanya tidak bisa menyimpang.
//
// "Lepas" tetap form POST biasa supaya jalan tanpa JavaScript; dengan JavaScript,
// submit-nya ditahan dulu dan dilewatkan dialog konfirmasi — melepas penugasan
// menghapus riwayat penerimanya, jadi tidak boleh terjadi karena salah klik.
import { Inbox, Trash, User, Bolt } from "../lib/icons";
import TaskTimeline from "./user/TaskTimeline.astro";
import Button from "./ui/Button.astro";
import { findCategory } from "../lib/categories";
import { formatDateTime, formatRange } from "../lib/format";
import type { GivenAssignmentRow } from "../lib/db";

interface Props {
  rows: GivenAssignmentRow[];
  /**
   * URL halaman ini, dipakai form "Lepas" (POST ke dirinya sendiri) dan filter.
   * Passed in because the two host pages live at different paths.
   */
  action: string;
  /** Nilai `?belum=1` aktif — filter "belum selesai". */
  onlyUnfinished: boolean;
  /** Judul kartu; dibedakan supaya admin tidak mengira sedang melihat penugasannya sendiri. */
  title: string;
  hint: string;
}

const { rows, action, onlyUnfinished, title, hint } = Astro.props;

const directCategory = findCategory("penugasan-langsung");
const UnitIcon = directCategory?.icon ?? Bolt;

/** Maksimum node agar strip tetap muat di kolom sempit. */
const MAX_NODES = 12;

const summary = {
  total: rows.length,
  done: rows.filter((row) => row.status === "selesai").length,
  running: rows.filter((row) => row.status === "berjalan").length,
  late: rows.filter((row) => row.status === "terlambat").length,
};

const filterHref = (unfinished: boolean) => (unfinished ? `${action}?belum=1` : action);
---

<section class="rounded-xl border border-slate-200 bg-white" data-reveal="up">
  <header class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-200 px-5 py-4">
    <div class="min-w-0">
      <h2 class="text-sm font-semibold text-slate-900">{title}</h2>
      <p class="mt-0.5 text-xs text-slate-500">{hint}</p>
    </div>
    <!-- Filter lewat URL: tetap jalan tanpa JavaScript, dan bisa di-bookmark. -->
    <div class="flex shrink-0 rounded-lg border border-slate-200 bg-slate-50 p-0.5">
      <a
        href={filterHref(false)}
        aria-current={onlyUnfinished ? undefined : "true"}
        class:list={[
          "rounded-md px-2.5 py-1 text-xs font-medium transition-colors",
          onlyUnfinished ? "text-slate-500 hover:text-slate-900" : "bg-white text-brand-700 shadow-sm",
        ]}
      >
        Semua
      </a>
      <a
        href={filterHref(true)}
        aria-current={onlyUnfinished ? "true" : undefined}
        class:list={[
          "rounded-md px-2.5 py-1 text-xs font-medium transition-colors",
          onlyUnfinished ? "bg-white text-brand-700 shadow-sm" : "text-slate-500 hover:text-slate-900",
        ]}
      >
        Belum selesai
      </a>
    </div>
  </header>

  {
    rows.length > 0 && (
      <div class="grid grid-cols-2 gap-px border-b border-slate-200 bg-slate-200 sm:grid-cols-4">
        {[
          { label: "Penugasan", value: summary.total },
          { label: "Selesai", value: summary.done },
          { label: "Berjalan", value: summary.running },
          { label: "Terlambat", value: summary.late },
        ].map((item) => (
          <div class="bg-white px-4 py-3">
            <p class="text-lg font-semibold text-slate-900 tabular-nums">{item.value}</p>
            <p class="text-xs text-slate-500">{item.label}</p>
          </div>
        ))}
      </div>
    )
  }

  {
    rows.length === 0 ? (
      <div class="flex flex-col items-center gap-2 px-6 py-14 text-center">
        <Inbox class="size-8 text-slate-300" />
        <p class="text-sm font-medium text-slate-900">
          {onlyUnfinished ? "Semua sudah selesai" : "Belum ada instruksi"}
        </p>
        <p class="max-w-sm text-sm text-slate-500">
          {onlyUnfinished
            ? "Tidak ada penugasan yang menunggu atau terlewat."
            : "Gunakan tombol di atas untuk membuat pekerjaan dan menunjuk pengerjanya."}
        </p>
      </div>
    ) : (
      <>
        {/* Legenda sekali di atas daftar, bukan diulang di setiap kartu. */}
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-slate-100 px-5 py-2.5 text-[11px] text-slate-500">
          {[
            { state: "selesai", text: "Selesai" },
            { state: "berjalan", text: "Berjalan" },
            { state: "terlewat", text: "Terlewat" },
          ].map((item) => (
            <span class="inline-flex items-center gap-1.5">
              <span data-legend-state={item.state} class="size-2.5 rounded-full"></span>
              {item.text}
            </span>
          ))}
          <span class="ml-auto inline-flex items-center gap-1.5 text-slate-400">
            <Bolt class="size-3" />
            Diurutkan dari yang paling perlu perhatian
          </span>
        </div>

        <ul class="divide-y divide-slate-100">
          {rows.map((row) => {
            const shown = row.periods.slice(-MAX_NODES);
            return (
              <li class="px-5 py-4" data-reveal="fade">
                <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
                  <div class="flex min-w-0 flex-1 items-start gap-3">
                    <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600">
                      <UnitIcon class="size-4" />
                    </span>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-slate-900">{row.name}</p>

                      {/* Penerima: nama, jabatan, email — yang dicari saat mengoreksi.
                          Tanpa pemisah titik: saat barisnya membungkus, titik itu
                          menggantung di awal baris. Bedanya sudah jelas dari warna. */}
                      <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-slate-500">
                        <span class="inline-flex min-w-0 max-w-full items-center gap-1">
                          <User class="size-3.5 shrink-0" />
                          <span class="truncate font-medium text-slate-600">{row.user_name}</span>
                        </span>
                        {row.jabatan && <span class="min-w-0 truncate">{row.jabatan}</span>}
                        <span class="min-w-0 truncate text-slate-400" title={row.user_email}>
                          {row.user_email}
                        </span>
                      </p>

                      <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-slate-400">
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">{row.periode}</span>
                        <span>{formatRange(row.start_date, row.end_date)}</span>
                        <span>diberikan {formatDateTime(row.created_at)}</span>
                      </p>
                    </div>
                  </div>

                  <span
                    data-row-status={row.status}
                    class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium"
                  >
                    {
                      row.status === "selesai"
                        ? "Selesai"
                        : row.status === "terlambat"
                          ? "Terlambat"
                          : row.status === "belum"
                            ? "Belum mulai"
                            : "Berjalan"
                    }
                  </span>
                </div>

                <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-4 sm:pl-12">
                  <TaskTimeline periods={shown} periode={row.periode} hiddenCount={row.periods.length - shown.length} />
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <p class="text-xs text-slate-500 tabular-nums">
                      {row.done} dari {row.periods.length} periode selesai
                      {row.missed > 0 && <span class="text-red-600"> · {row.missed} terlewat</span>}
                    </p>
                    <form method="POST" action={action} data-release-form data-release-name={row.name} data-release-user={row.user_name}>
                      <input type="hidden" name="action" value="remove" />
                      <input type="hidden" name="id" value={row.id} />
                      <button
                        type="submit"
                        data-release-open
                        class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-xs font-medium text-red-600 transition-colors hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600"
                        title={`Lepas penugasan dari ${row.user_name}`}
                      >
                        <Trash class="size-3.5" />
                        Lepas
                      </button>
                    </form>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </>
    )
  }
</section>

<dialog id="release-dialog" class="app-dialog w-[calc(100vw-2rem)] max-w-md" aria-labelledby="release-title">
  <form method="POST" action={action} data-release-confirm>
    <input type="hidden" name="action" value="remove" />
    <input type="hidden" name="id" value="" />
    <div class="p-5 sm:p-6">
      <div class="flex items-start gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-red-50 text-red-600">
          <Trash class="size-5" />
        </span>
        <div class="min-w-0">
          <h2 id="release-title" class="text-base font-semibold text-slate-900">Lepas penugasan?</h2>
          <p class="mt-1 text-sm text-slate-600">
            <span data-release-target class="font-medium text-slate-900"></span>{" "}
            akan dilepas dari <span data-release-person class="font-medium text-slate-900"></span>. Riwayat
            penyelesaiannya ikut terhapus dan tidak bisa dikembalikan.
          </p>
        </div>
      </div>

      <p data-release-error hidden class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>
    </div>

    <div class="flex flex-col-reverse gap-2 border-t border-slate-200 p-5 sm:flex-row sm:justify-end sm:px-6">
      <Button variant="outline" type="button" data-release-cancel>Batal</Button>
      <Button variant="dangerSolid" type="submit" data-release-submit>
        <Trash class="size-4" />Lepas
      </Button>
    </div>
  </form>
</dialog>

<script>
  import { actions } from "astro:actions";
  import { refreshPage, toast } from "../scripts/dashboard.ts";

  const init = () => {
    const dialog = document.getElementById("release-dialog") as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.releaseWired) return;
    dialog.dataset.releaseWired = "1";

    const confirmForm = dialog.querySelector<HTMLFormElement>("[data-release-confirm]");
    const idField = confirmForm?.querySelector<HTMLInputElement>('input[name="id"]');
    const targetLabel = dialog.querySelector<HTMLElement>("[data-release-target]");
    const personLabel = dialog.querySelector<HTMLElement>("[data-release-person]");
    const errorBox = dialog.querySelector<HTMLElement>("[data-release-error]");
    const submit = dialog.querySelector<HTMLButtonElement>("[data-release-submit]");
    let sourceForm: HTMLFormElement | null = null;

    // Tanpa JavaScript form "Lepas" tetap POST biasa; dengan JavaScript submit-nya
    // ditahan dan dialihkan ke dialog ini.
    document.querySelectorAll<HTMLFormElement>("[data-release-form]").forEach((form) => {
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        sourceForm = form;
        if (idField) idField.value = String(new FormData(form).get("id") ?? "");
        if (targetLabel) targetLabel.textContent = form.dataset.releaseName ?? "Penugasan ini";
        if (personLabel) personLabel.textContent = form.dataset.releaseUser ?? "penerimanya";
        if (errorBox) errorBox.hidden = true;
        dialog.showModal();
      });
    });

    dialog.querySelector("[data-release-cancel]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    confirmForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const id = Number(idField?.value ?? 0);
      if (!id) return;

      if (submit) submit.disabled = true;
      if (errorBox) errorBox.hidden = true;
      const { error } = await actions.removeDirectAssignment({ id });
      if (submit) submit.disabled = false;

      if (error) {
        // Tanpa JavaScript form ini POST biasa; dengan JavaScript pesannya di dalam
        // dialog supaya tidak berpindah halaman.
        if (errorBox) {
          errorBox.textContent = error.message ?? "Penugasan gagal dilepas.";
          errorBox.hidden = false;
        }
        return;
      }

      dialog.close();
      sourceForm?.reset();
      await refreshPage();
      toast("Instruksi dilepas.");
    });
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  [data-legend-state="selesai"] {
    background-color: var(--color-brand-600);
  }
  [data-legend-state="berjalan"] {
    border: 1.5px solid var(--color-slate-300);
    background-color: var(--color-white);
  }
  [data-legend-state="terlewat"] {
    background-color: var(--color-red-600);
  }
  [data-row-status="selesai"] {
    background-color: var(--color-emerald-50);
    color: var(--color-emerald-700);
  }
  [data-row-status="berjalan"] {
    background-color: var(--color-brand-50);
    color: var(--color-brand-700);
  }
  [data-row-status="terlambat"] {
    background-color: var(--color-red-50);
    color: var(--color-red-700);
  }
  [data-row-status="belum"] {
    background-color: var(--color-slate-100);
    color: var(--color-slate-600);
  }
</style>
