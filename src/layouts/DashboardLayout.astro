---
// Shell for both dashboard areas (admin and level 1/2). At lg+ the menu is docked in a
// sidebar beside the content; below lg the same list slides in from the header trigger
// (SidebarMenu), so there is one source for the nav either way. Only the list and the
// brand link differ per role.
import { Bell, LayoutDashboard, LogOut, Newspaper, Tags, ClipboardCheck, RotateCcwClock, UserRound, Users } from "@lucide/astro";
import SidebarMenu from "../components/admin/SidebarMenu.astro";
import SidebarNav from "../components/admin/SidebarNav.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import { countUnseenAssignments } from "../lib/db";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  user?: { id?: string | number; name?: string | null; email?: string | null; role?: number };
}

const { title, user } = Astro.props;

const isAdmin = user?.role === 0;

// Lonceng dihitung di sini, bukan lewat prop: layout ini dipakai sepuluh halaman, dan
// satu halaman baru yang lupa mengisi prop akan diam-diam menghilangkan notifikasinya.
const userId = Number(user?.id);
const unseen = !isAdmin && Number.isInteger(userId) ? countUnseenAssignments(userId) : 0;
const unseenLabel = `Pekerjaan masuk: ${unseen} belum dibaca`;

const nav = isAdmin
  ? [
      { href: "/dashboard", label: "Dashboard", icon: LayoutDashboard },
      { href: "/dashboard/assignments", label: "Penugasan", icon: ClipboardCheck },
      { href: "/dashboard/posts", label: "Postingan", icon: Newspaper },
      { href: "/dashboard/categories", label: "Kategori", icon: Tags },
      { href: "/dashboard/users", label: "Pengguna", icon: Users },
      { href: "/profile", label: "Profil", icon: UserRound },
    ]
  : [
      { href: "/user", label: "Dashboard", icon: LayoutDashboard },
      // Hanya atasan (level 1) yang boleh memberi penugasan langsung.
      ...(user?.role === 1 ? [{ href: "/user/penugasan", label: "Penugasan", icon: ClipboardCheck }] : []),
      { href: "/user/riwayat", label: "Riwayat", icon: RotateCcwClock },
      { href: "/profile", label: "Profil", icon: UserRound },
    ];

const home = isAdmin ? "/dashboard" : "/user";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === home ? path === href : path.startsWith(href));
const items = nav.map((item) => ({ ...item, active: isActive(item.href) }));
---

<Layout title={title}>
  <div class="min-h-dvh bg-slate-50">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3.5 sm:gap-6 sm:px-6 lg:max-w-7xl">
        <SidebarMenu items={items} user={user} />

        <a href={home} class="text-base font-semibold tracking-tight text-slate-900">
          Assignment<span class="text-brand-600">+</span>
        </a>

        <div class="ml-auto flex items-center gap-2 sm:gap-3">
          <ThemeToggle />
          {
            unseen > 0 && (
              <a
                href="/user#pekerjaan-masuk"
                data-bell
                aria-label={unseenLabel}
                title={unseenLabel}
                class="relative grid size-9 place-items-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
              >
                <Bell class="size-4" />
                <span
                  data-bell-count
                  aria-hidden="true"
                  class="absolute -top-0.5 -right-0.5 grid min-w-4 place-items-center rounded-full bg-red-600 px-1 text-[10px] font-semibold leading-4 text-white"
                >
                  {unseen > 99 ? "99+" : unseen}
                </span>
              </a>
            )
          }
          <span class="hidden text-sm text-slate-500 sm:inline">{user?.name}</span>
          <a
            href="/api/auth/signout"
            data-signout
            class="hidden items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-medium text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 lg:inline-flex"
          >
            <LogOut class="size-4" />
            Keluar
          </a>
        </div>
      </div>

      <!-- Progress baca: menempel di tepi header, mengikuti posisi scroll. -->
      <div
        data-scroll-progress
        aria-hidden="true"
        class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-brand-600/50"
      >
      </div>
    </header>

    <div class="mx-auto flex max-w-6xl items-start gap-6 px-4 py-8 sm:px-6 lg:max-w-7xl">
      <aside class="sticky top-20 hidden w-60 shrink-0 lg:block">
        <SidebarNav items={items} class="rounded-xl border border-slate-200 bg-white p-3" />
      </aside>

      <main class="min-w-0 flex-1">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<script>
  // Micro-animations for the whole dashboard: one kit, one timing vocabulary.
  import "../scripts/motion.ts";

  // "Keluar" signs out immediately: the plain link stays as the no-JS fallback, but with
  // JS we post the CSRF-protected signout instead of landing on Auth.js' confirm page.
  import { signOut } from "auth-astro/client";

  // The router swaps the DOM but keeps this module, so the link is wired again on
  // every astro:page-load.
  const init = () => {
    document.querySelectorAll<HTMLAnchorElement>("[data-signout]").forEach((link) => {
      if (link.dataset.signoutWired) return;
      link.dataset.signoutWired = "1";

      link.addEventListener("click", (event) => {
        event.preventDefault();
        void signOut({ callbackUrl: "/login" });
      });
    });
  };

  document.addEventListener("astro:page-load", init);
  init();
</script>
