---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Umsura Assignment</title>
    <!-- The router turns every form POST into an in-page transition, so actions
         no longer reload the whole page. -->
    <ClientRouter />
    <script is:inline>
      // Set the theme before the first paint, otherwise the page flashes the wrong
      // palette. An explicit choice wins; without one the system preference decides.
      (() => {
        // Marks the document as scripted: the CSS that hides the pre-animation
        // state of a reveal only applies when there is JS to bring it back.
        document.documentElement.classList.add("js");

        let stored = null;
        try {
          stored = localStorage.getItem("assignment-theme");
        } catch {
          stored = null; // storage blocked — fall back to the system preference
        }
        const theme =
          stored === "light" || stored === "dark" || stored === "paper"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;

        // The docked menu's rail state, for the same reason: set before first paint
        // so a reload does not flash the full-width menu and then collapse it.
        try {
          if (localStorage.getItem("assignment-dock") === "mini") {
            document.documentElement.dataset.dockMini = "1";
          }
        } catch {
          // storage blocked — start expanded
        }
      })();

      // Safety net: if the motion bundle never arrives, a reveal block must not
      // stay invisible. Whatever already sits in the viewport is shown anyway.
      setTimeout(() => {
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight - 40) el.style.opacity = "1";
        });
      }, 1500);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // The router replaces the <html> attributes as well, so the theme and the "js"
  // marker have to be put back after every navigation — otherwise the page would
  // come back in the default palette.
  import { preferredTheme } from "../scripts/theme.ts";
  import { isDockMini } from "../scripts/dock.ts";

  document.addEventListener("astro:after-swap", () => {
    document.documentElement.classList.add("js");
    document.documentElement.dataset.theme = preferredTheme();
    // The router replaces <html>'s attributes, so the rail state is put back before
    // the new page paints.
    if (isDockMini()) document.documentElement.dataset.dockMini = "1";
    else delete document.documentElement.dataset.dockMini;
  });
</script>
