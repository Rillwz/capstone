---
title: Model Kelas Pendukung — Umsura Assignment
config:
  class:
    hierarchicalNamespaces: false
---
classDiagram
  direction LR

  namespace Pendukung {
    class User {
      <<tabel: users>>
      +int id PK
      +String name
      +String email
      +Role role
      +String jabatan
    }
    class Position {
      <<tabel: positions>>
      +int id PK
      +String label
    }
    class LoginLog {
      <<tabel: login_logs>>
      +int id PK
      +int user_id FK
      +String ip
      +String user_agent
      +String created_at
    }
    class Post {
      <<tabel: posts>>
      +int id PK
      +String title
      +String body
      +int author_id FK
      +int position
    }
    class PasswordResetRequest {
      <<tabel: password_reset_requests>>
      +int id PK
      +int user_id FK
      +StatusPengajuan status
      +int handled_by FK
      +String handled_at
    }
  }

  namespace Kosakata {
    class Role {
      <<enumerasi>>
      Admin = 0
      Level1 = 1
      Level2 = 2
    }
    class StatusPengajuan {
      <<enumerasi>>
      pending
      reset
      rejected
    }
  }

  User "1" --> "*" LoginLog : user_id
  User "1" --> "*" Post : author_id
  User "1" --> "*" PasswordResetRequest : user_id
  User "0..1" --> "*" PasswordResetRequest : handled_by
  User ..> Role

  note for PasswordResetRequest "handled_by ON DELETE SET NULL"
  note for Position "master jabatan, terpisah dari users.jabatan"
