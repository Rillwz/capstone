C4Container
  title Container diagram for Ondine

  Person(author, "Diagram Author", "Developer who writes Mermaid source and ships it with a page or a README.")

  System_Ext(page, "Page or Site", "HTML, CSS", "Ships the compiled SVG and the 210-byte mount runtime. Owned by the author, not by Ondine.")
  System_Ext(markdown, "Markdown Host", "GitHub and similar hosts", "Render README images, but run no scripts and load no page styles.")

  System_Boundary(ondine, "Ondine") {
    Container_Boundary(pkg, "npm package: ondine") {
      Container(core, "Compiler Core", "Rust, WebAssembly", "Parses Mermaid source, builds the diagram model, lays it out, and emits SVG. Deterministic: it reads no file, clock, or environment.")
      Container(cli, "CLI", "Node.js, TypeScript", "Renders Mermaid files or standard input to SVG, previews diagrams as ASCII or a terminal image, and rewrites Markdown fences into image links.")
      Container(vite, "Vite Plugin", "TypeScript, Vite", "Compiles imported .mmd and .mermaid files to SVG during the Vite build.")
      Container(remark, "Remark Plugin", "TypeScript, unified", "Replaces each mermaid fence in Markdown and MDX with inline SVG at build time.")
      Container(nodeapi, "Node Compiler API", "TypeScript, WebAssembly", "render() and create() for build scripts, servers, and static site generators. Loads the speed-optimized module.")
      Container(wasmapi, "Browser Compiler API", "TypeScript, WebAssembly", "create() over caller-supplied modules, for live previews in browsers and edge runtimes.")
      Container(mount, "Mount Runtime", "TypeScript, 210 bytes gzip", "Inserts precompiled SVG into an element and removes it again. Imports nothing from the compiler.")
    }

    Container_Boundary(site, "ondine.sh") {
      Container(worker, "Image Worker", "TypeScript, Cloudflare Worker", "Serves compiled diagrams as SVG and as 1200x630 PNG cards from a URL, for Markdown hosts.")
      Container(docs, "Documentation Site", "TypeScript, TanStack Start", "Holds the documentation, the playground, and the llms.txt files.")
    }
  }

  Rel(author, cli, "Renders files with", "npm exec")
  Rel(author, vite, "Builds pages with", "Vite")
  Rel(author, remark, "Builds docs with", "MDX")
  Rel(author, nodeapi, "Renders in scripts with", "Node.js")
  Rel(author, worker, "Embeds diagram URLs from", "HTTPS")

  Rel(cli, core, "Renders with", "WebAssembly")
  Rel(vite, core, "Compiles with", "WebAssembly")
  Rel(remark, core, "Compiles with", "WebAssembly")
  Rel(nodeapi, core, "Loads", "WebAssembly")
  Rel(wasmapi, core, "Loads", "WebAssembly")

  Rel(core, mount, "Emits SVG for", "inline SVG")
  Rel(page, mount, "Mounts diagrams with", "DOM")

  Rel(docs, worker, "Hosts the image route with", "same Worker")
  Rel(cli, worker, "Links fences to", "HTTPS")
  Rel(markdown, worker, "Fetches diagram images from", "HTTPS")
