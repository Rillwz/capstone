C4Component
  title Component diagram for Ondine - Compiler Core

  Container_Boundary(core, "Compiler Core") {
    Component(preprocess, "Preprocessor", "Rust", "Removes front matter, init directives, and comments, and normalizes line endings and attribute quotes.")
    Component(detect, "Type Detector", "Rust", "Picks the diagram type from the preprocessed source.")
    Component(parsers, "Per-Type Lexer and Parser", "Rust", "33 diagram types, each with its own lexer and parser, build the same model Mermaid builds.")
    Component(model, "Diagram Model", "Rust", "The typed model that layout and rendering read.")
    Component(layout, "Layout Engine", "Rust", "Layered, compound, and lane layouts place nodes, clusters, and edges.")
    Component(measure, "Text Measurement", "Rust", "Measures every character at 0.6 em, so labels fit their shapes.")
    Component(svg, "SVG Builder", "Rust", "Emits the SVG document: root, shapes, edges, clusters, and title.")
    Component(theme, "Theme Writer", "Rust, CSS", "Sets the --ondine-* custom properties that carry the scheme.")
    Component(diagnostics, "Diagnostics", "Rust", "Reports syntax, semantic, limit, and unsupported-diagram errors with line, column, and a caret snippet.")
  }

  Container_Ext(cli, "CLI", "Node.js, TypeScript", "Renders files, standard input, and Markdown fences.")
  Container_Ext(vite, "Vite Plugin", "TypeScript, Vite", "Compiles imported diagram files during the build.")
  Container_Ext(remark, "Remark Plugin", "TypeScript, unified", "Compiles Mermaid fences in Markdown and MDX.")
  Container_Ext(nodeapi, "Node Compiler API", "TypeScript, WebAssembly", "Renders Mermaid source from scripts and servers.")
  Container_Ext(wasmapi, "Browser Compiler API", "TypeScript, WebAssembly", "Renders Mermaid source in a browser or edge runtime.")
  Container_Ext(worker, "Image Worker", "TypeScript, Cloudflare Worker", "Serves compiled diagrams as SVG and PNG cards.")

  Rel(cli, core, "Renders with")
  Rel(vite, core, "Compiles with")
  Rel(remark, core, "Compiles with")
  Rel(nodeapi, core, "Renders with")
  Rel(wasmapi, core, "Renders with")
  Rel(worker, core, "Renders with")

  Rel(preprocess, detect, "Passes the source to")
  Rel(detect, parsers, "Selects the parser with")
  Rel(parsers, model, "Builds")
  Rel(model, layout, "Positions with")
  Rel(layout, svg, "Draws with")
  Rel(measure, layout, "Sizes shapes with")
  Rel(measure, svg, "Sizes labels with")
  Rel(theme, svg, "Styles")
  Rel(preprocess, diagnostics, "Reports to")
  Rel(parsers, diagnostics, "Reports to")

  UpdateRelStyle(measure, layout, $offsetY="-50")
  UpdateRelStyle(measure, svg, $offsetY="50")
  UpdateRelStyle(model, layout, $offsetY="-40")
  UpdateRelStyle(layout, svg, $offsetY="-20")
  UpdateRelStyle(preprocess, diagnostics, $offsetX="-60")
  UpdateRelStyle(parsers, diagnostics, $offsetX="-80", $offsetY="-20")
