C4Context
  title System Context diagram for Ondine

  Person(author, "Diagram Author", "Developer who writes Mermaid source: .mmd files, Markdown fences, or diagram URLs.")

  System(ondine, "Ondine", "Compiles Mermaid source to SVG ahead of time, so pages ship the SVG and a 210-byte runtime. Written in Rust, and targets the syntax of Mermaid 12.1.0.")

  System_Ext(mermaid, "Mermaid", "Defines the diagram syntax and the diagram model. Ondine follows that syntax, but does not run Mermaid.")
  System_Ext(markdown, "Markdown Host", "GitHub and similar hosts that render README images, but run no scripts and load no page styles.")
  System_Ext(cloudflare, "Cloudflare", "Runs the image Worker that serves diagram images.")
  System_Ext(npm, "npm Registry", "Publishes the ondine packages and their WebAssembly modules.")

  Rel(author, ondine, "Writes Mermaid source for", "npm, .mmd files, Markdown")
  Rel(ondine, npm, "Publishes packages to", "npm")
  Rel(ondine, cloudflare, "Runs the image Worker on", "Cloudflare Workers")
  Rel(ondine, markdown, "Serves diagram images to", "HTTPS")
  Rel(ondine, mermaid, "Implements the syntax of")

  UpdateRelStyle(ondine, mermaid, $offsetY="-70")
  UpdateRelStyle(ondine, markdown, $offsetX="-50")
  UpdateRelStyle(ondine, cloudflare, $offsetX="70")
